//  Test graph: the production graph plus an audio input that can replace the voices,
//  so the effects can be compared with recordings from the original plugin.

graph PorridgeTest  [[ main ]]
{
    input params.*;

    input event std::midi::Message midiIn;
    input event std::timeline::Tempo tempoIn;
    input event porridge::Shape shapeIn;
    input event porridge::Curve curveIn;
    input event porridge::Tuning tuningIn;
    input event porridge::ImpulseChunk impulseIn;
    input event int panic;
    input event int testMode;
    input stream float<2> testIn;
    input event int voiceView;

    output stream float<2> out;
    output event porridge::VoiceView voiceViewOut;

    node params = ParamStore;
    node synth  = porridge::Synth;

    connection
    {
        params.paramOut -> synth.paramIn;
        midiIn          -> synth.midiIn;
        tempoIn         -> synth.tempoIn;
        shapeIn         -> synth.shapeIn;
        curveIn         -> synth.curveIn;
        tuningIn        -> synth.tuningIn;
        impulseIn       -> synth.impulseIn;
        panic           -> synth.panicIn;
        testMode        -> synth.testModeIn;
        testIn          -> synth.testIn;
        voiceView       -> synth.voiceViewIn;
        synth.out       -> out;
        synth.voiceViewOut -> voiceViewOut;
    }
}
