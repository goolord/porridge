{
    "CmajorVersion":    1,
    "ID":               "dev.porridge.oatmeal",
    "version":          "1.0",
    "name":             "Porridge",
    "description":      "A Cmajor re-implementation of Fuzzpilz's Oatmeal (2008) that loads Oatmeal programs and banks",
    "category":         "generator",
