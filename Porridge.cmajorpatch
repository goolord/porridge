    },

    "source":           [ "dsp/Porridge.cmajor", "dsp/Types.cmajor", "dsp/Slots.cmajor", "dsp/ParamStore.cmajor", "dsp/Effects.cmajor", "dsp/Filter.cmajor", "dsp/Tables.cmajor", "dsp/Modulation.cmajor", "dsp/Oscillator.cmajor", "dsp/Voice.cmajor", "dsp/Synth.cmajor" ],
