  {
   "name": "Grit Bloom",
   "author": "Porridge",
   "category": "pad",
   "tags": [
    "per-voice drive",
    "per-voice pan",
    "evolving"
   ],
   "description": "A clean pad that grows grit: a slow mod envelope raises each note's distortion drive and cutoff, and moves the note out from the centre, each one to its own random side. Macros: grit, bloom.",
   "params": {
    "O1_Waveform": 6,
    "O1_Amp": 1,
    "O1_Afterpitch": 0,
