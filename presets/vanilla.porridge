  {
   "name": "AM Bells",
   "author": "Porridge",
   "category": "bells",
   "tags": [
    "amplitude modulation",
    "wavefolder",
    "per-voice drive"
   ],
   "description": "Amplitude modulation at a ratio of 3.5 gives inharmonic bell partials. A sine folder on each voice is driven by velocity, so hard hits ring metallic while soft ones stay pure. Bells scatter around the stereo field. Macros: metal.",
