   "tuning": {
    "scl": "! just-12.scl\n5-limit just intonation, 12 notes\n 12\n 16/15\n 9/8\n 6/5\n 5/4\n 4/3\n 45/32\n 3/2\n 8/5\n 5/3\n 9/5\n 15/8\n 2/1\n",
