  {
   "name": "Tape Memory",
   "author": "Porridge",
   "category": "keys",
   "tags": [
    "lo-fi",
    "drift",
    "effects order"
   ],
   "description": "A worn tape keyboard: heavy drift, a slow random wow on pitch, a soft drive on each voice and echoes that run into the chorus (the delay comes first in the effects order). Each note carries its own tape hiss and a fast random flutter that roughens the pitch like noise modulating it, and rings on for seconds after the key is let go. Macros: wear, echo.",
   "params": {
    "O1_Waveform": 8,
    "O1_Amp": 1,
    "O1_Afterpitch": 0,
    "O1_PWM_W": 0.5,
    "O1_PWM_R": 0,
    "O1_PWM_D": 0,
    "O2_Waveform": 0,
    "O2_Amp": 0.4,
    "O2_Afterpitch": 0,
    "O2_PWM_W": 0.5,
    "O2_PWM_R": 0,
    "O2_PWM_D": 0,
    "Transpose": 1,
    "Detune": 0,
    "OscAftertouch": 0,
    "N_Amp": 0.14,
    "N_Aftertouch": 0,
