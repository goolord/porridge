  {
   "name": "Glass Spiral",
   "author": "Porridge",
   "category": "texture",
   "tags": [
    "frequency shifter",
    "bode",
    "feedback",
    "ambient"
   ],
   "description": "Glassy tones fed into the Bode frequency shifter's feedback delay: every echo comes back shifted a little higher than the last, so each note spirals up into a shimmering cloud while the dry note stays where it is. Notes land at random places in the stereo field. Macros: shift, spiral, mix.",
