  {
   "name": "Acid Oats",
   "author": "Porridge",
   "category": "bass",
   "tags": [
    "acid",
    "diode ladder",
    "per-voice drive"
   ],
   "description": "A 303-style line: diode ladder near self-oscillation, a snappy filter envelope and glide, into an asymmetric drive. Velocity works as accent, opening the envelope and adding grit. Macros: cutoff, resonance, env mod, drive.",
