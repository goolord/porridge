    "LFO_1_Quantize": 0,
    "LFO_1_Sync": 0,
    "LFO_1_Cutoff_1": 0,
    "LFO_1_Cutoff_2": 0,
    "LFO_1_Resonance": 0,
    "LFO_1_Pitch": 0,
    "LFO_1_Pan": 0,
    "LFO_1_2": 0,
    "LFO_2_Unit": 1,
