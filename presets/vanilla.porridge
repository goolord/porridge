  {
   "name": "Comb String",
   "author": "Porridge",
   "category": "pad",
   "tags": [
    "comb",
    "karplus",
    "bowed",
    "vibrato"
   ],
   "description": "Noise bowing a comb filter tuned to each note, with a little saw for body: a bowed string that changes character with the comb's feedback polarity (macro 2). The bow noise is tuned to the note and its pressure wavers on its own in every note; a vibrato on the comb's tuning fades in, and a high shelf keeps the hiss off the top. Mod wheel: more vibrato; aftertouch: bow harder. Macros: resonance, polarity, air.",
   "params": {
    "O1_Waveform": 6,
    "O1_Amp": 0.12,
    "O1_Afterpitch": 0,
    "O1_PWM_W": 0.5,
    "O1_PWM_R": 0,
    "O1_PWM_D": 0,
    "O2_Waveform": 0,
    "O2_Amp": 0,
    "O2_Afterpitch": 0,
    "O2_PWM_W": 0.5,
    "O2_PWM_R": 0,
    "O2_PWM_D": 0,
    "Transpose": 1,
    "Detune": 0,
    "OscAftertouch": 0,
    "N_Amp": 0.5,
    "N_Aftertouch": 0,
    "N_Resonance": 0.3,
    "N_Transpose": 0,
    "LFO_1_Unit": 1,
