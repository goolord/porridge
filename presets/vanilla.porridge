  {
   "name": "Felt Piano",
   "author": "Porridge",
   "category": "keys",
   "tags": [
    "piano",
    "analog filter",
    "convolution",
    "compressor"
   ],
   "description": "A soft, close felt piano: triangle and sine through an MG lowpass whose envelope follows velocity, with a short felt thump of pitched noise on each hammer. A gentle compressor evens the touch and a small convolved room sits behind it. Macros: hammer, tone, room.",
