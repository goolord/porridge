//  The synth engine: MIDI, controller smoothing, note handling and arpeggiator, the voice
//  manager, the per-voice renderer and the global effects, in 64-sample control blocks as in
//  Oatmeal. Behaviour notes refer to docs/internals/.
//
//  MIDI timing: Oatmeal applies MIDI at the start of the next block, up to 64 samples late.
//  Porridge applies each message on its own sample instead, one block later (a constant
//  latency of 64 samples, which the plugin reports to the host): the voices render a block in
//  pieces split at the messages and at arpeggiator steps. Oat mode keeps Oatmeal's timing,
//  with the output delayed by a block so that the latency is the same.

namespace porridge
{
    processor Synth
    {
        input event ParamChange paramIn;
        input event std::midi::Message midiIn;
        input event std::timeline::Tempo tempoIn;
        input event Shape shapeIn;
        input event Curve curveIn;
        input event Tuning tuningIn;
        input event ImpulseChunk impulseIn;
        input event int impulseViewIn;
        input event int panicIn;
        input event int levelRequestIn;

        // test-only: lets the offline test graph replace the voices with a recorded signal
        input stream float<2> testIn;
        input event int testModeIn;

        output stream float<2> out;
        output event float<2> xyOut;
        output event int ccOut;
        output event CompMeter compMeterOut;
        output event ImpulseView impulseViewOut;
        output event float levelOut;

        // MIDI is applied a block late (see the top of this file)
        processor.latency = blockSize;

        //==============================================================================
        float[numSlots] P;                          // program mirror, slot = chunk offset / 4
        bool paramsChanged = true;                  // since the envelope coefficients were made
        float[512] wave1, wave2;
        float[512][2] lfoShape;
        float[64] velCurve, touchCurve;
        bool tuningOn;
        float[128] keySemitones;
        bool user1Dirty, user2Dirty;

        float64 sampleRate, samplesPerBeat;
        float bpm = 120.0f;
        int srInt;

        // coefficients that depend only on the sample rate (and the controller smoothing's on
        // the length of the block)
        float ampSmooth;
        FmCoefs fmCoefs;
        float[blockSize + 1] ctrlSmooth;

        Rand rng;
        WaveTables tables;
        FxTables fxTables;
        DistTables distTables;

        Distortion globalDist;
        Chorus chorus;
        Delay delay;
        Reverb reverb;
        EQ eq;

        // the rack's copies of the effects (ui/PorridgeParams.res); each chorus copy draws from
        // its own random numbers, so that adding one changes nothing else
        Chorus[rack::chorusCount] choruses;
        Rand[rack::chorusCount] chorusRngs;
        RackDelay[rack::delayCount] delays;
        Reverb[rack::reverbCount] reverbs;
        EQ[rack::eqCount] eqs;
        Distortion[rack::distortionCount] distortions;

        // Porridge's own effects (ui/PorridgeParams.res newKinds): each kind's first, then its copies
        Flanger[rack::flangerCount] flangers;
        Phaser[rack::phaserCount] phasers;
        Compressor[rack::compressorCount] compressors;
        Space[rack::spaceCount] spaces;
        Convolver[rack::convolveCount] convolvers;
        Bode[rack::bodeCount] bodes;
        FilterFx[rack::filterCount] filterFxs;
        Utility[rack::utilityCount] utilities;
        Ambience[rack::ambienceCount] ambiences;
        Air[rack::airCount] airs;
        float noteHz;                               // the newest note's frequency (phaser tracking)
        int meterCount;                             // blocks until the compressors' meters go out
        int blockCount;                             // blocks rendered
        int[rack::convolveCount] convolverRan;      // the block each convolver last ran in
        int[rack::convolveCount] viewSent;          // the impulse each convolver last showed the view

        // the level meter the view asks for (levelRequestIn): readings still to send, and the
        // K-weighted power summed since the last one; the weighting's shelf and highpass, per
        // channel
        int levelReadings, levelFrames;
        float64 levelSum;
        KWeighting[2] kWeighting;

        // every distortion's custom shape (Oatmeal's first), rendered when its points change
        float[1026][1 + rack::distortionCount] shaperTables;
        float[shaperValues][1 + rack::distortionCount] shaperDrawn;
        bool[1 + rack::distortionCount] shaperValid;

        //==============================================================================
        // voices: a pool with an explicit list, newest first
        Voice[maxVoices] voices;
        int[maxVoices] order;
        int numActive;

        bool[256] keyReleased;
        float[128] perKeyAT;
        Env phantom1, phantom2;
        float phantom1Val, phantom2Val;
        LFO gLfo1, gLfo2;
        float gLfo2Prev, gLfo1Slew, gLfo2Slew;

        // per-block values computed by the voice manager for all voices
        EnvCoefs ampC, filtC, filt2C, mod1C, mod2C;
        EnvCoefs[2] oscEnvC;
        PitchEnvCoefs penvC;
        float lnOct, octave;
        float[2] gv, gLfoPitch, gLfoPan, gLfoRaw;      // the global LFOs, by LFO
        float globalPitch, globalPan;
        int64 pwMod1, pwMod2;
        float pwmRateMod1, pwmDepthMod1, pwmRateMod2, pwmDepthMod2;

        // controllers
        float bendTarget, bendSmooth, pressureTarget, pressureSmooth, xSmooth, ySmooth;
        float[128] rawCC;
        bool[128] ccReported;                       // this block, on ccOut
        float[6] ccSmooth;
        float morphKnob, morphGlide;                // the filter morph knob, and where it has glided to
        float[ccTgt::unisonSpread + 1] ccSum, ccSumBipolar;    // sumCcMods: per piece
        float ccXyDepth, ccMe1Depth, ccMe2Depth, ccRes;
        bool sustainDown;
        float[4] walkX, walkY;
        float walkT;
        float curX, curY;

        // note object / arpeggiator
        int[128] heldKey, heldVel, heldStamp, heldSub;
        int heldCount, stampCounter;
        int prevCmd, dir, prevDir, stepIdx, curKey, arpPos, arpPrevPos, gSub, gSubPrev;
        bool firstNote, subFlag;
        float64 arpPhase;

        // modulation matrix (dsp/ModTables.cmajor): the connections that are on this block,
        // the targets they reach, and the values those targets had before modulation
        int[mods::numSlots] liveSrc, liveTgt, liveVia;
        float[mods::numSlots] liveAmt;
        int numLive;
        int[mods::numTargets] liveTargets;
        int numLiveTargets;
        bool[mods::numTargets] targetLive;
        float[mods::numTargets] modBase, modBaseNorm, modSum;
        float bendNormTarget, bendNorm, wheel;
        Lcg modRng;

        // the modulation matrix's noise source: whether a connection uses it, its own random
        // numbers, and its value for the global targets
        bool noiseLive;
        Lcg noiseRng;
        float noiseGlobal;

        // Porridge's own randomness (drift, unison phases), apart from Oatmeal's rng
        Lcg driftRng;

        // each live connection's slot, hold, slew (in seconds), curve; the shared slew state, by
        // slot, and the connection it is for (source and target: a new one starts over)
        int[mods::numSlots] liveSlot;
        bool[mods::numSlots] liveHold;
        float[mods::numSlots] liveSlew, liveCurve;
        float[mods::numSlots] sharedSlew;
        int[mods::numSlots] sharedSlewFor;

        // the later sources: whether a connection uses them (LFO 3, voice level, wander), LFO 3
        // shared and its value, its own random numbers (and wander's), the notes so far and the
        // last one's frequency, and the held notes' value
        bool lfo3Live, levelLive, wanderLive;
        Lfo3 gLfo3;
        float gLfo3Raw;
        Lcg extraRng;
        int noteCount;
        float lastNoteHz;
        float heldNotes;

        // MPE: each member channel's note bend (semitones), pressure and slide (CC 74), and
        // the channel each key last came from
        float[16] chBendTarget, chBend, chPressureTarget, chPressure, chSlideTarget, chSlide;
        int[128] noteChan;

        // MIDI arriving during a block, and the sample it arrived on (now: the current frame)
        std::midi::Message[256] midiQueue;
        int64[256] midiTime;
        int midiHead, midiCount;                    // the messages not handled yet: [midiHead, midiCount)
        int64 now;
        bool panicPending;

        // Oat mode: the output a block late, for the same latency as sample-accurate MIDI
        float<2>[blockSize] lateMix;
        int xyReportSamples;
        float xyReportedX, xyReportedY;

        // block buffers
        float<2>[blockSize] mix, testBuf, testNext;
        bool useTestInput;
        float[blockSize] bufM, bufR, bufE, bufNZ, bufX, bufMix, bufMod;
        float[blockSize][maxUnison] bufV;   // stereo unison: each copy apart
        int[blockSize] syncBuf;
        float[65] fmBuf;

        //==============================================================================
        event paramIn (ParamChange c)
        {
            P.at (c.slot) = c.value;
            paramsChanged = true;
        }

        event shapeIn (Shape s)
        {
            // a user waveform's tables are rebuilt (on the audio thread) only when it changes
            if (s.which == 0)      { if (! sameShape (wave1, s.data)) { wave1 = s.data; user1Dirty = true; } }
            else if (s.which == 1) { if (! sameShape (wave2, s.data)) { wave2 = s.data; user2Dirty = true; } }
            else if (s.which == 2 || s.which == 3) lfoShape.at (s.which - 2) = s.data;
        }

        bool sameShape (const float[512]& a, const float[512]& b)
        {
            for (wrap<512> i)
                if (a[i] != b[i])
                    return false;

            return true;
        }

        event curveIn (Curve c)
        {
            if (c.which == 0) velCurve = c.data;
            else if (c.which == 1) touchCurve = c.data;
        }

        event tuningIn (Tuning t)
        {
            tuningOn = t.on != 0;
            keySemitones = t.semitones;
        }

        event tempoIn (std::timeline::Tempo t)          { if (t.bpm > 0) bpm = t.bpm; }
        event panicIn (int x)                           { panicPending = true; }

        /// The view asks for n readings of the output's level (each 512 frames' K-weighted mean
        /// power before the output gain, both channels; 0 stops them).
        event levelRequestIn (int n)
        {
            levelReadings = max (0, n);
            levelFrames = 0;
            levelSum = 0;
            kWeighting[0] = makeKWeighting (sampleRate);
            kWeighting[1] = makeKWeighting (sampleRate);
        }

        /// The view asks for the convolvers' impulses again (a tab opened).
        event impulseViewIn (int x)
        {
            for (wrap<rack::convolveCount> k)
                viewSent[k] = -1;
        }

        event impulseIn (ImpulseChunk c)
        {
            if (c.which >= 0 && c.which < rack::convolveCount)
                convolvers.at (c.which).loadImpulse (c);
        }
        event testModeIn (int x)                        { useTestInput = x != 0; }

        event midiIn (std::midi::Message m)
        {
            if (midiCount < 256)
            {
                midiQueue.at (midiCount) = m;
                midiTime.at (midiCount) = now;
                ++midiCount;
            }
        }

        //==============================================================================
        void init()
        {
            sampleRate = processor.frequency;
            srInt = int (sampleRate + 0.5);
            samplesPerBeat = 21000.0;
            rng.state = 1;

            ampSmooth = ampSmoothing (sampleRate);
            fmCoefs = makeFmCoefs (float64 (srInt));
            let c = pow (10.0, -2.0 / (0.05 * float64 (srInt)));

            for (int n = 0; n <= blockSize; ++n)
                ctrlSmooth.at (n) = float (1.0 - pow (c, float64 (n)));

            fxTables.build (sampleRate);
            distTables.build();
            tables.buildStatic();

            // defaults until the patch sends its shapes: sine waves, sine LFO shapes, linear curves
            for (int i = 0; i < 512; ++i)
            {
                let s = float (sin (twoPi * float64 (i) / 512.0));
                wave1.at (i) = s;
                wave2.at (i) = s;
                lfoShape[0].at (i) = 0.5f + 0.5f * s;
                lfoShape[1].at (i) = 0.5f + 0.5f * s;
            }

            for (int i = 0; i < 64; ++i)
            {
                velCurve.at (i) = float (i) / 63.0f;
                touchCurve.at (i) = float (i) / 63.0f;
            }

            user1Dirty = true;
            user2Dirty = true;

            globalDist.clearState();
            delay.prepare();
            reverb.prepare();
            eq.clearState();

            // the chorus is set up while the program mirror is still all zero, so its
            // irregular mode starts from zero delays and speeds (the reference renders rely on
            // it); then every parameter gets its default
            chorus.clearState (rng, P, sampleRate);
            P = slotDefaults;

            for (wrap<rack::chorusCount> k)
                chorusRngs[k].state = 2 + int (k);

            for (wrap<rack::delayCount> k)   delays[k].prepare();
            for (wrap<rack::reverbCount> k)  reverbs[k].prepare();
            for (wrap<rack::convolveCount> k)  convolvers[k].prepare();
            clearCopies();

            for (wrap<maxVoices> i)
                constructVoice (voices[i]);

            numActive = 0;
            allNotesOff();
            walkT = 0;
            modRng.state = 12345;
            noiseRng.state = 24680;
            driftRng.state = 54321;
            gLfo1Slew = -1.0f;
            gLfo2Slew = -1.0f;
        }

        void resetEffects()
        {
            globalDist.clearState();
            chorus.clearState (rng, P, sampleRate);
            delay.clearState();
            reverb.clearState();
            eq.clearState();

            for (wrap<rack::delayCount> k)   delays[k].clearState();
            for (wrap<rack::reverbCount> k)  reverbs[k].clearState();
            clearCopies();
        }

        void clearCopies()
        {
            for (wrap<rack::chorusCount> k)
            {
                swapKind (rack::chorusKind, k);
                choruses[k].clearState (chorusRngs[k], P, sampleRate);
                swapKind (rack::chorusKind, k);
            }

            for (wrap<rack::eqCount> k)          eqs[k].clearState();
            for (wrap<rack::distortionCount> k)  distortions[k].clearState();

            for (wrap<rack::flangerCount> k)     flangers[k].clearState();
            for (wrap<rack::phaserCount> k)      phasers[k].clearState();
            for (wrap<rack::compressorCount> k)  compressors[k].clearState();
            for (wrap<rack::spaceCount> k)       spaces[k].clearState();
            for (wrap<rack::convolveCount> k)    convolvers[k].clearState();
            for (wrap<rack::bodeCount> k)        bodes[k].clearState();
            for (wrap<rack::filterCount> k)      filterFxs[k].clearState();
            for (wrap<rack::utilityCount> k)     utilities[k].clearState();
            for (wrap<rack::ambienceCount> k)    ambiences[k].clearState();
            for (wrap<rack::airCount> k)         airs[k].clearState();
        }

        /// Swaps copy k of a rack kind's parameters with its first's, so that the first's code
        /// runs the copy; swapping again puts both back.
        void swapKind (int kind, int k)
        {
            let first = rack::firstOffset.at (kind);
            let n = rack::firstOffset.at (kind + 1) - first;
            let base = rack::copiesOffset.at (kind) + k * n;

            for (int i = 0; i < n; ++i)
            {
                let a = rack::allFirst.at (first + i);
                let b = rack::allCopies.at (base + i);
                let x = P.at (a);
                P.at (a) = P.at (b);
                P.at (b) = x;
            }
        }

        /// Runs one of Oatmeal's four effects (0 chorus, 1 delay, 2 reverb, 3 EQ).
        bool runFirst (int fx, bool active)
        {
            if (fx == 0) return P[slot::C_Mode] != 0 ? chorus.process (fxTables, rng, mix, active, P, sampleRate) : active;
            if (fx == 1) return P[slot::D_On] != 0 ? delay.process (fxTables, mix, active, P, sampleRate, samplesPerBeat) : active;
            if (fx == 2) return P[slot::R_On] != 0 ? reverb.process (mix, active, P, sampleRate) : active;
            return P[slot::EQ_On] != 0 ? eq.process (mix, active, P, sampleRate) : active;
        }

        /// Renders distortion k's custom shape (0: Oatmeal's, whose points are in P at Sat_Points;
        /// a copy's are swapped there to run it) into shaperTables[k] if its points changed.
        void useShaper (int k)
        {
            if (int (P[slot::Sat_Type]) != 5)
                return;

            var same = shaperValid.at (k);

            for (int i = 0; i < shaperValues && same; ++i)
                same = shaperDrawn.at (k).at (i) == P.at (slot::Sat_Points + i);

            if (! same)
            {
                renderShaper (shaperTables.at (k), P, slot::Sat_Points);

                for (int i = 0; i < shaperValues; ++i)
                    shaperDrawn.at (k).at (i) = P.at (slot::Sat_Points + i);

                shaperValid.at (k) = true;
            }
        }

        /// Runs the copy of an effect that a rack slot's value names, with its parameters swapped
        /// into the first effect's (Porridge's own effects' entry 0 is the first itself).
        bool runCopy (int fx, bool active)
        {
            let kind = fx > 0 && fx < rack::numEntries ? rack::kindOf.at (fx) : -1;

            // (a distortion copy only runs while there is sound)
            if (kind < 0 || (kind == rack::distortionKind && ! active))
                return active;

            let k = fx - rack::kindValue.at (kind);
            let copy = rack::kindOwn.at (kind) ? k - 1 : k;
            var out = active;

            if (copy >= 0) swapKind (kind, copy);

            // every kind's first parameter is its switch
            if (P.at (rack::allFirst.at (rack::firstOffset.at (kind))) != 0)
                out = runKind (kind, k, active);

            if (copy >= 0) swapKind (kind, copy);
            return out;
        }

        /// Runs entry k of a rack kind, its parameters in the first's slots.
        bool runKind (int kind, int k, bool active)
        {
            if (kind == rack::chorusKind)   return choruses.at (k).process (fxTables, chorusRngs.at (k), mix, active, P, sampleRate);
            if (kind == rack::delayKind)    return delays.at (k).process (fxTables, mix, active, P, sampleRate, samplesPerBeat);
            if (kind == rack::reverbKind)   return reverbs.at (k).process (mix, active, P, sampleRate);
            if (kind == rack::eqKind)       return eqs.at (k).process (mix, active, P, sampleRate);
            if (kind == rack::flangerKind)  return flangers.at (k).process (mix, active, P, sampleRate);
            if (kind == rack::phaserKind)   return phasers.at (k).process (mix, active, P, sampleRate, noteHz);
            if (kind == rack::spaceKind)    return spaces.at (k).process (mix, active, P, sampleRate);
            if (kind == rack::bodeKind)     return bodes.at (k).process (mix, active, P, sampleRate);
            if (kind == rack::filterKind)   return filterFxs.at (k).process (fxTables, mix, active, P, sampleRate);
            if (kind == rack::utilityKind)  return utilities.at (k).process (mix, active, P, sampleRate);
            if (kind == rack::ambienceKind) return ambiences.at (k).process (mix, active, P, sampleRate);
            if (kind == rack::airKind)      return airs.at (k).process (mix, active, P, sampleRate);

            if (kind == rack::distortionKind)
            {
                useShaper (k + 1);
                distortions.at (k).processStereo (distTables, shaperTables.at (k + 1), P, 0.0f, sampleRate, mix);
                return active;
            }

            if (kind == rack::compressorKind)
            {
                let out = compressors.at (k).process (mix, active, P, sampleRate);

                if (meterCount == 0)
                    compMeterOut <- CompMeter (k, compressors.at (k).levelDb, compressors.at (k).gainDb);

                return out;
            }

            // the convolver: switched back on, or back in the rack, its old tail is gone
            if (convolverRan.at (k) != blockCount - 1)
                convolvers.at (k).clearState();

            convolverRan.at (k) = blockCount;
            return convolvers.at (k).process (mix, active, P, sampleRate);
        }

        //==============================================================================
        // the X/Y pad's, mod envelopes' and controllers' modulation (Oatmeal's)

        /// The X/Y pad's modulation slot k (0..3) of axis a (0: X, 1: Y), the mod envelopes' of
        /// envelope e (0, 1), and controller c's (0..5): their targets and depths.
        int xyTarget (int a, int k)     { return int (P.at ((a == 0 ? slot::XY_H_Target_1 : slot::XY_V_Target_1) + k)); }
        float xyDepth (int a, int k)    { return P.at ((a == 0 ? slot::XY_H_Depth_1 : slot::XY_V_Depth_1) + k); }
        int meTarget (int e, int k)     { return int (P.at ((e == 0 ? slot::M1_Target_1 : slot::M2_Target_1) + k)); }
        float meDepth (int e, int k)    { return P.at ((e == 0 ? slot::M1_Depth_1 : slot::M2_Depth_1) + k); }
        int ccTarget (int c, int k)     { return int (P.at (slot::CC1_Target_1 + c * ccStride + k)); }
        float ccDepth (int c, int k)    { return P.at (slot::CC1_Depth_1 + c * ccStride + k); }

        /// The slots of controller n + 1 follow controller n's by this many.
        let ccStride = slot::CC2 - slot::CC1;

        // the LFOs' modulation targets, by LFO
        let lfoMeDepth = int[2] (meTgt::lfo1Depth, meTgt::lfo2Depth);
        let lfoMeSpeed = int[2] (meTgt::lfo1Speed, meTgt::lfo2Speed);
        let lfoCcDepth = int[2] (ccTgt::lfo1Depth, ccTgt::lfo2Depth);
        let lfoCcSpeed = int[2] (ccTgt::lfo1Speed, ccTgt::lfo2Speed);
        let lfoXyDepth = int[2] (xyTgt::lfo1Depth, xyTgt::lfo2Depth);

        float xySum (int target, float x, float y)
        {
            float s = 0;

            for (int k = 0; k < 4; ++k)
            {
                if (xyTarget (0, k) == target) s += x * xyDepth (0, k);
                if (xyTarget (1, k) == target) s += y * xyDepth (1, k);
            }

            return s;
        }

        /// The controllers' modulation is the same for every voice: it is summed once per piece,
        /// after the controllers move. ccSum[t] is controller * depth over the slots aimed at
        /// target t, ccSumBipolar[t] the same with the controller as -1..1.
        void sumCcMods()
        {
            ccSum = float[ccTgt::unisonSpread + 1]();
            ccSumBipolar = float[ccTgt::unisonSpread + 1]();

            for (int c = 0; c < 6; ++c)
            {
                let cc = ccSmooth.at (c);
                let v = 2.0f * cc - 1.0f;

                for (int k = 0; k < 4; ++k)
                {
                    let t = ccTarget (c, k);

                    if (t > 0 && t <= ccTgt::unisonSpread)
                    {
                        let d = ccDepth (c, k);
                        ccSum.at (t) = ccSum.at (t) + cc * d;
                        ccSumBipolar.at (t) = ccSumBipolar.at (t) + v * d;
                    }
                }
            }

            ccXyDepth = ccDbProduct (ccTgt::xyDepth);
            ccMe1Depth = ccLinearProduct (ccTgt::me1Depth);
            ccMe2Depth = ccLinearProduct (ccTgt::me2Depth);

            // resonance() sums its controllers in this order (by slot, then controller)
            ccRes = 0;

            for (int k = 0; k < 4; ++k)
                for (int c = 0; c < 6; ++c)
                    if (ccTarget (c, k) == ccTgt::resonance)
                        ccRes += ccSmooth.at (c) * ccDepth (c, k);
        }

        float ccDbProduct (int target)
        {
            var f = 1.0f;

            for (int c = 0; c < 6; ++c)
                for (int k = 0; k < 4; ++k)
                    if (ccTarget (c, k) == target)
                        f *= dbFactor (ccSmooth.at (c), ccDepth (c, k));

            return f;
        }

        float ccLinearProduct (int target)
        {
            var f = 1.0f;

            for (int c = 0; c < 6; ++c)
                for (int k = 0; k < 4; ++k)
                    if (ccTarget (c, k) == target)
                        f *= 1.0f + ccSmooth.at (c) * ccDepth (c, k);

            return f;
        }

        float xyLinearProduct (int target, float x, float y)
        {
            var f = 1.0f;

            for (int k = 0; k < 4; ++k)
            {
                if (xyTarget (0, k) == target) f *= 1.0f + x * xyDepth (0, k);
                if (xyTarget (1, k) == target) f *= 1.0f + y * xyDepth (1, k);
            }

            return f;
        }

        /// sum over mod-env slots with a target: me1*d (ME1 slots) + me2*d (ME2 slots)
        float meSum (int target, float me1, float me2)
        {
            float s = 0;

            for (int k = 0; k < 4; ++k)
            {
                if (meTarget (0, k) == target) s += me1 * meDepth (0, k);
                if (meTarget (1, k) == target) s += me2 * meDepth (1, k);
            }

            return s;
        }

        float meDbProduct (int target, float me1, float me2)
        {
            var f = 1.0f;

            for (int k = 0; k < 4; ++k)
            {
                if (meTarget (0, k) == target) f *= dbFactor (me1, meDepth (0, k));
                if (meTarget (1, k) == target) f *= dbFactor (me2, meDepth (1, k));
            }

            return f;
        }

        float pow2 (float x)            { return float (pow (2.0, float64 (x))); }
        float octPow (float semis)      { return float (pow (float64 (octave), float64 (semis) / 12.0)); }

        float curveLerp (bool touch, float x)
        {
            let i = int (x);
            let f = x - float (i);
            let i0 = min (i, 63);
            let i1 = min (i + 1, 63);
            return touch ? (1.0f - f) * touchCurve.at (i0) + f * touchCurve.at (i1)
                         : (1.0f - f) * velCurve.at (i0) + f * velCurve.at (i1);
        }

        //==============================================================================
        // voice pool

        /// A new voice: everything zeroed once, then the parts that don't start at zero.
        void constructVoice (Voice& v)
        {
            v = Voice();

            for (wrap<maxUnison> k)
            {
                v.osc1[k].initDefaults();
                v.osc2[k].initDefaults();
            }

            for (wrap<2> k) v.dist[k].initDefaults();
            for (wrap<4> k) v.filt[k].initDefaults();
        }

        /// A stolen voice: its filters and distortion models are cleared, then it starts over as a
        /// new one does.
        void resetVoice (Voice& v)
        {
            for (wrap<4> k) v.filt[k].clearState();
            for (wrap<2> k) v.dist[k].clearModels();
            prepareVoice (v);
        }

        /// The state a voice starts a note from (after constructVoice or resetVoice).
        void prepareVoice (Voice& v)
        {
            v.relCount = -1;
            v.key = -1;
            v.stereoLatch = false;
            v.active = false;
            v.m1Last = 0;
            v.m2Last = 0;
            v.basePan = 0.5f;
            v.glideF0 = P[slot::Tune_Main];
            v.freq = P[slot::Tune_Main];
            v.glideProg = 2.0f;
            v.glideInc = 0;
            v.noise.resetNoise();

            let c = 6.10370189e-05f;

            for (wrap<maxUnison> k)
            {
                v.osc1[k].resetOsc();
                v.osc1[k].setPhase (rng, P);
                v.osc1[k].setPwmPhase (rng, P);
                v.osc2[k].resetOsc();
                v.osc2[k].setPhase (rng, P);
                v.osc2[k].setPwmPhase (rng, P);
                v.ratio[k] = 1.0f;
                v.uniL[k] = 1.0f;
                v.uniR[k] = 1.0f;
                v.jit[k] = (float (rng.next()) * c - 1.0f) * (1.0f / 1200.0f);
                v.panr[k] = float (rng.next()) * c - 1.0f;
            }

            v.uniU = 0;     // new jitter: the detune ratios are due

            for (wrap<2> k) v.lfo[k].resetPhase (rng, P);
            v.fenv = Env[4]();
            v.ampEnv = Env(); v.modEnv1 = Env(); v.modEnv2 = Env();
            v.oscEnv = Env[2]();
            v.keq = KeyEq();
            v.vel = 1.0f;
            v.randAmp = 1.0f;
            v.velGainTarget = 1.0f;
            v.velGain = 1.0f;
            v.lfo2Prev = 0;
            v.penvR = 0;
            v.penvStage = penvStage::off;
            v.lfoRaw = float[2]();
            v.ampLast = 0;
            v.modRand = 0;
            v.modNoise = 0;
            v.modGain = 1.0f;
            v.chan = 0;
        }

        int listPos (int vi)
        {
            for (int i = 0; i < numActive; ++i)
                if (order.at (i) == vi) return i;

            return -1;
        }

        void moveToHead (int vi)
        {
            let p = listPos (vi);
            if (p <= 0) return;

            for (int i = p; i > 0; --i)
                order.at (i) = order.at (i - 1);

            order.at (0) = vi;
        }

        void removeFromList (int vi)
        {
            let p = listPos (vi);
            if (p < 0) return;

            for (int i = p; i < numActive - 1; ++i)
                order.at (i) = order.at (i + 1);

            --numActive;
        }

        /// A new (fresh) voice at the head of the list.
        int allocateVoice()
        {
            for (int vi = 0; vi < maxVoices; ++vi)
            {
                if (listPos (vi) < 0)
                {
                    constructVoice (voices.at (vi));
                    prepareVoice (voices.at (vi));

                    for (int i = numActive; i > 0; --i)
                        order.at (i) = order.at (i - 1);

                    order.at (0) = vi;
                    ++numActive;
                    return vi;
                }
            }

            return -1;
        }

        //==============================================================================
        // voice note-on / note-off

        void voiceRelease (Voice& v)
        {
            v.relCount = 0;
            v.ampEnv.release (ampC, false);
            for (wrap<4> k) v.fenv[k].release (fenvCoefs (k), true);
            v.modEnv1.release (mod1C, true);
            v.modEnv2.release (mod2C, true);
            for (wrap<2> k) v.oscEnv[k].release (oscEnvC[k], true);
            v.penvStage = penvStage::release;
        }

        /// Filter envelope k's coefficients (Voice.fenv: filter 1's, then filter 2's, per side).
        EnvCoefs fenvCoefs (int k)      { return (k & 1) != 0 ? filt2C : filtC; }

        /// Triggers an envelope that has ended or is releasing (mono legato).
        void retriggerEnded (Env& e, const EnvCoefs& c, bool fade)
        {
            if (e.stage == envStage::off || e.stage >= envStage::release)
                e.trigger (c, fade);
        }

        float freqPanOffset (float f)
        {
            let fp = P[slot::FreqPan];
            if (abs (fp) <= 0.001f) return 0.0f;
            return fp * float (log (float64 (f) / float64 (P[slot::Tune_Main])) / float64 (lnOct) - float64 (P[slot::Tune_PanReference]) / 12.0);
        }

        float velAmpScale (float vel)
        {
            let s = P[slot::VeloSens];
            return s > 0 ? float (pow (float64 (vel), 2.0 * float64 (s))) : 1.0f + s * vel;
        }

        void voiceStart (int vi, int refIdx, float64 freq, int key, float velc)
        {
            // everything read from the reference voice is taken before this voice changes
            let hasRef = refIdx >= 0;
            var refInc1 = 0i64, refInc2 = 0i64;
            float refNoiseFreq = 0, refGlideF0 = 0, refFreq = 0, refGlideProg = 2.0f;

            if (hasRef)
            {
                refInc1 = voices.at (refIdx).osc1[0].base;
                refInc2 = voices.at (refIdx).osc2[0].base;
                refNoiseFreq = voices.at (refIdx).noise.freq;
                refGlideF0 = voices.at (refIdx).glideF0;
                refFreq = voices.at (refIdx).freq;
                refGlideProg = voices.at (refIdx).glideProg;
            }

            voiceStartOn (voices.at (vi), vi == refIdx, hasRef, refInc1, refInc2, refNoiseFreq, refGlideF0, refFreq, refGlideProg,
                          freq, key, velc);
        }

        void voiceStartOn (Voice& v, bool refIsSelf, bool hasRef, int64 refInc1, int64 refInc2, float refNoiseFreq,
                           float refGlideF0, float refFreq, float refGlideProg, float64 freq, int key, float velc)
        {
            let fresh = ! v.active;
            v.relCount = -1;
            v.age = 0;
            v.vel = velc;
            v.modRand = modRng.nextSigned();

            // the interval from the note before, alternate and cycle, and the connections latched
            // afresh
            v.interval = lastNoteHz > 0 ? clamp (float (log (freq / float64 (lastNoteHz)) / log (2.0)) * 0.5f, -1.0f, 1.0f) : 0.0f;
            lastNoteHz = float (freq);
            v.alternate = (noteCount & 1) == 0 ? 1.0f : -1.0f;
            v.cycle = float (noteCount & 3) * (1.0f / 3.0f);
            noteCount = (noteCount + 1) & 0xffff;
            v.latched = bool[mods::numSlots]();
            v.chan = noteChan.at (key & 0x7f);
            v.randAmp = float (pow (10.0, float64 (rng.bipolar() * P[slot::RandomAmp] * 0.05f)));

            if (fresh)
            {
                v.m1Last = 0;
                v.m2Last = 0;
                v.velGainTarget = v.randAmp * velAmpScale (velc);
                v.velGain = v.velGainTarget;
                v.basePan = (float (rng.next()) * (1.0f / 32768.0f) - 0.5f) * P[slot::RandomPan] + 0.5f;
                let g = panGains (clamp (v.basePan + freqPanOffset (float (freq)), 0.0f, 1.0f));
                v.panL = g[0];
                v.panR = g[1];

                for (wrap<maxUnison> k)
                {
                    v.osc1[k].setPhase (rng, P);
                    v.osc2[k].setPhase (rng, P);
                    v.osc1[k].setPwmPhase (rng, P);
                    v.osc2[k].setPwmPhase (rng, P);
                }

                for (wrap<2> k) v.lfo[k].resetPhase (rng, P);
                v.lfoSlew = float[2] (-1.0f, -1.0f);

                if (P[slot::U_RandomPhase] != 0)
                    randomUnisonPhases (v);

                startDrift (v);
                v.slewing = bool[mods::numSlots]();
                v.lfo3.resetLfo3 (extraRng, P);
                v.wander.a = extraRng.nextSigned();
                v.wander.b = extraRng.nextSigned();
                v.wander.phase = 0.5f + 0.5f * extraRng.nextSigned();
                v.wander.rate = 1.0f + 0.3f * extraRng.nextSigned();
                v.levelFollow = 0;
                v.level = 0;
            }
            else
            {
                if (P[slot::OscRetrig] != 0)
                {
                    for (wrap<maxUnison> k) { v.osc1[k].setPhase (rng, P); v.osc2[k].setPhase (rng, P); }

                    if (P[slot::U_RandomPhase] != 0)
                        randomUnisonPhases (v);
                }

                if (P[slot::PWMRetrig] != 0)
                    for (wrap<maxUnison> k) { v.osc1[k].setPwmPhase (rng, P); v.osc2[k].setPwmPhase (rng, P); }

                if (P[slot::LFORetrig] != 0)
                {
                    for (wrap<2> k) v.lfo[k].resetPhase (rng, P);
                    v.lfo3.resetLfo3 (extraRng, P);
                }
            }

            v.envSpeed = float (pow (float64 (octave), 2.0 * float64 (P[slot::FreqEnv])
                                      * (log (freq / float64 (P[slot::Tune_Main])) / float64 (lnOct) - float64 (P[slot::Tune_PanReference]) / 12.0)));

            let voiceMode = int (P[slot::PolyMode]);

            if (voiceMode < 2 || fresh)
            {
                if (fresh)
                {
                    v.mix = P[slot::F_Mix];
                    v.penvR = float (penvC.S);
                    v.penvStage = penvStage::attack;
                }
                else
                {
                    v.penvStage = penvStage::toStart;
                }

                v.ampEnv.trigger (ampC, false);

                for (int k = 0; k < (voiceMode < 2 ? 4 : 2); ++k)
                    v.fenv.at (k).trigger (fenvCoefs (k), true);

                v.modEnv1.trigger (mod1C, true);
                v.modEnv2.trigger (mod2C, true);

                // (from where they are, as the amp envelope does: no dip on a retrigger)
                for (wrap<2> k) v.oscEnv[k].trigger (oscEnvC[k], false);
            }
            else
            {
                if (v.penvStage > penvStage::sustain || v.penvStage < penvStage::attack)
                    v.penvStage = penvStage::attack;

                retriggerEnded (v.ampEnv, ampC, false);
                retriggerEnded (v.fenv[0], filtC, true);
                retriggerEnded (v.fenv[1], filt2C, true);
                retriggerEnded (v.modEnv1, mod1C, true);
                retriggerEnded (v.modEnv2, mod2C, true);
                for (wrap<2> k) retriggerEnded (v.oscEnv[k], oscEnvC[k], false);
            }

            // glide
            let G = int (float64 (P[slot::Glide]) * float64 (srInt) * 0.001 + 0.5);
            let newInc1 = int64 (two32 * freq / float64 (srInt) + 0.5) & u32;
            let noiseTarget = float (freq * pow (float64 (octave), float64 (P[slot::N_Transpose]) / 12.0));
            let glide = G > 10 && (fresh || refIsSelf) && hasRef;

            if (! glide)
            {
                v.osc1[0].base = newInc1;
                v.osc1[0].glideOn = false;
                v.osc1[0].step = 0;
                v.noise.freq = noiseTarget;
                v.noise.glideOn = false;
                v.glideProg = 2.0f;
                v.glideF0 = float (freq);
            }
            else
            {
                let oldInc = refInc1 == 0 ? 1i64 : refInc1;
                let o = abs (log (float64 (newInc1) / float64 (oldInc))) / float64 (lnOct);
                let oc = max (o, 0.001);
                let mode = int (P[slot::GlideMode]);
                float64 factor = 1.0;

                if (mode == 1)      factor = o;
                else if (mode == 2) factor = 1.0 / oc;
                else if (mode == 3) factor = oc + 1.0 / oc;
                else if (mode == 4) factor = 1.0 + o;
                else if (mode == 5) factor = 1.0 + 1.0 / oc;
                else if (mode == 6) factor = 1.0 + oc + 1.0 / oc;

                let Ng = int (float64 (G) * factor + 0.5);
                v.osc1[0].base = oldInc;
                v.osc1[0].glideTo (newInc1, Ng);
                v.osc2[0].base = refInc2;
                v.noise.freq = refNoiseFreq;
                v.noise.glideTo (noiseTarget, Ng);

                if (Ng > 0)
                {
                    v.glideInc = 1.0f / float (Ng);
                    v.glideF0 = refGlideProg < 1.0f ? refGlideF0 + (refFreq - refGlideF0) * refGlideProg : refFreq;
                    v.glideProg = 0;
                }
                else
                {
                    v.glideProg = 2.0f;
                    v.glideF0 = float (freq);
                }
            }

            v.freq = float (freq);
            v.active = true;
            v.key = key;
        }

        //==============================================================================
        // voice manager note-on (allocation, stealing, voice modes)

        void vmNoteOn (float64 freq, int key, float velc)
        {
            int same = -1;

            for (int i = 0; i < numActive; ++i)
            {
                let vi = order.at (i);
                if (voices.at (vi).key == key && voices.at (vi).relCount < 0) { same = vi; break; }
            }

            keyReleased.at (key & 0xff) = false;
            let voiceMode = int (P[slot::PolyMode]);

            if (! (voiceMode == 2 && anyVoiceHeld()))
            {
                phantom1.trigger (mod1C, true);
                phantom2.trigger (mod2C, true);
            }

            if (P[slot::LFO_1_Sync] < 2) gLfo1.resetPhase (rng, P);
            if (P[slot::LFO_2_Sync] < 2) gLfo2.resetPhase (rng, P);
            if (P[slot::LFO_3_Mode] == 1) gLfo3.resetLfo3 (extraRng, P);

            let oldHead = numActive > 0 ? order.at (0) : -1;

            if (same >= 0)
            {
                // re-striking a held key: same voice, velocity plus its current envelope level
                voiceStart (same, oldHead, freq, key, velc + voices.at (same).ampEnv.L);
                moveToHead (same);
                return;
            }

            int vi = -1;
            int ref = oldHead;
            let maxPoly = clamp (int (P[slot::Voices]), 1, maxVoices);

            if (voiceMode == 2)
            {
                if (numActive == 0)
                {
                    vi = allocateVoice();
                    ref = -1;
                }
                else
                {
                    vi = order.at (0);
                    keyReleased.at (voices.at (vi).key & 0xff) = true;
                    ref = vi;
                }
            }
            else if (numActive >= maxPoly)
            {
                var best = 0;

                for (int i = 0; i < numActive; ++i)
                {
                    let u = order.at (i);
                    if (voices.at (u).relCount >= best) { best = voices.at (u).relCount; vi = u; }
                }

                if (vi < 0)
                    vi = order.at (numActive - 1);

                moveToHead (vi);
                keyReleased.at (voices.at (vi).key & 0xff) = true;

                if (voices.at (vi).ampEnv.L <= 1e-4f && vi != oldHead)
                    resetVoice (voices.at (vi));
            }
            else
            {
                vi = allocateVoice();
            }

            if (vi < 0)
                return;

            voiceStart (vi, ref, freq, key, velc);

            if (voiceMode != 1)
            {
                for (int i = 1; i < numActive; ++i)
                {
                    let u = order.at (i);
                    keyReleased.at (voices.at (u).key & 0xff) = true;
                    voiceRelease (voices.at (u));
                }
            }
        }

        /// The note trigger: velocity through the curve, random detune, frequency.
        void voiceNote (int key, int vel, float off)
        {
            if (key < 0)
                return;

            if (vel == 0)
            {
                let k = key & 0xff;
                keyReleased.at (k) = true;

                for (int i = 0; i < numActive; ++i)
                {
                    let vi = order.at (i);
                    if ((voices.at (vi).key & 0xff) == k)
                        voiceRelease (voices.at (vi));
                }

                if (! anyVoiceHeld())
                {
                    phantom1.release (mod1C, true);
                    phantom2.release (mod2C, true);
                }

                return;
            }

            // a microtuned key that isn't mapped doesn't sound
            if (tuningOn && keySemitones.at (key & 0x7f) < -1000.0f)
                return;

            let x = curveIndex (vel);
            let velc = curveLerp (false, x);
            let det = rng.bipolar() * P[slot::RandomFreq] * 0.01f;
            let semis = float (det + off);
            var freq = float64 (P[slot::Tune_Main]) * pow (float64 (octave), (float64 ((key & 0xff) - 69) + float64 (semis)) / 12.0);

            // a scale sets the key's pitch; tune still moves 440 Hz, and offsets (arp shifts,
            // random detune) stay in the octave's semitones
            if (tuningOn)
                freq = float64 (P[slot::Tune_Main]) * pow (2.0, float64 (keySemitones.at (key & 0x7f)) / 12.0)
                         * pow (float64 (octave), float64 (semis) / 12.0);

            vmNoteOn (freq, key, velc);
        }

        //==============================================================================
        // note object: held notes, return-to-held, arpeggiator

        void allNotesOff()
        {
            gSub = 0; gSubPrev = 0; prevCmd = 0; firstNote = false;
            numActive = 0;

            for (int k = 0; k < 256; ++k) keyReleased.at (k) = true;
            for (int k = 0; k < 128; ++k) perKeyAT.at (k) = 0;

            phantom1 = Env();
            phantom2 = Env();
            heldCount = 0; stampCounter = 0; subFlag = false; arpPhase = 0; stepIdx = 0;
            dir = 1; prevDir = 1; curKey = -1; arpPos = -1; arpPrevPos = -1;
        }

        /// Whether any voice's note is still held (not released).
        bool anyVoiceHeld()
        {
            for (int i = 0; i < numActive; ++i)
                if (voices.at (order.at (i)).relCount < 0)
                    return true;

            return false;
        }

        bool keyHasHeldVoice (int k)
        {
            for (int i = 0; i < numActive; ++i)
            {
                let vi = order.at (i);
                if (voices.at (vi).key == k && voices.at (vi).relCount < 0) return true;
            }

            return false;
        }

        // heldInsert and heldRemove leave heldSub where it is, as Oatmeal does: the per-note
        // subsequence counters belong to list positions, not notes (docs/internals/notes_arp.md 4.2)
        void heldInsert (int key, int vel)
        {
            if (key < 0 || heldCount >= 128) return;

            var i = 0;

            while (i < heldCount)
            {
                if (heldKey.at (i) == key) return;
                if (heldKey.at (i) > key) break;
                ++i;
            }

            for (int j = heldCount; j > i; --j)
            {
                heldKey.at (j) = heldKey.at (j - 1);
                heldVel.at (j) = heldVel.at (j - 1);
                heldStamp.at (j) = heldStamp.at (j - 1);
            }

            if (arpPos >= i) ++arpPos;
            if (arpPrevPos >= i) ++arpPrevPos;

            heldKey.at (i) = key;
            heldVel.at (i) = vel;
            heldSub.at (i) = 0;
            heldStamp.at (i) = stampCounter;
            ++stampCounter;
            ++heldCount;
        }

        void heldRemove (int key)
        {
            if (heldCount > 0)
            {
                var found = -1;

                for (int i = 0; i < heldCount; ++i)
                    if (heldKey.at (i) == key) { found = i; break; }

                if (found >= 0)
                {
                    let i = found;
                    if (arpPos > i || (arpPos == i && i == heldCount - 1)) --arpPos;
                    if (arpPrevPos > i || (arpPrevPos == i && i == heldCount - 1)) --arpPrevPos;
                    --heldCount;

                    for (int j = i; j < heldCount; ++j)
                    {
                        heldKey.at (j) = heldKey.at (j + 1);
                        heldVel.at (j) = heldVel.at (j + 1);
                        heldStamp.at (j) = heldStamp.at (j + 1);
                    }
                }

                if (int (P[slot::Arp_Mode]) == 0)
                    returnToHeld (key);
            }

            if (heldCount <= 0)
            {
                heldCount = 0;
                gSub = 0;
                gSubPrev = 0;
            }
        }

        /// Mono/legato: releasing the sounding note brings back the OLDEST still-held note.
        void returnToHeld (int key)
        {
            let k = key & 0xff;
            let hasActive = keyHasHeldVoice (k);

            if (! hasActive && keyReleased.at (k))
                return;

            if (! (P[slot::Sustain] > 0.001f) && int (P[slot::PolyMode]) == 1)
                return;

            var best = 0x7fffffff;
            var bi = -1;

            for (int i = 0; i < heldCount; ++i)
            {
                if (keyHasHeldVoice (heldKey.at (i) & 0xff))
                    continue;

                if (heldStamp.at (i) <= best)
                {
                    best = heldStamp.at (i);
                    bi = i;
                }
            }

            if (bi >= 0)
            {
                heldStamp.at (bi) = stampCounter;
                ++stampCounter;
                voiceNote (heldKey.at (bi), heldVel.at (bi), 0.0f);
            }
        }

        bool arpNoteOn (int j)          { return j >= 1 && j <= 7 && P.at (slot::Arp_Add_1_On + (j - 1)) != 0; }
        float arpShift (int j)          { return j >= 1 && j <= 7 ? P.at (slot::Arp_Add_1_Shift + (j - 1)) : 0.0f; }

        int advanceSub (int cIn)
        {
            var c = cIn;

            if (c > 0 && ! arpNoteOn (c))
            {
                loop
                {
                    if (c > 7) break;
                    ++c;
                    if (arpNoteOn (c)) break;
                }
            }

            if (c > 7) c = 0;
            return c;
        }

        void handleNote (int key, int vel)
        {
            if (vel > 0) heldInsert (key, vel);
            else         heldRemove (key);

            if (vel > 0 && heldCount == 1)
            {
                firstNote = true;
                gSub = 0;
                gSubPrev = 0;
            }

            let mode = int (P[slot::Arp_Mode]);

            if (mode == 0)
            {
                voiceNote (key, vel, 0.0f);
                return;
            }

            if (vel == 0)
            {
                if (mode >= 4) voiceNote (key, 0, 0);
                return;
            }

            if (mode < 4 || prevCmd == 0)
                return;

            if (mode == 4)
            {
                voiceNote (key, vel, 0.0f);

                for (int j = 1; j <= 7; ++j)
                    if (arpNoteOn (j))
                        voiceNote (key + 256 * j, vel, arpShift (j));
            }
            else
            {
                gSub = advanceSub (gSub);

                if (gSub <= 0) voiceNote (key, vel, 0.0f);
                else           voiceNote (key + (gSub << 8), vel, arpShift (gSub));
            }
        }

        float64 arpStepLength()
        {
            var s = float64 (P[slot::Arp_Step]);

            if (P[slot::Arp_Quantize] != 0)
                s = (3.0 * s >= 2.0) ? float64 (int (s + 0.5)) : 1.0 / float64 (int (1.0 / s + 0.5));

            let unit = int (P[slot::Arp_Unit]);
            float64 L;

            // the arpeggiator's note lengths are half the LFO's (exactly: halving is exact)
            if (unit == 0)      L = s * float64 (srInt) * 0.001;
            else if (unit == 1) L = s * float64 (srInt) * 0.01;
            else if (unit == 2) L = s * float64 (srInt);
            else                L = s * samplesPerBeat * (lfoUnitBeats (unit) * 0.5);

            return max (L, 1.0);
        }

        int arpCommand (int c)
        {
            let n = heldCount;

            if (c == 1)       { prevDir = dir; dir = 1;  arpPrevPos = arpPos; ++arpPos; if (arpPos >= n || arpPos < 0) arpPos = 0; }
            else if (c == 2)  { prevDir = dir; dir = 1;  arpPrevPos = arpPos; ++arpPos; if (arpPos >= n) arpPos = n - 1; else if (arpPos < 0) arpPos = 0; }
            else if (c == 3)  { prevDir = dir; dir = -1; arpPrevPos = arpPos; --arpPos; if (arpPos >= n || arpPos < 0) arpPos = n - 1; }
            else if (c == 4)  { prevDir = dir; dir = -1; arpPrevPos = arpPos; --arpPos; if (arpPos >= n) arpPos = n - 1; else if (arpPos < 0) arpPos = 0; }
            else if (c == 5 || c == 6)
            {
                prevDir = dir;
                let d = rng.randomSign();
                dir = d;
                arpPrevPos = arpPos;
                arpPos += d;

                if (c == 5) { if (arpPos >= n) arpPos = 0; else if (arpPos < 0) arpPos = n - 1; }
                else        { if (arpPos >= n) arpPos = n - 1; else if (arpPos < 0) arpPos = 0; }
            }
            else if (c == 7)
            {
                return curKey;
            }
            else if (c == 8)
            {
                if (dir == 0) dir = rng.randomSign();
                prevDir = dir; arpPrevPos = arpPos; arpPos += dir;
                if (arpPos >= n) arpPos = 0; else if (arpPos < 0) arpPos = n - 1;
            }
            else if (c == 9)
            {
                if (dir == 0) dir = rng.randomSign();
                arpPrevPos = arpPos; arpPos += dir; prevDir = dir;

                if (arpPos >= n)     { dir = -1; arpPos = n - 2; if (arpPos < 0) arpPos = 0; }
                else if (arpPos < 0) { dir = 1;  arpPos = n > 1 ? 1 : 0; }
            }
            else if (c >= 10 && c <= 12)
            {
                if (arpPrevPos < 0 || arpPrevPos >= n)
                {
                    arpPrevPos = arpPos;
                    prevDir = 1;
                    dir = 1;
                    return curKey;
                }

                let old = arpPos;

                if (c == 10)
                {
                    arpPos = arpPrevPos;
                    arpPrevPos = old;
                    let t = dir; dir = prevDir; prevDir = t;
                }
                else
                {
                    arpPos = c == 11 ? arpPrevPos + 1 : arpPrevPos - 1;
                    if (arpPos >= n) arpPos = 0;
                    if (arpPos < 0) arpPos = n - 1;
                    arpPrevPos = old;
                    let t = dir; dir = -prevDir; prevDir = t;
                }
            }
            else if (c == 13) { prevDir = dir; dir = 1;  arpPrevPos = arpPos; arpPos = n - 1; }
            else if (c == 14) { prevDir = dir; dir = -1; arpPrevPos = arpPos; arpPos = 0; }
            else if (c == 15)
            {
                prevDir = dir;
                arpPrevPos = arpPos;
                arpPos = clamp (int (float (rng.next()) * float (n - 1) * (1.0f / 32768.0f) + 0.5f), 0, n - 1);
                dir = arpPos > arpPrevPos ? 1 : (arpPos == arpPrevPos ? 0 : -1);
            }

            return heldKey.at (clamp (arpPos, 0, 127));
        }

        void arpChordStep (int c, int mode)
        {
            if (c == 0)
            {
                for (int i = 0; i < heldCount; ++i)
                    voiceNote (heldKey.at (i), 0, 0);

                return;
            }

            if (mode == 4)
            {
                if (prevCmd == 0)
                {
                    for (int i = 0; i < heldCount; ++i)
                    {
                        voiceNote (heldKey.at (i), heldVel.at (i), 0.0f);

                        for (int j = 1; j <= 7; ++j)
                            if (arpNoteOn (j))
                                voiceNote (heldKey.at (i) + 256 * j, heldVel.at (i), arpShift (j));
                    }
                }

                return;
            }

            if (c == 7) gSub = gSubPrev;
            gSub = advanceSub (gSub);

            if (! (gSub == gSubPrev && prevCmd != 0))
            {
                for (int i = 0; i < heldCount; ++i)
                    voiceNote (heldKey.at (i), 0, 0);

                for (int i = 0; i < heldCount; ++i)
                {
                    if (gSub == 0) voiceNote (heldKey.at (i), heldVel.at (i), 0.0f);
                    else           voiceNote (heldKey.at (i) + (gSub << 8), heldVel.at (i), arpShift (gSub));
                }
            }

            gSubPrev = gSub;
            ++gSub;
            if (gSub > 7) gSub = 0;
        }

        void arpDoStep()
        {
            if (stepIdx > int (P[slot::Arp_End])) stepIdx = 0;
            if (stepIdx > 15 || stepIdx < 0) stepIdx = 0;

            let c = int (P.at (slot::Arp_P0 + stepIdx));
            let mode = int (P[slot::Arp_Mode]);

            if (mode >= 4)
            {
                arpChordStep (c, mode);
            }
            else if (c == 0)
            {
                if (curKey >= 0) voiceNote (curKey, 0, 0);
            }
            else
            {
                var key = heldCount > 0 ? arpCommand (c) : -1;
                float shift = 0;

                if (mode != 3 && arpPos >= 0 && arpPos < 128 && (arpNoteOn (1) || arpNoteOn (2) || arpNoteOn (3) || arpNoteOn (4)))
                {
                    if (mode == 1)
                    {
                        if (c == 7)
                        {
                            if (subFlag && ((curKey ^ key) & 0xff) == 0)
                            {
                                heldSub.at (arpPos) = heldSub.at (arpPos) - 1;
                                if (heldSub.at (arpPos) < 0) heldSub.at (arpPos) = 7;
                            }

                            subFlag = false;
                        }

                        heldSub.at (arpPos) = advanceSub (heldSub.at (arpPos));
                        let s = heldSub.at (arpPos);

                        if (s > 0)
                        {
                            if (key >= 0) key = (key & 0xff) + (s << 8);
                            shift = arpShift (s);
                        }

                        subFlag = true;
                        heldSub.at (arpPos) = heldSub.at (arpPos) + 1;
                        if (heldSub.at (arpPos) > 7) heldSub.at (arpPos) = 0;
                    }
                    else
                    {
                        if (c == 7)
                        {
                            if (subFlag) gSub = gSubPrev;
                            subFlag = false;
                        }

                        gSub = advanceSub (gSub);

                        if (gSub > 0)
                        {
                            if (key >= 0) key = (key & 0xff) + (gSub << 8);
                            shift = arpShift (gSub);
                        }

                        gSubPrev = gSub;
                        ++gSub;
                        if (gSub > 7) gSub = 0;
                        subFlag = true;
                    }
                }

                if (! (int (P[slot::PolyMode]) == 2 && key != -1))
                    if (curKey != key && curKey >= 0)
                        voiceNote (curKey, 0, 0);

                if (((curKey != key && key >= 0) || prevCmd == 0) && key >= 0)
                {
                    let p = clamp (arpPos, 0, 127);

                    if (mode == 3)
                    {
                        voiceNote (key, heldVel.at (p), 0.0f);

                        for (int j = 1; j <= 7; ++j)
                            if (arpNoteOn (j))
                                voiceNote (key + 256 * j, heldVel.at (p), arpShift (j));
                    }
                    else
                    {
                        voiceNote (key, heldVel.at (p), shift);
                    }
                }

                curKey = key;
            }

            prevCmd = c;
            ++stepIdx;
        }

        /// Oatmeal's arpeggiator clock, at the end of every block: steps fall on block starts.
        void arpTick()
        {
            if (int (P[slot::Arp_Mode]) == 0)
                return;

            if (firstNote)
                arpStart();
            else
                arpAdvance (blockSize);
        }

        void arpStart()
        {
            firstNote = false;
            dir = 0;
            arpPhase = 0;
            stepIdx = 0;
            arpDoStep();
        }

        /// Moves the clock on n samples, stepping when it passes the step length.
        void arpAdvance (int n)
        {
            let L = arpStepLength();
            arpPhase += float64 (n);

            if (arpPhase >= L)
            {
                arpPhase -= float64 (int (arpPhase / L)) * L;
                arpDoStep();
            }
        }

        /// Samples until the arpeggiator's next step (at least 1), or blockSize when it's off.
        int arpSamplesToStep()
        {
            if (int (P[slot::Arp_Mode]) == 0)
                return blockSize;

            return clamp (int (ceil (arpStepLength() - arpPhase)), 1, blockSize);
        }

        //==============================================================================
        // MIDI

        /// Handles the next `count` queued messages.
        void handleMidi (int count)
        {
            for (int i = 0; i < count; ++i)
                handleMessage (midiQueue.at (midiHead + i).message);

            midiHead += count;

            if (midiHead == midiCount)
            {
                midiHead = 0;
                midiCount = 0;
            }
        }

        /// Moves the messages not yet handled to the front of the queue, once per block.
        void compactMidi()
        {
            if (midiHead == 0)
                return;

            for (int i = midiHead; i < midiCount; ++i)
            {
                midiQueue.at (i - midiHead) = midiQueue.at (i);
                midiTime.at (i - midiHead) = midiTime.at (i);
            }

            midiCount -= midiHead;
            midiHead = 0;
        }

        void handleMessage (int m)
        {
            // MPE (lower zone): channel 1 is the master channel and plays like any other; notes on
            // channels 2-16 get the bend, pressure and slide of their own channel
            let mpe = P[slot::MPE_On] != 0;
            let status = (m >> 16) & 0xff;
            let type = status & 0xf0;
            let ch = status & 15;
            let d1 = (m >> 8) & 0x7f;
            let d2 = m & 0x7f;

            if (! mpe && P.at (slot::MIDI_Channel_1 + ch) == 0)
                return;

            let member = mpe && ch != 0;

            if (member && type == 0xd0)
            {
                chPressureTarget.at (ch) = curveLerp (true, curveIndex (d1));
                return;
            }

            if (member && type == 0xe0)
            {
                chBendTarget.at (ch) = float (bend14 (d1, d2)) * P[slot::MPE_BendRange] * (1.0f / 8192.0f);
                return;
            }

            if (member && type == 0xb0 && d1 == 74)
            {
                chSlideTarget.at (ch) = float (d2) / 127.0f;
                return;
            }

            if (type == 0x90 && d2 > 0)
            {
                noteChan.at (d1) = mpe ? ch : 0;
                let at = curveLerp (true, curveIndex (d2));
                pressureTarget = at;
                perKeyAT.at (d1) = at;
                handleNote (d1, d2);
            }
            else if (type == 0x80 || type == 0x90)
            {
                handleNote (d1, 0);
            }
            else if (type == 0xb0)
            {
                if (d1 >= 123)
                {
                    allNotesOff();
                    return;
                }

                if (d1 == 64)
                    sustainDown = P[slot::SustainPedal] != 0 && d2 >= 63;

                if (d1 > 0)
                {
                    rawCC.at (d1) = float (d2) / 127.0f;

                    // the interface only needs to see a controller move (MIDI learn), so once
                    // per block is plenty
                    if (! ccReported.at (d1))
                    {
                        ccReported.at (d1) = true;
                        ccOut <- d1;
                    }

                    if (int (P[slot::XY_H_CC]) == d1) P[slot::XY_X] = 2.0f * float (d2) / 127.0f - 1.0f;
                    if (int (P[slot::XY_V_CC]) == d1) P[slot::XY_Y] = 2.0f * float (d2) / 127.0f - 1.0f;
                }
            }
            else if (type == 0xa0)
            {
                perKeyAT.at (d1) = curveLerp (true, curveIndex (d2));
            }
            else if (type == 0xd0)
            {
                pressureTarget = curveLerp (true, curveIndex (d1));
            }
            else if (type == 0xe0)
            {
                bendTarget = float (bend14 (d1, d2)) * P[slot::BendRange] * (1.0f / 8192.0f);
                bendNormTarget = float (bend14 (d1, d2)) * (1.0f / 8192.0f);
            }
        }

        /// A 7-bit MIDI value as a position on a 64-point response curve.
        float curveIndex (int d)        { return float (d) * 0.00787401572f * 64.0f; }

        /// A pitch bend's 14-bit value, centred: -8192 .. 8191.
        int bend14 (int lsb, int msb)   { return (msb - 64) * 128 + lsb; }

        //==============================================================================
        // per-block preparation: derived coefficients, controller smoothing, XY walk

        float catmull (const float[4]& p, float t)
        {
            return (((-0.5f * p[0] + 1.5f * p[1] - 1.5f * p[2] + 0.5f * p[3]) * t
                      + (p[0] - 2.5f * p[1] + 2.0f * p[2] - 0.5f * p[3])) * t + 0.5f * (p[2] - p[0])) * t + p[1];
        }

        /// Derived values the original recomputes at the start of every process call.
        void computeDerived()
        {
            samplesPerBeat = 60.0 / float64 (bpm) * float64 (srInt);
            octave = P[slot::Tune_Octave];
            if (octave < 1.001f) octave = 2.0f;
            lnOct = float (log (float64 (octave)));

            // the envelope coefficients follow only parameters (which the modulation matrix
            // never moves outside a block), so they wait for a parameter change
            if (paramsChanged)
            {
                paramsChanged = false;
                let fr = P[slot::F_Speed];
                ampC   = makeEnvCoefs (P, slot::Attack, slot::Curve_Amp_Attack, slot::Curve_Amp_Decay1, sampleRate, 1.0f);
                filtC  = makeEnvCoefs (P, slot::F_Attack, slot::Curve_Filter_Attack, slot::Curve_Filter_Decay1, sampleRate, 1.0f);
                filt2C = makeEnvCoefs (P, slot::F_Attack, slot::Curve_Filter_Attack, slot::Curve_Filter_Decay1, sampleRate, fr > 0 ? fr : 1.0f);
                mod1C  = makeEnvCoefs (P, slot::M1_Attack, slot::Curve_Mod1_Attack, slot::Curve_Mod1_Decay1, sampleRate, 1.0f);
                mod2C  = makeEnvCoefs (P, slot::M2_Attack, slot::Curve_Mod2_Attack, slot::Curve_Mod2_Decay1, sampleRate, 1.0f);
                oscEnvC[0] = makeEnvCoefsFrom (P, slot::OE1_Attack, slot::OE1_Hold, slot::OE1_Decay1, slot::OE1_Decay2, slot::OE1_Release,
                                               slot::OE1_Breakpoint, slot::OE1_Sustain, slot::Curve_Osc1_Attack, slot::Curve_Osc1_Decay1,
                                               sampleRate, 1.0f);
                oscEnvC[1] = makeEnvCoefsFrom (P, slot::OE2_Attack, slot::OE2_Hold, slot::OE2_Decay1, slot::OE2_Decay2, slot::OE2_Release,
                                               slot::OE2_Breakpoint, slot::OE2_Sustain, slot::Curve_Osc2_Attack, slot::Curve_Osc2_Decay1,
                                               sampleRate, 1.0f);
                penvC  = makePitchEnvCoefs (P, float64 (srInt));
            }

            if (user1Dirty) { tables.buildUserSet (setUser1, wave1); user1Dirty = false; }
            if (user2Dirty) { tables.buildUserSet (setUser2, wave2); user2Dirty = false; }
        }

        /// Controller smoothing and the XY random walk over n samples, once per block after MIDI.
        void smoothControllers (int n)
        {
            if (P[slot::SustainPedal] == 0)
                sustainDown = false;

            if (abs (bendTarget) < 0.01f) bendTarget = 0;
            if (abs (bendSmooth - bendTarget) < 0.001f) bendSmooth = bendTarget;
            if (abs (pressureSmooth - pressureTarget) < 0.001f) pressureSmooth = pressureTarget;
            if (abs (xSmooth - P[slot::XY_X]) < 0.001f) xSmooth = P[slot::XY_X];
            if (abs (ySmooth - P[slot::XY_Y]) < 0.001f) ySmooth = P[slot::XY_Y];

            let k64 = ctrlSmooth.at (n);

            // XY random walk (Catmull-Rom through random points inside the radius)
            if (walkT >= 1.0f)
            {
                walkT -= 1.0f;
                let r = float (sqrt (float64 (rng.next()) * (1.0 / 32768.0))) * P[slot::XY_Var_Radius];
                let a = float64 (rng.next()) * float64 (piF) * (1.0 / 16384.0);

                for (int k = 0; k < 3; ++k)
                {
                    walkX.at (k) = walkX.at (k + 1);
                    walkY.at (k) = walkY.at (k + 1);
                }

                walkX[3] = r * float (cos (a));
                walkY[3] = r * float (sin (a));
            }

            let wx = catmull (walkX, walkT);
            let wy = catmull (walkY, walkT);
            walkT += float (float64 (n) * float64 (P[slot::XY_Var_Rate]) / float64 (srInt));

            bendSmooth += (bendTarget - bendSmooth) * k64;
            bendNorm += (bendNormTarget - bendNorm) * k64;
            wheel += (rawCC[1] - wheel) * k64;

            if (P[slot::MPE_On] != 0)
            {
                for (wrap<16> c)
                {
                    chBend[c] += (chBendTarget[c] - chBend[c]) * k64;
                    chPressure[c] += (chPressureTarget[c] - chPressure[c]) * k64;
                    chSlide[c] += (chSlideTarget[c] - chSlide[c]) * k64;
                }
            }
            pressureSmooth += (pressureTarget - pressureSmooth) * k64;
            xSmooth += (P[slot::XY_X] - xSmooth) * k64;
            ySmooth += (P[slot::XY_Y] - ySmooth) * k64;

            // the filter morph knob's steps would click while voices sound, so it glides there
            // (runFilter puts its modulation back on top)
            morphKnob = P[slot::F_Morph];
            morphGlide = numActive == 0 || abs (morphGlide - morphKnob) < 0.001f ? morphKnob : morphGlide + (morphKnob - morphGlide) * k64;

            for (int cc = 0; cc < 6; ++cc)
            {
                let num = int (P.at (slot::CC1 + cc * ccStride));
                if (num > 0) ccSmooth.at (cc) = ccSmooth.at (cc) + (rawCC.at (num & 127) - ccSmooth.at (cc)) * k64;
                else ccSmooth.at (cc) = 0;
            }

            curX = xSmooth + wx;
            curY = ySmooth + wy;

            xyReportSamples += n;

            if (xyReportSamples >= 8 * blockSize)
            {
                xyReportSamples = 0;

                if (curX != xyReportedX || curY != xyReportedY)
                {
                    xyReportedX = curX;
                    xyReportedY = curY;
                    xyOut <- float<2> (curX, curY);
                }
            }
        }

        //==============================================================================
        // voice manager render

        /// Renders the voices into mix[pos .. pos + n).
        bool renderVoices (int pos, int n)
        {
            let X = curX, Y = curY;

            if (noiseLive)
                noiseGlobal = noiseRng.nextSigned();

            var held = 0;

            for (int i = 0; i < numActive; ++i)
                if (voices.at (order.at (i)).relCount < 0)
                    ++held;

            heldNotes = clamp (float (held - 1) * (1.0f / 7.0f), 0.0f, 1.0f);

            if (numLive > 0)
            {
                evalMods (-1, 0);
                applyMods();
            }

            if (lfo3Live && P[slot::LFO_3_Mode] != 0)
                gLfo3Raw = gLfo3.stepLfo3 (extraRng, P, sampleRate, samplesPerBeat, n);

            if (numActive == 0)
            {
                gLfo1.step (tables, rng, P, lfoShape[0], 0, n, xySum (xyTgt::lfo1Speed, X, Y), sampleRate, samplesPerBeat);
                gLfo2.step (tables, rng, P, lfoShape[1], 1, n, xySum (xyTgt::lfo1Speed, X, Y) + xySum (xyTgt::lfo2Speed, X, Y), sampleRate, samplesPerBeat);
                return false;
            }

            // global XY depth from the phantom envelopes of the previous block
            let f = meDbProduct (meTgt::xyDepth, phantom1Val, phantom2Val) * ccXyDepth;
            let Xg = clamp (f * X, -2.0f, 2.0f);
            let Yg = clamp (f * Y, -2.0f, 2.0f);

            let Sm = xySum (xyTgt::modEnvelopeSpeed, Xg, Yg) + ccSum[ccTgt::modEnvelopeSpeed];
            let phSpeed = Sm != 0 ? pow2 (2.0f * Sm) : 1.0f;
            let me1Fac = xyLinearProduct (xyTgt::me1Depth, Xg, Yg) * ccMe1Depth;
            let me2Fac = xyLinearProduct (xyTgt::me2Depth, Xg, Yg) * ccMe2Depth;
            phantom1Val = phantom1.renderBlock (mod1C, phSpeed, sustainDown, n) * me1Fac;
            phantom2Val = phantom2.renderBlock (mod2C, phSpeed, sustainDown, n) * me2Fac;

            let A = meSum (meTgt::lfo1Speed, phantom1Val, phantom2Val) + ccSum[ccTgt::lfo1Speed];
            let gSpeed1 = abs (A) > 0.001f ? pow2 (2.0f * A) : 1.0f;
            let B = meSum (meTgt::lfo2Speed, phantom1Val, phantom2Val) + ccSum[ccTgt::lfo2Speed];
            let gSpeed2 = abs (B) > 0.001f ? pow2 (2.0f * B) : 1.0f;

            let g1n = int ((P[slot::LFO_2_1] * gLfo2Prev * 3.0f + gSpeed1) * float (n) + 0.5f);
            gv[0] = slewLfo (gLfo1Slew, gLfo1.step (tables, rng, P, lfoShape[0], 0, g1n, xySum (xyTgt::lfo1Speed, Xg, Yg), sampleRate, samplesPerBeat),
                             P[slot::LFO_1_Slew], n);
            gLfoRaw[0] = 2.0f * gv[0] - 1.0f;
            let g2n = int ((P[slot::LFO_1_2] * gv[0] * 3.0f + gSpeed2) * float (n) + 0.5f);
            gv[1] = slewLfo (gLfo2Slew, gLfo2.step (tables, rng, P, lfoShape[1], 1, g2n, xySum (xyTgt::lfo1Speed, Xg, Yg) + xySum (xyTgt::lfo2Speed, Xg, Yg), sampleRate, samplesPerBeat),
                             P[slot::LFO_2_Slew], n);
            gLfoRaw[1] = 2.0f * gv[1] - 1.0f;
            gLfo2Prev = gv[1];

            gLfoPitch = float[2]();
            gLfoPan = float[2]();

            for (wrap<2> k)
            {
                if (P.at (lfoSlot::sync[k]) > 0)
                {
                    let D = xySum (lfoXyDepth[k], Xg, Yg) + ccSum.at (lfoCcDepth[k]);
                    let s = lfoSwing (gv[k], D, 4.0, P.at (lfoSlot::pitch[k]), P.at (lfoSlot::pan[k]));
                    gLfoPitch[k] = s.pitch;
                    gLfoPan[k] = s.pan;
                    gv[k] *= s.gain;
                }
            }

            globalPitch = bendSmooth + xySum (xyTgt::pitch, Xg, Yg) * 24.0f + ccSumBipolar[ccTgt::pitch] * 24.0f;
            globalPan = xySum (xyTgt::pan, Xg, Yg) + ccSumBipolar[ccTgt::pan];
            pwMod1 = int64 (float64 (xySum (xyTgt::osc1Pulsewidth, Xg, Yg) + ccSum[ccTgt::osc1Pulsewidth]) * two32 + 0.5) & u32;
            pwmRateMod1 = xySum (xyTgt::osc1PwmRate, Xg, Yg) + ccSum[ccTgt::osc1PwmRate];
            pwmDepthMod1 = xySum (xyTgt::osc1PwmDepth, Xg, Yg) + ccSum[ccTgt::osc1PwmDepth];
            pwMod2 = int64 (float64 (xySum (xyTgt::osc2Pulsewidth, Xg, Yg) + ccSum[ccTgt::osc2Pulsewidth]) * two32 + 0.5) & u32;
            pwmRateMod2 = xySum (xyTgt::osc2PwmRate, Xg, Yg) + ccSum[ccTgt::osc2PwmRate];
            pwmDepthMod2 = xySum (xyTgt::osc2PwmDepth, Xg, Yg) + ccSum[ccTgt::osc2PwmDepth];

            let maxPoly = clamp (int (P[slot::Voices]), 1, maxVoices);
            let atMode = int (P[slot::AftertouchMode]);
            let mpe = P[slot::MPE_On] != 0;
            bool any = false;
            var i = 0;

            while (i < numActive)
            {
                if (i >= maxPoly)
                {
                    numActive = i;      // voices beyond max polyphony are cut
                    break;
                }

                let vi = order.at (i);
                let key = voices.at (vi).key;
                var at = atMode == 0 ? 1.0f : (atMode == 1 ? pressureSmooth : perKeyAT.at (key & 0x7f));
                var semisArg = P.at (slot::Tune_C + ((key & 0xff) % 12)) * 0.01f + P[slot::GlobalTranspose] * 12.0f + globalPitch;
                let chan = voices.at (vi).chan;

                if (mpe && chan != 0)
                {
                    if (atMode != 0) at = chPressure.at (chan);
                    semisArg += chBend.at (chan);
                }

                if (numLive > 0)
                {
                    if (noiseLive)
                        voices.at (vi).modNoise = noiseRng.nextSigned();

                    evalMods (vi, n);
                    applyMods();
                    semisArg += modPitch();
                }

                if (renderVoice (voices.at (vi), at, semisArg, X, Y, pos, n))
                {
                    any = true;
                    ++i;
                }
                else
                {
                    removeFromList (vi);
                }
            }

            return any;
        }

        //==============================================================================
        // modulation matrix

        /// The connections that are on, and the knob position of every parameter they reach.
        void prepareMods()
        {
            for (int i = 0; i < numLiveTargets; ++i)
                targetLive.at (liveTargets.at (i)) = false;

            numLive = 0;
            numLiveTargets = 0;
            noiseLive = false;
            lfo3Live = false;
            levelLive = false;
            wanderLive = false;

            for (int k = 0; k < mods::numSlots; ++k)
            {
                let s = int (P.at (mods::connSource.at (k)));
                let t = int (P.at (mods::connTarget.at (k)));
                let a = P.at (mods::connAmount.at (k));
                let via = int (P.at (mods::connVia.at (k)));

                if (s <= 0 || s >= mods::numSources || t <= 0 || t >= mods::numTargets || a == 0)
                    continue;

                let v = (via > 0 && via < mods::numSources) ? via : 0;
                liveSrc.at (numLive) = s;
                liveTgt.at (numLive) = t;
                liveAmt.at (numLive) = a;
                liveVia.at (numLive) = v;
                liveSlot.at (numLive) = k;
                liveHold.at (numLive) = P.at (mods::connHold.at (k)) != 0;
                let slew = P.at (mods::connSlew.at (k));
                liveSlew.at (numLive) = 2.0f * slew * slew;
                liveCurve.at (numLive) = P.at (mods::connCurve.at (k));
                noiseLive = noiseLive || s == mods::src::noise || v == mods::src::noise;
                lfo3Live = lfo3Live || s == mods::src::lfo3 || v == mods::src::lfo3;
                levelLive = levelLive || s == mods::src::voiceLevel || v == mods::src::voiceLevel;
                wanderLive = wanderLive || s == mods::src::wander || v == mods::src::wander;
                ++numLive;

                if (! targetLive.at (t))
                {
                    targetLive.at (t) = true;
                    liveTargets.at (numLiveTargets) = t;
                    ++numLiveTargets;

                    if (mods::targetKind.at (t) == mods::knob)
                    {
                        let base = P.at (mods::targetSlot.at (t));
                        modBase.at (t) = base;
                        modBaseNorm.at (t) = modInvert (t, base);
                    }
                }
            }
        }

        /// A source's value for a voice; for vi = -1 (global targets) the newest voice's.
        float modSource (int s, int vi)
        {
            if (s >= mods::src::macro1 && s <= mods::src::macro4) return P.at (slot::Macro_1 + (s - mods::src::macro1));
            if (s >= mods::src::cc1 && s <= mods::src::cc6)       return ccSmooth.at (s - mods::src::cc1);
            if (s == mods::src::modWheel)                         return wheel;
            if (s == mods::src::x)                                return curX;
            if (s == mods::src::y)                                return curY;
            if (s == mods::src::heldNotes)                        return heldNotes;

            if (vi < 0)
            {
                if (s == mods::src::noise)      return noiseGlobal;
                if (s == mods::src::lfo1)       return gLfoRaw[0];
                if (s == mods::src::lfo2)       return gLfoRaw[1];
                if (s == mods::src::lfo3)       return gLfo3Raw;
                if (s == mods::src::aftertouch) return pressureSmooth;
                if (s == mods::src::bend)       return bendNorm;
                return 0;
            }

            // MPE notes have their own bend, pressure and slide
            let chan = P[slot::MPE_On] != 0 ? voices.at (vi).chan : 0;

            if (s == mods::src::slide)      return chan != 0 ? chSlide.at (chan) : 0.0f;
            if (s == mods::src::bend)       return chan != 0 ? chBend.at (chan) / max (P[slot::MPE_BendRange], 0.01f) : bendNorm;
            if (chan != 0 && s == mods::src::aftertouch) return chPressure.at (chan);

            if (s == mods::src::lfo1)      return voices.at (vi).lfoRaw[0];
            if (s == mods::src::lfo2)      return voices.at (vi).lfoRaw[1];
            if (s == mods::src::modEnv1)   return voices.at (vi).m1Last;
            if (s == mods::src::modEnv2)   return voices.at (vi).m2Last;
            if (s == mods::src::ampEnv)    return voices.at (vi).ampLast;
            if (s == mods::src::filterEnv) return voices.at (vi).fenv[0].L;
            if (s == mods::src::velocity)  return min (voices.at (vi).vel, 1.0f);
            if (s == mods::src::random)    return voices.at (vi).modRand;
            if (s == mods::src::noise)     return voices.at (vi).modNoise;
            if (s == mods::src::key)       return clamp (float ((voices.at (vi).key & 0x7f) - 60) * (1.0f / 60.0f), -1.0f, 1.0f);
            if (s == mods::src::lfo3)      return P[slot::LFO_3_Mode] == 0 ? voices.at (vi).lfo3Raw : gLfo3Raw;
            if (s == mods::src::interval)  return voices.at (vi).interval;
            if (s == mods::src::alternate) return voices.at (vi).alternate;
            if (s == mods::src::cycle)     return voices.at (vi).cycle;
            if (s == mods::src::voiceLevel) return voices.at (vi).level;
            if (s == mods::src::wander)    return voices.at (vi).wanderValue;
            if (s == mods::src::glide)     return voices.at (vi).glideProg < 1.0f ? 1.0f - voices.at (vi).glideProg : 0.0f;

            if (s == mods::src::aftertouch)
                return int (P[slot::AftertouchMode]) == 2 ? perKeyAT.at (voices.at (vi).key & 0x7f) : pressureSmooth;

            return 0;
        }

        /// Live connection i's value for voice vi (-1: none): its source, curved, times its via
        /// source and its amount, before its slew. A connection that holds latches its value once
        /// the note has rendered a block (until then the sources are still the last note's), and
        /// follows it live before that.
        float connValue (int i, int vi)
        {
            let x = modCurve (modSource (liveSrc.at (i), vi), liveCurve.at (i));

            if (! liveHold.at (i) || vi < 0)
            {
                var m = x * liveAmt.at (i);

                if (liveVia.at (i) > 0)
                    m *= modSource (liveVia.at (i), vi);

                return m;
            }

            let k = liveSlot.at (i);
            var held = x;

            if (liveVia.at (i) > 0)
                held *= modSource (liveVia.at (i), vi);

            if (voices.at (vi).latched.at (k))
            {
                held = voices.at (vi).latchVal.at (k);
            }
            else if (voices.at (vi).age > 0)
            {
                voices.at (vi).latchVal.at (k) = held;
                voices.at (vi).latched.at (k) = true;
            }

            return held * liveAmt.at (i);
        }

        /// How far a connection's slew moves towards its value over n samples.
        float slewStep (int i, int n)
        {
            return float (1.0 - exp (-float64 (n) / (float64 (liveSlew.at (i)) * sampleRate)));
        }

        /// Sums the connections into each target for one voice, over its next n samples; or for
        /// voiceIndex -1, into the targets on the whole sound, from the newest voice's sources
        /// (or with MM_Follow, every voice's, weighted by its level), their slews moved on n
        /// samples.
        void evalMods (int voiceIndex, int n)
        {
            for (int i = 0; i < numLiveTargets; ++i)
                modSum.at (liveTargets.at (i)) = 0;

            if (voiceIndex >= 0)
            {
                for (int i = 0; i < numLive; ++i)
                {
                    var m = connValue (i, voiceIndex);

                    if (liveSlew.at (i) > 0)
                    {
                        let k = liveSlot.at (i);

                        if (voices.at (voiceIndex).slewing.at (k))
                        {
                            let y = voices.at (voiceIndex).slewVal.at (k);
                            m = y + (m - y) * slewStep (i, n);
                        }

                        voices.at (voiceIndex).slewVal.at (k) = m;
                        voices.at (voiceIndex).slewing.at (k) = true;
                    }

                    let t = liveTgt.at (i);
                    modSum.at (t) = modSum.at (t) + m;
                }

                return;
            }

            let newest = numActive > 0 ? order.at (0) : -1;
            let byLevel = P[slot::MM_Follow] != 0 && numActive > 1;

            for (int i = 0; i < numLive; ++i)
            {
                var m = 0.0f;
                var weights = 0.0f;

                if (byLevel)
                {
                    for (int j = 0; j < numActive; ++j)
                    {
                        let vj = order.at (j);
                        let w = voices.at (vj).ampLast * voices.at (vj).velGain;
                        m += w * connValue (i, vj);
                        weights += w;
                    }
                }

                if (weights > 1e-9f)
                    m /= weights;
                else
                    m = connValue (i, newest);

                if (liveSlew.at (i) > 0)
                {
                    let k = liveSlot.at (i);
                    let id = liveSrc.at (i) * 1024 + liveTgt.at (i);

                    if (sharedSlewFor.at (k) == id)
                        m = sharedSlew.at (k) + (m - sharedSlew.at (k)) * slewStep (i, n);

                    sharedSlew.at (k) = m;
                    sharedSlewFor.at (k) = id;
                }

                let t = liveTgt.at (i);
                modSum.at (t) = modSum.at (t) + m;
            }
        }

        /// Moves the modulated parameters' knobs (restoreMods puts them back).
        void applyMods()
        {
            for (int i = 0; i < numLiveTargets; ++i)
            {
                let t = liveTargets.at (i);

                if (mods::targetKind.at (t) == mods::knob)
                    P.at (mods::targetSlot.at (t)) = modLookup (t, clamp (modBaseNorm.at (t) + modSum.at (t), 0.0f, 1.0f));
            }
        }

        void restoreMods()
        {
            for (int i = 0; i < numLiveTargets; ++i)
            {
                let t = liveTargets.at (i);

                if (mods::targetKind.at (t) == mods::knob)
                    P.at (mods::targetSlot.at (t)) = modBase.at (t);
            }
        }

        /// The pitch targets' sum, in semitones.
        float modPitch()
        {
            float s = 0;

            for (int i = 0; i < numLiveTargets; ++i)
            {
                let t = liveTargets.at (i);

                if (mods::targetKind.at (t) == mods::pitch)
                    s += modSum.at (t) * mods::targetScale.at (t);
            }

            return s;
        }

        /// A target's knob law: internal value at knob position n (0..1).
        float modLookup (int t, float n)
        {
            let row = mods::targetRow.at (t) * mods::tableSize;
            let x = n * float (mods::tableSize - 1);
            let i = clamp (int (x), 0, mods::tableSize - 2);
            let a = mods::table.at (row + i);
            let b = mods::table.at (row + i + 1);
            return a + (b - a) * (x - float (i));
        }

        /// The inverse: the knob position of an internal value (the laws are monotonic).
        float modInvert (int t, float value)
        {
            let row = mods::targetRow.at (t) * mods::tableSize;
            let last = mods::tableSize - 1;
            let first = mods::table.at (row);
            let end = mods::table.at (row + last);
            let up = end >= first;

            if (up ? value <= first : value >= first) return 0.0f;
            if (up ? value >= end : value <= end)     return 1.0f;

            var lo = 0, hi = last;

            while (hi - lo > 1)
            {
                let mid = (lo + hi) / 2;
                let y = mods::table.at (row + mid);

                if (up ? y <= value : y >= value) lo = mid;
                else                              hi = mid;
            }

            let a = mods::table.at (row + lo);
            let b = mods::table.at (row + lo + 1);
            let f = b != a ? clamp ((value - a) / (b - a), 0.0f, 1.0f) : 0.0f;
            return (float (lo) + f) / float (last);
        }

        /// LFO slew: a one-pole smoothing of the LFO's value, per block (state < 0: not started).
        float slewLfo (float& state, float x, float slew, int n)
        {
            if (slew <= 0)
                return x;

            if (state < 0)
                state = x;

            let tau = 0.002 + 2.0 * float64 (slew * slew);
            state += (x - state) * float (1.0 - exp (-float64 (n) / (tau * sampleRate)));
            return state;
        }

        /// LFO delay and fade-in: 0 for `delay` ms after note-on, then up to 1 over `fade` ms.
        float lfoFade (int age, float delay, float fade)
        {
            let ms = float (float64 (age) * 1000.0 / sampleRate) - delay;

            if (ms <= 0)    return 0.0f;
            if (fade <= 0)  return 1.0f;
            return min (1.0f, ms / fade);
        }

        /// Scales an LFO's outputs by its delay and fade-in (when it has either).
        void fadeLfo (int age, float delay, float fade, float& value, float& pitch, float& pan, float& raw)
        {
            if (delay > 0 || fade > 0)
            {
                let F = lfoFade (age, delay, fade);
                value *= F; pitch *= F; pan *= F; raw *= F;
            }
        }

        /// An LFO's pitch swing (semitones) and pan swing at value v (0..1), with the depth
        /// modulation D: the pitch depth follows it by kPitch octaves per unit, and gain (which
        /// also scales the pan, and which the caller applies to v) by 4.
        struct LfoSwing
        {
            float pitch, pan, gain;
        }

        LfoSwing lfoSwing (float v, float D, float64 kPitch, float pitchKnob, float panKnob)
        {
            var pd = 24.0f * float (pow (float64 (pitchKnob), 4.0));
            var g = 1.0f;
            if (abs (D) > 0.005f) { pd *= float (pow (float64 (octave), kPitch * float64 (D))); g = pow2 (4.0f * D); }

            LfoSwing s;
            s.pitch = (2.0f * v - 1.0f) * pd;
            s.pan = (2.0f * v - 1.0f) * panKnob * g;
            s.gain = g;
            return s;
        }

        void startDrift (Voice& v)
        {
            for (wrap<2 * maxUnison + 1> g)
            {
                v.drift[g].a = driftRng.nextSigned();
                v.drift[g].b = driftRng.nextSigned();
                v.drift[g].phase = 0.5f + 0.5f * driftRng.nextSigned();
                v.drift[g].rate = 1.0f + 0.3f * driftRng.nextSigned();
            }
        }

        /// Moves a voice's drift on n samples.
        void advanceDrift (Voice& v, int n)
        {
            let step = float (n) * P[slot::Drift_Rate] / float (sampleRate);

            for (wrap<2 * maxUnison + 1> g)
            {
                v.drift[g].phase += step * v.drift[g].rate;

                if (v.drift[g].phase >= 1.0f)
                {
                    v.drift[g].phase -= float (int (v.drift[g].phase));
                    v.drift[g].a = v.drift[g].b;
                    v.drift[g].b = driftRng.nextSigned();
                }
            }
        }

        float driftValue (const Voice& v, int g)
        {
            let d = v.drift.at (g);
            let t = d.phase * d.phase * (3.0f - 2.0f * d.phase);
            return d.a + (d.b - d.a) * t;
        }

        /// The pitch factor of one oscillator copy (osc 0/1, unison copy k).
        float driftRatio (const Voice& v, int osc, int k)
        {
            return float (pow (2.0, float64 (driftValue (v, osc * maxUnison + k) * P[slot::Drift_Pitch]) / 1200.0));
        }

        /// Unison random phase: every copy but the first starts anywhere in its cycle.
        void randomUnisonPhases (Voice& v)
        {
            for (int k = 1; k < maxUnison; ++k)
            {
                v.osc1.at (k).phase = int64 ((driftRng.nextSigned() * 0.5f + 0.5f) * float (two32)) & u32;
                v.osc2.at (k).phase = int64 ((driftRng.nextSigned() * 0.5f + 0.5f) * float (two32)) & u32;
            }
        }

        //==============================================================================
        // one voice, one block

        bool renderVoice (Voice& v, float at, float semisArg, float X, float Y, int pos, int n)
        {

            if (! v.active)
                return false;

            if (v.relCount >= 0)
                v.relCount += n;

            // XY depth for this voice (mod env values of the previous block)
            let fxy = meDbProduct (meTgt::xyDepth, v.m1Last, v.m2Last) * ccXyDepth;
            let Xv = clamp (fxy * X, -2.0f, 2.0f);
            let Yv = clamp (fxy * Y, -2.0f, 2.0f);

            // envelope speeds
            let Sa = xySum (xyTgt::ampEnvelopeSpeed, Xv, Yv) + ccSum[ccTgt::ampEnvelopeSpeed];
            let Sf = xySum (xyTgt::filterEnvelopeSpeed, Xv, Yv) + ccSum[ccTgt::filterEnvelopeSpeed];
            let Smd = xySum (xyTgt::modEnvelopeSpeed, Xv, Yv) + ccSum[ccTgt::modEnvelopeSpeed];
            let Sp = xySum (xyTgt::pitchEnvelopeSpeed, Xv, Yv) + ccSum[ccTgt::pitchEnvelopeSpeed];
            let ampSpeed = Sa != 0 ? pow2 (2.0f * Sa) : 1.0f;
            let filterSpeed = Sf != 0 ? pow2 (2.0f * Sf) : 1.0f;
            let modSpeed = Smd != 0 ? pow2 (2.0f * Smd) : 1.0f;
            let pitchSpeed = Sp != 0 ? pow2 (2.0f * Sp) : 1.0f;

            // mod envelopes, velocity, ME depth
            var me1 = v.modEnv1.renderBlock (mod1C, modSpeed, sustainDown, n);
            var me2 = v.modEnv2.renderBlock (mod2C, modSpeed, sustainDown, n);
            me1 *= velScale (v.vel, P[slot::M1_VeloSens]);
            me2 *= velScale (v.vel, P[slot::M2_VeloSens]);
            me1 *= xyLinearProduct (xyTgt::me1Depth, Xv, Yv) * ccMe1Depth;
            me2 *= xyLinearProduct (xyTgt::me2Depth, Xv, Yv) * ccMe2Depth;

            // LFOs: their values (lv), pitch and pan swings, and depth factors
            float[2] lv, lfoPitch, lfoPan, depthF;

            for (wrap<2> k)
            {
                let S = meSum (lfoMeDepth[k], me1, me2) + ccSum.at (lfoCcDepth[k]);
                depthF[k] = abs (S) > 0.001f ? pow2 (3.0f * S) : 1.0f;
            }

            let kPitch = (P[slot::LFO_1_Sync] == 0 && P[slot::LFO_2_Sync] == 0) ? 2.0 : 4.0;

            // in turn: LFO 1 is sped up by LFO 2's last value, LFO 2 by LFO 1's (faded) one
            for (wrap<2> k)
            {
                if (P.at (lfoSlot::sync[k]) == 0)
                {
                    let S = meSum (lfoMeSpeed[k], me1, me2) + ccSum.at (lfoCcSpeed[k]);
                    let speedF = abs (S) > 0.001f ? pow2 (2.0f * S) : 1.0f;
                    let other = k == 0 ? v.lfo2Prev : lv[0];
                    let nk = int ((P.at (lfoSlot::cross[k]) * other * depthF.at (1 - int (k)) * 3.0f + speedF) * float (n) + 0.5f);
                    let xySpeed = k == 0 ? xySum (xyTgt::lfo1Speed, Xv, Yv) : xySum (xyTgt::lfo1Speed, Xv, Yv) + xySum (xyTgt::lfo2Speed, Xv, Yv);
                    lv[k] = slewLfo (v.lfoSlew[k], v.lfo[k].step (tables, rng, P, lfoShape[k], int (k), nk, xySpeed, sampleRate, samplesPerBeat),
                                     P.at (lfoSlot::slew[k]), n);
                    v.lfoRaw[k] = 2.0f * lv[k] - 1.0f;
                    let s = lfoSwing (lv[k], xySum (lfoXyDepth[k], Xv, Yv), kPitch, P.at (lfoSlot::pitch[k]), P.at (lfoSlot::pan[k]));
                    lfoPitch[k] = s.pitch;
                    lfoPan[k] = s.pan;
                    lv[k] *= s.gain;
                }
                else
                {
                    lv[k] = gv[k]; lfoPitch[k] = gLfoPitch[k]; lfoPan[k] = gLfoPan[k];
                    v.lfoRaw[k] = gLfoRaw[k];
                }

                // LFO delay and fade-in, from the voice's note-on (global LFOs too)
                fadeLfo (v.age, P.at (lfoSlot::delay[k]), P.at (lfoSlot::fade[k]), lv[k], lfoPitch[k], lfoPan[k], v.lfoRaw[k]);
            }

            if (lfo3Live)
            {
                let raw = P[slot::LFO_3_Mode] == 0 ? v.lfo3.stepLfo3 (extraRng, P, sampleRate, samplesPerBeat, n) : gLfo3Raw;
                v.lfo3Raw = raw * lfoFade (v.age, P[slot::LFO_3_Delay], P[slot::LFO_3_Fade]);
            }

            if (wanderLive)
            {
                let hz = 0.02 * pow (500.0, float64 (clamp (P[slot::Wander_Rate], 0.0f, 1.0f)));
                v.wander.phase += float (float64 (n) * hz / sampleRate) * v.wander.rate;

                if (v.wander.phase >= 1.0f)
                {
                    v.wander.phase -= float (int (v.wander.phase));
                    v.wander.a = v.wander.b;
                    v.wander.b = extraRng.nextSigned();
                }

                let t = v.wander.phase * v.wander.phase * (3.0f - 2.0f * v.wander.phase);
                v.wanderValue = v.wander.a + (v.wander.b - v.wander.a) * t;
            }

            v.age += n;
            v.lfo2Prev = lv[1];

            // amp envelope
            if (! v.ampEnv.renderAmp (ampC, ampSpeed * v.envSpeed, sustainDown, ampSmooth, bufE, n))
            {
                v.active = false;
                return false;
            }

            v.ampLast = bufE.at (n - 1);

            if (numLive > 0 && targetLive.at (mods::tgt::volume))
            {
                let step = (max (0.0f, 1.0f + modSum.at (mods::tgt::volume)) - v.modGain) / float (n);

                for (int i = 0; i < n; ++i)
                {
                    v.modGain += step;
                    bufE.at (i) *= v.modGain;
                }
            }
            else
            {
                v.modGain = 1.0f;
            }

            // pitch envelope
            var penvRatio = 1.0f;

            if (P[slot::PEnv_On] != 0)
            {
                advancePitchEnv (v.penvR, v.penvStage, penvC, float64 (n) * float64 (pitchSpeed * v.envSpeed), float64 (srInt));
                let R = float64 (v.penvR);
                let vs = float64 (P[slot::PEnv_VeloSens]);

                if (vs > 0.001)       penvRatio = float (pow (R, 1.0 + (float64 (v.vel) - 1.0) * vs));
                else if (vs < -0.001) penvRatio = float (pow (R, 1.0 + float64 (v.vel) * vs));
                else                  penvRatio = float (R);
            }

            // per-voice modulation sums
            let U = clamp (int (P[slot::U_Voices]), 1, maxUnison);
            let uniNorm = U > 1 ? float (sqrt (1.0 / float64 (U))) : 1.0f;
            var amp1 = uniNorm, amp2 = uniNorm, ampN = 1.0f;
            float pitch1 = 0, pitch2 = 0, pitchN = 0;
            var pw1 = 0i64, pw2 = 0i64;
            float pwmRate1 = 0, pwmRate2 = 0, pwmDepth1 = 0, pwmDepth2 = 0;
            float noiseResMod = 0, resMod = 0, mixMod = 0, cutSemis1 = 0, cutSemis2 = 0, panOffset = 0;
            var D = P[slot::U_Detune];
            var spread = P[slot::U_Spread];

            for (int k = 0; k < 8; ++k)
            {
                let isME2 = k >= 4;
                let t = meTarget (k >> 2, k & 3);
                let d = meDepth (k >> 2, k & 3);
                let me = isME2 ? me2 : me1;
                let sus = isME2 ? P[slot::M2_Sustain] : P[slot::M1_Sustain];

                if (t == meTgt::none) continue;

                if (t == meTgt::cutoff1)                 cutSemis1 += (me - sus) * d * 48.0f;
                else if (t == meTgt::cutoff2)            cutSemis2 += (me - sus) * d * 48.0f;
                else if (t == meTgt::cutoff1Unipolar)    cutSemis1 += me * d * 24.0f;
                else if (t == meTgt::cutoff2Unipolar)    cutSemis2 += me * d * 24.0f;
                else if (t == meTgt::osc1Pitch)          pitch1 += (me - sus) * d * 48.0f;
                else if (t == meTgt::osc2Pitch)          pitch2 += (me - sus) * d * 48.0f;
                else if (t == meTgt::noisePitch)         pitchN += (me - sus) * d * 48.0f;
                else if (t == meTgt::osc1PitchUnipolar)  pitch1 += me * d * 24.0f;
                else if (t == meTgt::osc2PitchUnipolar)  pitch2 += me * d * 24.0f;
                else if (t == meTgt::noisePitchUnipolar) pitchN += me * d * 24.0f;
                else if (t == meTgt::osc1Amp)            amp1 *= dbFactor (me, d);
                else if (t == meTgt::osc2Amp)            amp2 *= dbFactor (me, d);
                else if (t == meTgt::noiseAmp)           ampN *= dbFactor (me, d);
                else if (t == meTgt::pan)                panOffset += (me - sus) * d * 2.0f;
                else if (t == meTgt::resonance)          resMod += me * d;
                else if (t == meTgt::noiseResonance)     noiseResMod += me * d;
                else if (t == meTgt::filterMix)          mixMod += me * d;
                else if (t == meTgt::osc1Pulsewidth)     pw1 = (pw1 + int64 (float64 (me * d) * two32 + 0.5)) & u32;
                else if (t == meTgt::osc2Pulsewidth)     pw2 = (pw2 + int64 (float64 (me * d) * two32 + 0.5)) & u32;
                else if (t == meTgt::osc1PwmRate)        pwmRate1 += me * d;
                else if (t == meTgt::osc2PwmRate)        pwmRate2 += me * d;
                else if (t == meTgt::osc1PwmDepth)       pwmDepth1 += me * d;
                else if (t == meTgt::osc2PwmDepth)       pwmDepth2 += me * d;
                else if (t == meTgt::unisonDetune)       D += abs (d) * d * me * 1200.0f;
                else if (t == meTgt::unisonSpread)       spread += me * d;
            }

            for (int k = 0; k < 8; ++k)
            {
                let t = xyTarget (k >> 2, k & 3);
                let d = xyDepth (k >> 2, k & 3);
                let x = k >= 4 ? Yv : Xv;

                if (t == xyTgt::osc1Pitch)           pitch1 += x * d * 24.0f;
                else if (t == xyTgt::osc2Pitch)      pitch2 += x * d * 24.0f;
                else if (t == xyTgt::noisePitch)     pitchN += x * d * 24.0f;
                else if (t == xyTgt::osc1Amp)        amp1 *= float (pow (10.0, 3.0 * float64 (x * d)));
                else if (t == xyTgt::osc2Amp)        amp2 *= float (pow (10.0, 3.0 * float64 (x * d)));
                else if (t == xyTgt::noiseAmp)       ampN *= float (pow (10.0, 3.0 * float64 (x * d)));
                else if (t == xyTgt::filterMix)      mixMod += x * d;
                else if (t == xyTgt::noiseResonance) noiseResMod += x * d;
                else if (t == xyTgt::unisonDetune)   D += abs (d) * d * x * 1200.0f;
                else if (t == xyTgt::unisonSpread)   spread += x * d;
            }

            for (int c = 0; c < 6; ++c)
            {
                let cc = ccSmooth.at (c);

                for (int k = 0; k < 4; ++k)
                {
                    let t = ccTarget (c, k);
                    let d = ccDepth (c, k);

                    if (t == ccTgt::osc1Pitch)           pitch1 += cc * d * 24.0f;
                    else if (t == ccTgt::osc2Pitch)      pitch2 += cc * d * 24.0f;
                    else if (t == ccTgt::noisePitch)     pitchN += cc * d * 24.0f;
                    else if (t == ccTgt::osc1Amp)        amp1 *= dbFactor (cc, d);
                    else if (t == ccTgt::osc2Amp)        amp2 *= dbFactor (cc, d);
                    else if (t == ccTgt::noiseAmp)       ampN *= dbFactor (cc, d);
                    else if (t == ccTgt::filterMix)      mixMod += cc * d;
                    else if (t == ccTgt::noiseResonance) noiseResMod += cc * d;
                    else if (t == ccTgt::unisonDetune)   D += abs (d) * d * cc * 1200.0f;
                    else if (t == ccTgt::unisonSpread)   spread += cc * d;
                }
            }

            spread = clamp (spread, -1.0f, 1.0f);

            // analog drift
            let drift = P[slot::Drift_Pitch] > 0 || P[slot::Drift_Cutoff] > 0;

            if (drift)
            {
                advanceDrift (v, n);
                let dCut = driftValue (v, 2 * maxUnison) * P[slot::Drift_Cutoff];
                cutSemis1 += dCut;
                cutSemis2 += dCut;
            }

            let pitchDrift = P[slot::Drift_Pitch] > 0;

            // unison detune ratios, worked out again only when what they follow changes
            let J = P[slot::U_PitchJitter];
            let dc = P[slot::U_DetuneCurve];

            if (U != v.uniU || D != v.uniD || J != v.uniJ || dc != v.uniCurve || octave != v.uniOct)
            {
                v.uniU = U; v.uniD = D; v.uniJ = J; v.uniCurve = dc; v.uniOct = octave;
                v.updateDetuneRatios (U, D, J, dc, octave);
            }

            // pitch ratios
            let Rg = float (pow (float64 (octave), float64 (lfoPitch[0] * depthF[0] + lfoPitch[1] * depthF[1] + semisArg) / 12.0)) * penvRatio;
            let ap1 = abs (P[slot::O1_Afterpitch]) > 0.01f ? octPow (at * P[slot::O1_Afterpitch]) : 1.0f;
            let ap2 = abs (P[slot::O2_Afterpitch]) > 0.01f ? octPow (at * P[slot::O2_Afterpitch]) : 1.0f;
            let r1 = abs (pitch1) > 0.001f ? octPow (pitch1) : 1.0f;
            let mult1 = r1 * ap1 * Rg;
            let mult2 = ap2 * Rg;

            // glided note frequency (freq > pan, filter keytrack)
            float fG;

            if (v.glideProg < 1.0f)
            {
                v.glideProg = min (1.0f, v.glideProg + float (n) * v.glideInc);
                fG = v.glideF0 + (v.freq - v.glideF0) * v.glideProg;
            }
            else
            {
                v.glideF0 = v.freq;
                v.glideProg = 1.0f;
                fG = v.freq;
            }

            let stereo = U > 1 && (spread != 0 || v.stereoLatch);
            if (stereo) v.stereoLatch = true;
            let noiseOn = P[slot::N_Amp] > 0;

            for (int i = 0; i < n; ++i) { bufM.at (i) = 0; bufR.at (i) = 0; bufNZ.at (i) = 0; }

            // noise
            if (noiseOn)
            {
                let ratioN = octPow (pitchN + P[slot::N_Transpose]);
                let toHzN = float64 (srInt) / two32;
                v.noise.freq = float (float64 (v.osc1[0].base) * toHzN * float64 (ratioN));

                if (v.osc1[0].glideOn)
                    v.noise.glideTo (float (float64 (v.osc1[0].glideTarget) * toHzN * float64 (ratioN)), v.osc1[0].glideRem);

                if (stereo) v.noise.renderNoise (rng, P, Rg, at, ampN, noiseResMod, sampleRate, bufNZ, n);
                else        v.noise.renderNoise (rng, P, Rg, at, ampN, noiseResMod, sampleRate, bufM, n);
            }

            // each oscillator's own envelope, while it's on: its level follows it, at the amp
            // envelope's speed (the oscillator ramps to it across the block)
            if (P[slot::OE1_On] != 0) amp1 *= v.oscEnv[0].renderBlock (oscEnvC[0], ampSpeed * v.envSpeed, sustainDown, n);
            if (P[slot::OE2_On] != 0) amp2 *= v.oscEnv[1].renderBlock (oscEnvC[1], ampSpeed * v.envSpeed, sustainDown, n);

            // oscillator parameters
            let atGain = aftertouchGain (at, P[slot::OscAftertouch]);

            setOscParams (v.osc1[0], int (P[slot::O1_Waveform]), amp1 * P[slot::O1_Amp] * atGain, P[slot::O1_PWM_W],
                          pw1 + pwMod1, pwmDepth1 + pwmDepthMod1 + P[slot::O1_PWM_D], pwmRate1 + pwmRateMod1, P[slot::O1_PWM_R]);
            setOscParams (v.osc2[0], int (P[slot::O2_Waveform]), amp2 * P[slot::O2_Amp] * atGain, P[slot::O2_PWM_W],
                          pw2 + pwMod2, pwmDepth2 + pwmDepthMod2 + P[slot::O2_PWM_D], pwmRate2 + pwmRateMod2, P[slot::O2_PWM_R]);
            v.osc1[0].setNoise (P[slot::O1_Noise], P[slot::O1_NoiseColour], sampleRate);
            v.osc2[0].setNoise (P[slot::O2_Noise], P[slot::O2_NoiseColour], sampleRate);

            // oscillators
            let oscMix = int (P[slot::OscMix]);
            let o2ratio = float64 (float (pow (float64 (octave), float64 (pitch2) / 12.0 + float64 (P[slot::Transpose]))));
            let detune = float64 (P[slot::Detune]);
            let toHz = float64 (srInt) / two32;

            if (oscMix < oscMixMode::pm2to1)
            {
                for (int k = 1; k < U; ++k)
                    v.osc1.at (k).copyShared (v.osc1[0]);

                renderOsc (v.osc1[0], setUser1, oscMix, false, mult1 * v.ratio[0] * (pitchDrift ? driftRatio (v, 0, 0) : 1.0f), bufM, n);
                followOsc1 (v, o2ratio, detune, toHz);

                for (int k = 1; k < U; ++k)
                    v.osc2.at (k).copyShared (v.osc2[0]);

                renderOsc (v.osc2[0], setUser2, oscMix, true, mult2 * v.ratio[0] * (pitchDrift ? driftRatio (v, 1, 0) : 1.0f), bufM, n);

                for (int k = 1; k < U; ++k)
                {
                    var m1 = oscMix == oscMixMode::normal ? mult1 * v.ratio.at (k) : mult1;
                    var m2 = oscMix == oscMixMode::normal ? mult2 * v.ratio.at (k) : mult2;

                    if (pitchDrift)
                    {
                        m1 *= driftRatio (v, 0, k);
                        m2 *= driftRatio (v, 1, k);
                    }

                    // the oscillators only add into the buffer: mono copies go straight to bufM
                    if (stereo)
                    {
                        bufV.at (k) = float[blockSize]();
                        renderUnisonCopy (v, k, oscMix, m1, m2, o2ratio, detune, toHz, bufV.at (k), n);
                    }
                    else
                    {
                        renderUnisonCopy (v, k, oscMix, m1, m2, o2ratio, detune, toHz, bufM, n);
                    }
                }
            }
            else
            {
                renderOscPair (v, oscMix, U, stereo, mult1, mult2, o2ratio, detune, toHz, pitchDrift, n);
            }

            // pan
            var p = v.basePan + freqPanOffset (Rg * fG);
            p += lfoPan[0] * depthF[0] + lfoPan[1] * depthF[1] + globalPan + panOffset;
            if (numLive > 0 && targetLive.at (mods::tgt::pan)) p += 0.5f * modSum.at (mods::tgt::pan);
            p = clamp (p, 0.0f, 1.0f);
            let pg = panGains (p);
            let stepL = (pg[0] - v.panL) / float (n);
            let stepR = (pg[1] - v.panR) / float (n);

            if (stereo)
            {
                if (! noiseOn) { v.panL = pg[0]; v.panR = pg[1]; }

                let W = min (p, 1.0f - p) * spread;
                let pj = P[slot::U_PanJitter];
                float[maxUnison] pans;

                for (int k = 0; k < U; ++k)
                    pans.at (k) = ((float (k) * (2.0f / float (U - 1)) - 1.0f) * (1.0f - pj) + pj * v.panr.at (k)) * W + p;

                let mid = U >> 1;
                let t0 = pans[0];
                pans[0] = pans.at (mid);
                pans.at (mid) = t0;

                for (int k = 0; k < U; ++k)
                {
                    let gk = panGains (pans.at (k));
                    let sL = (gk[0] - v.uniL.at (k)) / float (n);
                    let sR = (gk[1] - v.uniR.at (k)) / float (n);
                    var uL = v.uniL.at (k), uR = v.uniR.at (k);

                    for (int i = 0; i < n; ++i)
                    {
                        uL += sL;
                        uR += sR;

                        if (k == 0)
                        {
                            bufR.at (i) = uR * bufM.at (i);
                            bufM.at (i) = uL * bufM.at (i);
                        }
                        else
                        {
                            let s = bufV.at (k).at (i);
                            bufM.at (i) += uL * s;
                            bufR.at (i) += uR * s;
                        }
                    }

                    v.uniL.at (k) = uL;
                    v.uniR.at (k) = uR;
                }

                if (noiseOn)
                {
                    for (int i = 0; i < n; ++i)
                    {
                        v.panL += stepL;
                        v.panR += stepR;
                        bufM.at (i) += v.panL * bufNZ.at (i);
                        bufR.at (i) += v.panR * bufNZ.at (i);
                    }
                }
            }

            // velocity gain target
            v.velGainTarget = velAmpScale (v.vel) * v.randAmp;
            let smoothGain = abs (v.velGainTarget - v.velGain) > 1e-5f;
            if (! smoothGain) v.velGain = v.velGainTarget;

            // unison width: the stereo voice's side signal, scaled
            let width = P[slot::U_Width];
            let widen = stereo && width != 1.0f;

            // distortion / filter / output
            let distOn = P[slot::Sat_Type] != 0;
            let distMode = int (P[slot::Sat_Mode]);
            let distMod = xySum (xyTgt::distortion, Xv, Yv) + ccSum[ccTgt::distortion];

            if (distOn && (distMode == satMode::beforeFilter || distMode == satMode::both))
                gainAndDistort (v, smoothGain, stereo, distMod, n);

            // filter mix ramp, shared by both channels
            let mm = clamp (mixMod, -1.0f, 1.0f);
            let fmix = P[slot::F_Mix];
            let M = mm > 0 ? fmix + (1.0f - fmix) * mm : fmix * (1.0f + mm);
            let dm = (M - v.mix) / float (n);

            for (int i = 0; i < n; ++i)
            {
                v.mix += dm;
                bufMix.at (i) = v.mix;
            }

            filterChannel (v, false, v.vel, at, fG, Rg, Xv, Yv, lv[0] * depthF[0], lv[1] * depthF[1],
                           cutSemis1, cutSemis2, resMod, filterSpeed * v.envSpeed, bufM, n);

            if (stereo)
                filterChannel (v, true, v.vel, at, fG, Rg, Xv, Yv, lv[0] * depthF[0], lv[1] * depthF[1],
                               cutSemis1, cutSemis2, resMod, filterSpeed * v.envSpeed, bufR, n);

            if (distOn && distMode == satMode::afterFilter)
                gainAndDistort (v, smoothGain, stereo, distMod, n);

            // a per-voice distortion has had the gain already; with the envelope below 1/16 its
            // output is scaled by 16 * envelope, so that it still fades out
            let voiceDist = distOn && distMode != satMode::global;

            if (! voiceDist)
                applyVelocityGain (v, smoothGain, stereo, n);

            // the key EQ, on the note's harmonics
            if (P[slot::KEQ_On] != 0)
            {
                for (int k = 0; k < keyEqBands; ++k)
                    v.keq.setKeyEqBand (k, P.at (slot::KEQ_1_Gain + k), fG * float (1 << k), float (sampleRate));

                v.keq.processKeyEq (false, bufM, n);
                if (stereo) v.keq.processKeyEq (true, bufR, n);
            }

            for (int i = 0; i < n; ++i)
            {
                if (voiceDist)
                {
                    let e = bufE.at (i);

                    if (e < 0.0625f)
                    {
                        bufM.at (i) = e * bufM.at (i) * 16.0f;
                        bufR.at (i) = e * bufR.at (i) * 16.0f;
                    }
                }

                if (stereo)
                {
                    mix.at (pos + i) += widen ? stereoWidth (bufM.at (i), bufR.at (i), width) : float<2> (bufM.at (i), bufR.at (i));
                }
                else
                {
                    v.panL += stepL;
                    v.panR += stepR;
                    mix.at (pos + i) += float<2> (bufM.at (i) * v.panL, bufM.at (i) * v.panR);
                }
            }

            if (levelLive)
            {
                var sum = 0.0f;

                for (int i = 0; i < n; ++i)
                    sum += abs (bufM.at (i)) + (stereo ? abs (bufR.at (i)) : 0.0f);

                let size = sum / float (stereo ? 2 * n : n);
                let tau = size > v.levelFollow ? 0.005 : 0.08;
                v.levelFollow += (size - v.levelFollow) * float (1.0 - exp (-float64 (n) / (tau * sampleRate)));
                let db = 20.0f * float (log10 (float64 (max (v.levelFollow * 1.41421356f, 1e-6f))));
                v.level = clamp ((db + 60.0f) * (1.0f / 60.0f), 0.0f, 1.0f);
            }

            v.m1Last = me1;
            v.m2Last = me2;
            return true;
        }

        /// The amp envelope (bufE) times the velocity gain, which eases towards its target when
        /// `smooth`, applied to bufM (and bufR in stereo).
        void applyVelocityGain (Voice& v, bool smooth, bool stereo, int n)
        {
            for (int i = 0; i < n; ++i)
            {
                if (smooth) v.velGain = 0.002f * v.velGainTarget + 0.998f * v.velGain;
                let g = v.velGain * bufE.at (i);
                bufM.at (i) *= g;
                if (stereo) bufR.at (i) *= g;
            }
        }

        /// The velocity gain, then the voice's distortion (bufM, and bufR in stereo).
        void gainAndDistort (Voice& v, bool smoothGain, bool stereo, float distMod, int n)
        {
            applyVelocityGain (v, smoothGain, stereo, n);
            v.dist[0].processMono (distTables, shaperTables[0], P, distMod, sampleRate, bufM, n);
            if (stereo) v.dist[1].processMono (distTables, shaperTables[0], P, distMod, sampleRate, bufR, n);
        }

        float<2> stereoWidth (float l, float r, float w)
        {
            let m = 0.5f * (l + r);
            let d = 0.5f * w * (l - r);
            return float<2> (m + d, m - d);
        }

        void setOscParams (Osc& o, int waveform, float ampTarget, float pwFraction, int64 pwAdd, float depthSum, float rateMod, float baseRate)
        {
            o.waveform = waveform;
            o.ampTarget = ampTarget;

            if (isPulse (waveform))
            {
                o.pw = ((int64 (float64 (pwFraction) * two32 + 0.5) & u32) + pwAdd) & u32;
                o.pwmDepth = depthSum * 0.5f;
                let rate = rateMod > 0 ? baseRate + (16.0f - baseRate) * rateMod : (rateMod + 1.0f) * baseRate;
                o.pwmInc = int64 (float64 (rate) * two32 / float64 (srInt) + 0.5) & u32;
            }
        }

        /// Porridge's osc mix modes (3 PM 2 > 1, 4 PM 1 feedback, 5 ring, 6 AM): for each unison
        /// copy, osc 2 first, then osc 1 shaped by it. In PM 2 > 1, ring and AM osc 2 is silent
        /// and its level sets the depth. Copies go to bufM, or with stereo unison copies 1..
        /// to bufV.
        void renderOscPair (Voice& v, int mode, int U, bool stereo, float mult1, float mult2, float64 o2ratio,
                            float64 detune, float64 toHz, bool pitchDrift, int n)
        {
            followOsc1 (v, o2ratio, detune, toHz);

            for (int k = 1; k < U; ++k)
            {
                v.osc1.at (k).copyShared (v.osc1[0]);
                v.osc2.at (k).copyShared (v.osc2[0]);
            }

            let feedback = P[slot::PM_Feedback];

            for (int k = 0; k < U; ++k)
            {
                var m1 = mult1 * v.ratio.at (k);
                var m2 = mult2 * v.ratio.at (k);

                if (pitchDrift)
                {
                    m1 *= driftRatio (v, 0, k);
                    m2 *= driftRatio (v, 1, k);
                }

                if (k > 0)
                    v.osc2.at (k).base = osc2Inc (v.osc1.at (k).base, o2ratio, detune, toHz);

                if (stereo && k > 0)
                {
                    bufV.at (k) = float[blockSize]();
                    renderPairCopy (v, k, mode, m1, m2, feedback, bufV.at (k), n);
                }
                else
                {
                    renderPairCopy (v, k, mode, m1, m2, feedback, bufM, n);
                }
            }
        }

        /// One unison copy of an osc mix mode pair, added into buf. In PM 2 > 1, ring and AM, osc 2
        /// is heard too at O2_PairMix of its level (which is also the depth).
        void renderPairCopy (Voice& v, int k, int mode, float m1, float m2, float feedback, float[blockSize]& buf, int n)
        {
            if (mode == oscMixMode::pmFeedback)
            {
                v.osc2.at (k).renderPlain (tables, setUser2, m2, buf, n);
            }
            else
            {
                v.osc2.at (k).renderRaw (tables, setUser2, m2, bufX, bufMod, n);
                let heard = P[slot::O2_PairMix];

                if (heard > 0)
                    for (int i = 0; i < n; ++i)
                        buf.at (i) += heard * bufX.at (i) * bufMod.at (i);
            }

            v.osc1.at (k).renderShaped (tables, setUser1, m1, buf, bufX, bufMod, mode, feedback, n);
        }

        /// One unison copy (k > 0) of the normal, sync and FM modes, added into buf.
        void renderUnisonCopy (Voice& v, int k, int oscMix, float m1, float m2, float64 o2ratio, float64 detune, float64 toHz,
                               float[blockSize]& buf, int n)
        {
            renderOsc (v.osc1.at (k), setUser1, oscMix, false, m1, buf, n);
            v.osc2.at (k).base = osc2Inc (v.osc1.at (k).base, o2ratio, detune, toHz);
            renderOsc (v.osc2.at (k), setUser2, oscMix, true, m2, buf, n);
        }

        /// Osc 2's phase increment for osc 1's: o2ratio times the frequency, plus detune Hz.
        int64 osc2Inc (int64 inc1, float64 o2ratio, float64 detune, float64 toHz)
        {
            return int64 ((float64 (inc1) * toHz * o2ratio + detune) / toHz + 0.5) & u32;
        }

        /// Osc 2 (copy 0) follows osc 1's pitch, and its glide.
        void followOsc1 (Voice& v, float64 o2ratio, float64 detune, float64 toHz)
        {
            v.osc2[0].base = osc2Inc (v.osc1[0].base, o2ratio, detune, toHz);

            if (v.osc1[0].glideOn)
                v.osc2[0].glideTo (osc2Inc (v.osc1[0].glideTarget, o2ratio, detune, toHz), v.osc1[0].glideRem);
            else
                v.osc2[0].glideOn = false;
        }

        void renderOsc (Osc& o, int userSet, int oscMix, bool isOsc2, float mult, float[blockSize]& buf, int n)
        {
            if (oscMix == oscMixMode::sync)    o.renderSync (tables, userSet, mult, buf, isOsc2, syncBuf, n);
            else if (oscMix == oscMixMode::fm) o.renderFM (tables, userSet, mult, buf, isOsc2, fmBuf, fmCoefs, n);
            else                  o.renderPlain (tables, userSet, mult, buf, n);
        }

        //==============================================================================
        // filters for one channel: filter 1, and filter 2 when doubling is on

        /// The zero-delay-feedback types reach 20 kHz at the top of the cutoff knob instead of 11 kHz.
        float cutoffHz (bool isF2, bool zdf, float envIn, float vel, float at, float keyFreq, float Rg, float X, float Y,
                        float lfo1, float lfo2, float semisMod)
        {
            let env = envIn * velScale (vel, P[slot::F_VeloSens]);
            let c = float64 (P[slot::Cutoff]);
            var hz = float (c * c * c * (zdf ? 19980.0 : 10980.0) + 20.0);
            let ft = P[slot::F_Aftertouch];
            if (abs (ft) > 1e-4f) hz = float (float64 (hz) * pow (float64 (octave), float64 (at * ft) / 12.0));

            let kt = P[slot::F_Track];

            if (abs (kt) > 1e-6f)
            {
                let rel = float64 (keyFreq) / float64 (P[slot::Tune_Main]) * max (float64 (Rg), 0.0625);
                hz = float (float64 (hz) * exp (float64 (kt) * log (rel) + float64 (P[slot::Tune_CutReference]) * float64 (lnOct) / 12.0));
            }

            var envmod = P[slot::F_EnvMod];
            float cutX = 0, cutY = 0, cutCC = 0;
            let xyCut = isF2 ? xyTgt::cutoff2 : xyTgt::cutoff1;
            let ccCut = isF2 ? ccTgt::cutoff2 : ccTgt::cutoff1;

            for (int k = 0; k < 4; ++k)
            {
                let tx = xyTarget (0, k), dx = xyDepth (0, k);
                let ty = xyTarget (1, k), dy = xyDepth (1, k);

                if (tx == xyTgt::filterEnvMod) envmod += X * dx;
                if (tx == xyCut) cutX += dx;
                if (ty == xyTgt::filterEnvMod) envmod += Y * dy;
                if (ty == xyCut) cutY += dy;

                for (int cc = 0; cc < 6; ++cc)
                {
                    let t = ccTarget (cc, k);
                    let d = ccDepth (cc, k);
                    if (t == ccTgt::filterEnvMod) envmod += ccSmooth.at (cc) * d;
                    if (t == ccCut) cutCC += ccSmooth.at (cc) * d;
                }
            }

            envmod = clamp (envmod, -1.0f, 1.0f);
            var oct = isF2 ? (lfo1 * P[slot::LFO_1_Cutoff_2] + lfo2 * P[slot::LFO_2_Cutoff_2] + cutX * X + cutY * Y + cutCC) * 4.0f
                             + 2.0f * P[slot::F_Split]
                           : (lfo1 * P[slot::LFO_1_Cutoff_1] + lfo2 * P[slot::LFO_2_Cutoff_1] + cutX * X + cutY * Y + cutCC) * 4.0f;
            oct += envmod * env * 8.0f;
            hz = float (float64 (hz) * pow (float64 (octave), float64 (oct)));
            if (abs (semisMod) > 1e-4f) hz = float (float64 (hz) * pow (float64 (octave), float64 (semisMod) / 12.0));
            return max (hz, 5.0f);
        }

        float resonance (float X, float Y, float lfo1, float lfo2, float resMod)
        {
            float resX = 0, resY = 0;

            for (int k = 0; k < 4; ++k)
            {
                if (xyTarget (0, k) == xyTgt::resonance) resX += xyDepth (0, k);
                if (xyTarget (1, k) == xyTgt::resonance) resY += xyDepth (1, k);
            }

            let r0 = P[slot::Resonance];
            var res = (lfo1 * P[slot::LFO_1_Resonance] + lfo2 * P[slot::LFO_2_Resonance]) * (1.0f - r0) + r0;
            let mods = float[4] (resX * X, resY * Y, ccRes, resMod);

            for (wrap<4> k)
                res += mods[k] > 0 ? (1.0f - r0) * mods[k] : r0 * mods[k];

            return clamp (res, 0.0f, 1.0f);
        }

        void runFilter (Voice& v, bool right, bool isF2, int type, float vel, float at, float keyFreq, float Rg, float X, float Y,
                        float lfo1, float lfo2, float semisMod, float res, float speed, float[blockSize]& buf, int n)
        {
            let f = (isF2 ? 1 : 0) + (right ? 2 : 0);
            let env = v.fenv.at (f).renderBlock (fenvCoefs (f), speed, sustainDown, n);
            let hz = cutoffHz (isF2, isZdfFilter (type), env, vel, at, keyFreq, Rg, X, Y, lfo1, lfo2, semisMod);
            let morph = clamp (P[slot::F_Morph] + (morphGlide - morphKnob), 0.0f, 1.0f);
            v.filt.at (f).process (fxTables, type, hz, res, morph, P[slot::F_Drive], sampleRate, buf, n);
        }

        void filterChannel (Voice& v, bool right, float vel, float at, float keyFreq, float Rg, float X, float Y,
                            float lfo1, float lfo2, float cutSemis1, float cutSemis2, float resMod, float envSpeed,
                            float[blockSize]& buf, int n)
        {
            let t1 = int (P[slot::Filter]);
            let t2raw = int (P[slot::Filter2]);
            let t2 = t2raw != 0 ? t2raw : t1;
            let dbl = int (P[slot::F_Double]);
            let speed = max (envSpeed, 0.01f);
            let res = resonance (X, Y, lfo1, lfo2, resMod);

            if (dbl == 0)
            {
                if (t1 != 0)
                    runFilter (v, right, false, t1, vel, at, keyFreq, Rg, X, Y, lfo1, lfo2, cutSemis1, res, speed, buf, n);

                return;
            }

            // buf: filter 1's output (a); bufX: the input, then filter 2's output (b)
            bufX = buf;

            if (t1 != 0)
                runFilter (v, right, false, t1, vel, at, keyFreq, Rg, X, Y, lfo1, lfo2, cutSemis1, res, speed, buf, n);

            if (dbl == 1)
            {
                if (t2 != 0)
                    runFilter (v, right, true, t2, vel, at, keyFreq, Rg, X, Y, lfo1, lfo2, cutSemis2, res, speed, bufX, n);

                for (int i = 0; i < n; ++i)
                    buf.at (i) = (1.0f - bufMix.at (i)) * buf.at (i) + bufMix.at (i) * bufX.at (i);
            }
            else
            {
                for (int i = 0; i < n; ++i)
                    buf.at (i) = buf.at (i) + 8.0f * max (bufMix.at (i) - 0.5f, 0.0f) * bufX.at (i);

                bufX = buf;

                if (t2 != 0)
                    runFilter (v, right, true, t2, vel, at, keyFreq, Rg, X, Y, lfo1, lfo2, cutSemis2, res, speed, bufX, n);

                for (int i = 0; i < n; ++i)
                    buf.at (i) = bufX.at (i) + 8.0f * max (0.5f - bufMix.at (i), 0.0f) * buf.at (i);
            }
        }

        //==============================================================================
        void renderBlock()
        {
            if (panicPending)
            {
                panicPending = false;
                allNotesOff();
                resetEffects();
            }

            computeDerived();
            ccReported = bool[128]();

            for (wrap<blockSize> i)
                mix[i] = float<2>();

            var active = false;

            if (P[slot::Oat_Mode] != 0)
            {
                // Oatmeal: everything that arrived during the last block, at its start
                handleMidi (midiCount);
                active = renderPiece (0, blockSize);
                arpTick();
            }
            else
            {
                // every message on its own sample, one block late: the messages from
                // [now - blockSize, now) fall on this block's samples in the same places
                let start = now - blockSize;
                var due = 0;

                while (due < midiCount && midiTime.at (due) < now)
                    ++due;

                var pos = 0;

                while (pos < blockSize)
                {
                    var k = 0;

                    while (k < due && int (midiTime.at (midiHead + k) - start) <= pos)
                        ++k;

                    handleMidi (k);
                    due -= k;

                    if (firstNote && int (P[slot::Arp_Mode]) != 0)
                        arpStart();

                    var end = min (blockSize, pos + arpSamplesToStep());

                    if (due > 0)
                        end = min (end, max (int (midiTime.at (midiHead) - start), pos + 1));

                    let n = end - pos;
                    active = renderPiece (pos, n) || active;

                    if (int (P[slot::Arp_Mode]) != 0)
                        arpAdvance (n);

                    pos = end;
                }

                compactMidi();
            }

            // global targets (effects, output) follow the newest voice's sources
            if (numLive > 0)
            {
                evalMods (-1, blockSize);
                applyMods();
            }

            if (useTestInput)
            {
                mix = testBuf;
                active = anyAbove (mix, 0.0f);
            }

            if (active && P[slot::Sat_Type] != 0)
            {
                useShaper (0);
                let mode = int (P[slot::Sat_Mode]);

                if (mode == satMode::global || mode == satMode::both)
                    globalDist.processStereo (distTables, shaperTables[0], P, xySum (xyTgt::distortion, curX, curY) + ccSum[ccTgt::distortion], sampleRate, mix);
            }

            // the newest note, which the phasers' tracking follows
            if (numActive > 0)
                noteHz = voices.at (order.at (0)).freq;

            // the rack, in the program's order (Oatmeal's: chorus, delay, reverb, EQ); each effect
            // says whether its output still sounds, and the last one's answer gates the output.
            // The slots naming one of Oatmeal's four take them in FX_Order's order.
            let order = clamp (int (P[slot::FX_Order]), 0, fxOrders.size / 4 - 1);
            int[4] firsts;

            for (wrap<4> k)
                firsts[k] = fxOrders.at (order * 4 + k);

            int numFirsts = 0;
            bool[rack::numEntries] ran;     // the copies already run, by their rack values

            for (wrap<rack::slots.size> k)
            {
                let fx = int (P.at (rack::slots[k]));

                if (fx >= 1 && fx <= 4)
                {
                    if (numFirsts < 4)
                    {
                        active = runFirst (firsts.at (numFirsts), active);
                        ++numFirsts;
                    }
                }
                else if (fx >= 5 && fx < rack::numEntries && ! ran.at (fx))
                {
                    ran.at (fx) = true;
                    active = runCopy (fx, active);
                }
            }

            // the compressors' meters, about 90 times a second at 48 kHz
            meterCount = meterCount > 0 ? meterCount - 1 : 7;
            ++blockCount;

            // a convolver's impulse when it changes
            for (wrap<rack::convolveCount> k)
            {
                if (convolvers[k].viewVersion != viewSent[k])
                {
                    viewSent[k] = convolvers[k].viewVersion;
                    impulseViewOut <- ImpulseView (int (k), convolvers[k].viewSeconds, convolvers[k].viewPeaks);
                }
            }

            let outputOn = active;
            let gain = P[slot::Gain];

            // the level meter, before the output gain
            if (levelReadings > 0)
            {
                for (wrap<blockSize> i)
                {
                    let l = outputOn ? kWeight (kWeighting[0], float64 (mix[i][0])) : 0.0;
                    let r = outputOn ? kWeight (kWeighting[1], float64 (mix[i][1])) : 0.0;
                    levelSum += l * l + r * r;
                }

                levelFrames += blockSize;

                if (levelFrames >= 512)
                {
                    levelOut <- float (levelSum / float64 (2 * levelFrames));
                    levelSum = 0;
                    levelFrames = 0;
                    --levelReadings;
                }
            }

            for (wrap<blockSize> i)
                mix[i] = outputOn ? mix[i] * gain : float<2>();

            if (numLive > 0) restoreMods();
        }

        /// One piece of a block: controllers, then the voices over mix[pos .. pos + n).
        bool renderPiece (int pos, int n)
        {
            smoothControllers (n);
            sumCcMods();
            prepareMods();
            useShaper (0);
            let active = renderVoices (pos, n);
            if (numLive > 0) restoreMods();
            return active;
        }

        void main()
        {
            loop
            {
                renderBlock();

                let oat = P[slot::Oat_Mode] != 0;

                for (wrap<blockSize> i)
                {
                    out <- (oat ? lateMix[i] : mix[i]);
                    lateMix[i] = mix[i];
                    testNext[i] = testIn;
                    ++now;
                    advance();
                }

                testBuf = testNext;
            }
        }
    }
}
