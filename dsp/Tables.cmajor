//  Oscillator wavetables and LFO tables.
//
//  A table set holds the waveform at 7 full resolutions (32768 .. 512 samples, plain decimation)
//  followed by band-limited 512- and 256-sample tables that keep fewer and fewer harmonics, so
//  that the oscillator can pick, per block, the table whose harmonics all lie below Nyquist.
//  Every table has one guard sample (t[N] = t[0]) for linear interpolation.
//
//  The HQ saw and triangle (Porridge's) are the same two waveforms without the aliasing:
//  4096-sample tables every half octave, each keeping only the harmonics that stay below
//  Nyquist for the highest note it plays. They follow the four sets in 'sets'.

namespace porridge
{
    let setSize = 163078;

    let tabT0 = 0;          // 32768 + 1
    let tabT1 = 32769;      // 16384 + 1
    let tabT2 = 49154;      //  8192 + 1
    let tabT3 = 57347;      //  4096 + 1
    let tabT4 = 61444;      //  2048 + 1
    let tabT5 = 63493;      //  1024 + 1
    let tabT6 = 64518;      //   512 + 1
    let tabM512 = 65031;    // 127 x (512 + 1): harmonics 0 .. 255 - j
    let tabM256Top = 130182;// 256 + 1: harmonics 0 .. 128
    let tabM256 = 130439;   // 127 x (256 + 1): harmonics 0 .. 127 - j

    let setSaw = 0;
    let setTri = 1;
    let setUser1 = 2;
    let setUser2 = 3;

    let hqLevels = 21;      // 1023 harmonics, then half an octave fewer each level, down to 1
    let hqSize = 4096;
    let hqStride = hqSize + 1;
    let hqHarmonics = 1023;
    let hqBase = setSize * 4;
    let hqSetSize = hqLevels * hqStride;

    struct WaveTables
    {
        float[32769] sine;
        float[setSize * 4 + 2 * hqLevels * hqStride] sets;
        float64[65536] fft;             // scratch: interleaved complex, up to 32768 points
        float64[2 * 1024] spectrum;     // scratch: one-sided spectrum (re, im), up to 1024 bins
        float[32768] source;            // scratch: T0 being built
        float[32769 * 4] lfo;           // LFO sine, saw, square, triangle

        // FFT twiddles, cos and sin (-2 pi m / fftMax) (the inverse's are their conjugates):
        // user waveforms are rebuilt on the audio thread
        float64[fftMax / 2] twCosF, twSinF;
        int[hqLevels] hqHarm;           // hqLevelHarmonics, by level
    }

    let fftMax = 32768;

    /// The twiddles at the largest size. Every smaller power-of-two FFT uses every
    /// (fftMax / len)-th one: its angle 2 pi / len is the same multiple of 2 pi / fftMax
    /// exactly, so the products (and the cos / sin) are bit for bit those it would compute.
    void buildTwiddles (WaveTables& this)
    {
        // the same expression the transform used: (direction * 2 pi) / length
        let angF = -1.0 * twoPi / float64 (fftMax);

        for (int m = 0; m < fftMax / 2; ++m)
        {
            this.twCosF.at (m) = cos (angF * float64 (m));
            this.twSinF.at (m) = sin (angF * float64 (m));
        }
    }

    //==============================================================================
    /// In-place complex FFT of this.fft (interleaved), n a power of two up to fftMax.
    void fftInPlace (WaveTables& this, int n, bool inverse)
    {
        var j = 0;

        for (int i = 1; i < n; ++i)
        {
            var bit = n >> 1;

            while ((j & bit) != 0)
            {
                j ^= bit;
                bit >>= 1;
            }

            j |= bit;

            if (i < j)
            {
                let tr = this.fft.at (2 * i), ti = this.fft.at (2 * i + 1);
                this.fft.at (2 * i) = this.fft.at (2 * j);   this.fft.at (2 * i + 1) = this.fft.at (2 * j + 1);
                this.fft.at (2 * j) = tr;                    this.fft.at (2 * j + 1) = ti;
            }
        }

        for (int len = 2; len <= n; len <<= 1)
        {
            let half = len >> 1;
            let stride = fftMax / len;

            for (int k = 0; k < half; ++k)
            {
                let wr = this.twCosF.at (k * stride);
                let wi = inverse ? -this.twSinF.at (k * stride) : this.twSinF.at (k * stride);

                for (int i = 0; i < n; i += len)
                {
                    let p = 2 * (i + k), q = 2 * (i + k + half);
                    let xr = this.fft.at (q) * wr - this.fft.at (q + 1) * wi;
                    let xi = this.fft.at (q) * wi + this.fft.at (q + 1) * wr;
                    let ur = this.fft.at (p), ui = this.fft.at (p + 1);
                    this.fft.at (p) = ur + xr;      this.fft.at (p + 1) = ui + xi;
                    this.fft.at (q) = ur - xr;      this.fft.at (q + 1) = ui - xi;
                }
            }
        }
    }

    /// One-sided spectrum c[0 .. bins - 1] (c_k = X_k / n) of the n real samples in fft.
    void analyseFft (WaveTables& this, int n, int bins)
    {
        this.fftInPlace (n, false);

        for (int k = 0; k < bins; ++k)
        {
            this.spectrum.at (2 * k)     = this.fft.at (2 * k) / float64 (n);
            this.spectrum.at (2 * k + 1) = this.fft.at (2 * k + 1) / float64 (n);
        }
    }

    /// One-sided spectrum c[0 .. bins - 1] of n samples of 'sets' from 'first' on.
    void analyse (WaveTables& this, int first, int n, int bins)
    {
        for (int i = 0; i < n; ++i)
        {
            this.fft.at (2 * i) = float64 (this.sets.at (first + i));
            this.fft.at (2 * i + 1) = 0;
        }

        this.analyseFft (n, bins);
    }

    /// Writes the real signal c0 + sum_{k=1..kmax} 2 Re(c_k e^{2 pi i k m / n}) (the k == n/2
    /// term once) into 'sets' from 'dst' on, every decimate-th sample, and the guard sample.
    /// (A real signal's c0 is real: its imaginary part is +0.)
    void synthesise (WaveTables& this, int n, int kmax, int dst, int decimate)
    {
        for (int i = 0; i < 2 * n; ++i)
            this.fft.at (i) = 0;

        this.fft.at (0) = this.spectrum.at (0);
        this.fft.at (1) = this.spectrum.at (1);

        for (int k = 1; k <= kmax; ++k)
        {
            let re = this.spectrum.at (2 * k), im = this.spectrum.at (2 * k + 1);
            this.fft.at (2 * k) = re;
            this.fft.at (2 * k + 1) = im;

            if (2 * k != n)
            {
                this.fft.at (2 * (n - k)) = re;
                this.fft.at (2 * (n - k) + 1) = -im;
            }
        }

        this.fftInPlace (n, true);

        let outN = n / decimate;

        for (int i = 0; i < outN; ++i)
            this.sets.at (dst + i) = float (this.fft.at (2 * i * decimate));

        this.sets.at (dst + outN) = this.sets.at (dst);
    }

    /// Builds a whole set from the 32768-point table in 'source'.
    void buildSet (WaveTables& this, int set)
    {
        let base = set * setSize;

        for (int i = 0; i < 32768; ++i) this.sets.at (base + tabT0 + i) = this.source.at (i);
        this.sets.at (base + tabT0 + 32768) = this.source.at (0);

        this.buildLevels (set);
    }

    /// The rest of a set from its 32768-point table T0.
    void buildLevels (WaveTables& this, int set)
    {
        let base = set * setSize;
        let offsets = int[7] (tabT0, tabT1, tabT2, tabT3, tabT4, tabT5, tabT6);

        for (int lvl = 1; lvl < 7; ++lvl)
        {
            let n = 32768 >> lvl;
            let src = base + offsets.at (lvl - 1);
            let dst = base + offsets.at (lvl);

            for (int i = 0; i < n; ++i)
                this.sets.at (dst + i) = this.sets.at (src + 2 * i);

            this.sets.at (dst + n) = this.sets.at (dst);
        }

        this.analyse (base + tabT6, 512, 257);

        for (int j = 0; j < 127; ++j)
            this.synthesise (512, 255 - j, base + tabM512 + j * 513, 1);

        this.synthesise (512, 128, base + tabM256Top, 2);
        this.analyse (base + tabM256Top, 256, 129);

        for (int j = 0; j < 127; ++j)
            this.synthesise (256, 127 - j, base + tabM256 + j * 257, 1);
    }

    /// User waveform (512 points) -> band-limited 32768-point T0 -> set.
    /// The old 512-point Nyquist bin becomes an ordinary bin, doubling harmonic 256 (as in the original).
    void buildUserSet (WaveTables& this, int set, const float[512]& wave)
    {
        for (int i = 0; i < 512; ++i)
        {
            this.fft.at (2 * i) = float64 (wave.at (i));
            this.fft.at (2 * i + 1) = 0;
        }

        this.analyseFft (512, 257);
        this.synthesise (32768, 256, set * setSize + tabT0, 1);
        this.buildLevels (set);
    }

    void buildStatic (WaveTables& this)
    {
        this.buildTwiddles();

        for (int level = 0; level < hqLevels; ++level)
            this.hqHarm.at (level) = hqLevelHarmonics (level);

        for (int i = 0; i < 32768; ++i)
            this.sine.at (i) = float (sin (float64 (piF) * float64 (i) / 16384.0));

        this.sine.at (32768) = 0.0f;

        // saw: a rising square-root curve, not a ramp
        for (int i = 0; i < 32768; ++i)
            this.source.at (i) = float (1.5 * sqrt (float64 (i) / 32768.0) - 1.0);

        this.buildSet (setSaw);

        // triangle: normalised integral of saw(p) - saw(p - 1/2)
        float64 A = 0, B = 0;
        let sawBase = setSaw * setSize + tabT0;

        for (int i = 0; i < 32768; ++i)
        {
            A += float64 (this.sets.at (sawBase + i)) - float64 (this.sets.at (sawBase + ((i - 16384) & 32767)));
            B += A;
            this.source.at (i) = float (A);
        }

        let mean = float (B / 32768.0);
        var M = 1e-12f;

        for (int i = 0; i < 32768; ++i)
        {
            this.source.at (i) = this.source.at (i) - mean;
            M = max (M, abs (this.source.at (i)));
        }

        let inv = 1.0 / float64 (M);

        for (int i = 0; i < 32768; ++i)
            this.source.at (i) = float (float64 (this.source.at (i)) * inv);

        this.buildSet (setTri);
        this.buildHQ (setSaw);
        this.buildHQ (setTri);

        // LFO tables: sine (starts at 0.5 rising), saw, square, triangle, all 0..1
        for (int i = 0; i < 32768; ++i)
        {
            this.lfo.at (i)             = float ((sin (float64 (piF) * float64 (i) / 16384.0) + 1.0) * 0.5);
            this.lfo.at (32769 + i)     = float (float64 (i) / 32768.0);
            this.lfo.at (2 * 32769 + i) = i < 16384 ? 0.0f : 1.0f;
            this.lfo.at (3 * 32769 + i) = i < 16384 ? float (float64 (i) / 16384.0) : float (1.0 - float64 (i - 16384) / 16384.0);
        }

        for (int t = 0; t < 4; ++t)
            this.lfo.at (t * 32769 + 32768) = this.lfo.at (t * 32769);
    }

    /// The harmonics an HQ level keeps.
    int hqLevelHarmonics (int level)
    {
        return max (1, int (float64 (hqHarmonics) * pow (2.0, -0.5 * float64 (level)) + 1e-9));
    }

    /// Builds the HQ tables of a set (saw or triangle) from its 32768-point table.
    void buildHQ (WaveTables& this, int set)
    {
        this.analyse (set * setSize + tabT0, 32768, 1024);

        for (int level = 0; level < hqLevels; ++level)
            this.synthesise (hqSize, this.hqHarm.at (level), hqBase + set * hqSetSize + level * hqStride, 1);
    }

    //==============================================================================
    /// Picks the HQ table of a set for a phase increment: the first level whose top harmonic
    /// stays below Nyquist.
    TableChoice chooseHQ (const WaveTables& this, int set, int64 inc)
    {
        var level = 0;

        while (level < hqLevels - 1 && float64 (this.hqHarm.at (level)) * float64 (max (inc, 1i64)) >= 2147483648.0)
            ++level;

        return TableChoice (hqBase + set * hqSetSize + level * hqStride, 20);
    }

    /// Picks the table for a phase increment (uint32 in an int64). Returns the absolute offset
    /// into 'sets' in .offset and the phase shift in .shift.
    struct TableChoice
    {
        int offset, shift;
    }

    TableChoice chooseTable (int set, int64 inc)
    {
        let base = set * setSize;

        if (inc < (1i64 << 17)) return TableChoice (base + tabT0, 17);
        if (inc < (1i64 << 18)) return TableChoice (base + tabT1, 18);
        if (inc < (1i64 << 19)) return TableChoice (base + tabT2, 19);
        if (inc < (1i64 << 20)) return TableChoice (base + tabT3, 20);
        if (inc < (1i64 << 21)) return TableChoice (base + tabT4, 21);
        if (inc < (1i64 << 22)) return TableChoice (base + tabT5, 22);
        if (inc < (1i64 << 23)) return TableChoice (base + tabT6, 23);

        if (inc < (1i64 << 24))
        {
            var j = int (257.0 - 256.0 / (float64 (inc) * float64 (1.1920929e-07f)));
            j = max (j, 0);
            if (j > 127) return TableChoice (base + tabM256Top, 24);
            if (j == 0)  return TableChoice (base + tabT6, 23);
            return TableChoice (base + tabM512 + (j - 1) * 513, 23);
        }

        if (inc < (1i64 << 25))
            return TableChoice (base + tabM256Top, 24);

        let j = clamp (int (129.0 - 128.0 / (float64 (inc) * float64 (5.9604645e-08f))), 0, 127);
        return j == 0 ? TableChoice (base + tabM256Top, 24) : TableChoice (base + tabM256 + (j - 1) * 257, 24);
    }
}
