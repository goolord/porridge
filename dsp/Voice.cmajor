//  Voice state. A voice holds 16 unison copies of both oscillators, the noise source, four
//  filters (filter 1/2 for left or mono, and for right when unison spreads the voice in
//  stereo), two distortion stages, and its envelopes and per-note LFOs.

namespace porridge
{
    let maxVoices = 32;
    let maxUnison = 16;

    struct Voice
    {
        bool active, stereoLatch;
        int key;                        // MIDI key, plus arp transposition index << 8
        float glideF0, freq, glideProg, glideInc;   // block-rate glide of the note frequency (freq > pan, keytrack)

        Noise noise;
        Osc[maxUnison] osc1, osc2;
        float[maxUnison] jit, panr, ratio, uniL, uniR;

        // what the detune ratios were last worked out from (uniU = 0: never)
        int uniU;
        float uniD, uniJ, uniCurve, uniOct;

        Filter f1L, f2L, f1R, f2R;
        Env fenv1L, fenv2L, fenv1R, fenv2R;
        Distortion distL, distR;

        Env ampEnv, modEnv1, modEnv2;
        LFO lfo1, lfo2;
        float lfo2Prev;

        int relCount;                   // -1 while held, samples since release otherwise
        float vel, randAmp, velGainTarget, velGain;
        float basePan, panL, panR;
        float envSpeed, mix, m1Last, m2Last;
        float penvR;
        int penvStage;

        // modulation matrix sources from the last block, and the volume target's gain
        float lfo1Raw, lfo2Raw, ampLast, modRand, modGain;

        // MPE: the MIDI channel the note came from (0 = the master channel)
        int chan;

        // LFO delay / fade-in: samples since the note started; LFO slew: the smoothed values
        int age;
        float lfo1Slew, lfo2Slew;

        // analog drift: slow random values for each unison copy of both oscillators' pitch
        // (0 .. 31) and the cutoff (32)
        Drift[2 * maxUnison + 1] drift;
    }

    /// A slow random value, -1..1: eases from a to b, then picks a new b.
    struct Drift
    {
        float a, b, phase, rate;
    }

    /// Unison copy m's detune step (1 .. h, h the outermost): linear as in Oatmeal, or bent
    /// towards (m / h)^2 by the detune curve.
    float detuneStep (int m, int h, float curve)
    {
        if (curve <= 0)
            return float (m);

        let x = float (m) / float (h);
        return float (h) * x * (1.0f - curve + curve * x);
    }

    /// The unison copies' pitch ratios: U copies, detune D cents, jitter J, detune curve, in
    /// steps of the octave. Copies alternate down and up from the centre, the outermost last;
    /// with an odd count copy 0 stays in the centre (only jitter moves it). The detune curve
    /// bunches the copies near the centre and keeps the outer ones out (supersaw-style).
    void updateDetuneRatios (Voice& this, int U, float D, float J, float curve, float octave)
    {
        if (U <= 1)
        {
            this.ratio[0] = 1.0f;
            return;
        }

        let odd = (U & 1) != 0;
        let h = U >> 1;
        let inv = 1.0f / (float (h) * 1200.0f);

        if (odd)
            this.ratio[0] = J > 0 ? float (pow (float64 (octave), float64 (J * this.jit[0] * D * (1.0f / 1200.0f)))) : 1.0f;

        for (int k = odd ? 1 : 0; k < U; ++k)
        {
            let m = detuneStep ((k + (odd ? 1 : 2)) >> 1, h, curve);
            let sg = (k & 1) != 0 ? -D : D;
            this.ratio.at (k) = float (pow (float64 (octave), float64 ((float (m) * inv * (1.0f - J) + J * this.jit.at (k)) * sg)));
        }
    }
}
