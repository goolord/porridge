//  Voice state. A voice holds 16 unison copies of both oscillators, the noise source, and its
//  envelopes and per-note LFOs. Its four filters (filter 1/2 for left or mono, and for right
//  when unison spreads the voice in stereo), two distortion stages and voice lane slots are the
//  synth's, by voice (Synth.voiceFilters, voiceDistortions, voiceLanes).

namespace porridge
{
    let maxVoices = 32;
    let maxUnison = 16;

    struct Voice
    {
        bool active, stereoLatch;
        int key;                        // MIDI key, plus arp transposition index << 8
        float glideF0, freq, glideProg, glideInc;   // block-rate glide of the note frequency (freq > pan, keytrack)

        Noise noise;
        Osc[maxUnison] osc1, osc2;
        float[maxUnison] jit, panr, ratio, uniL, uniR;

        // what the detune ratios were last worked out from (uniU = 0: never)
        int uniU;
        float uniD, uniJ, uniCurve, uniOct;

        // the voice's index in the pool, and whether its filters, distortions and lane slots are in
        // use since it started: they live outside the voice (in the synth), so that starting one
        // doesn't clear a quarter of a megabyte, and each is cleared when it's first used
        // (Voice() makes them all unused)
        int index;
        bool[4] filtReady;
        bool[2] distReady;
        bool[laneSlots] laneReady;

        // filter envelopes, by filter (Synth.voiceFilters): [isF2 + 2 right]
        Env[4] fenv;

        Env ampEnv, modEnv1, modEnv2;
        Env[2] oscEnv;                  // the oscillators' own envelopes (OE1_On, OE2_On)
        LFO[2] lfo;
        float lfo2Prev;

        int relCount;                   // -1 while held, samples since release otherwise
        float vel, randAmp, velGainTarget, velGain;
        float basePan, panL, panR;
        float envSpeed, mix, m1Last, m2Last;
        float penvR;
        int penvStage;

        // modulation matrix sources from the last block, and the volume target's gain
        float[2] lfoRaw;
        float ampLast, modRand, modGain;
        float modNoise;                 // the noise source: a new value each block it's used

        // MPE: the MIDI channel the note came from (0 = the master channel)
        int chan;

        // LFO delay / fade-in: samples since the note started; LFO slew: the smoothed values
        int age;
        float[2] lfoSlew;

        // analog drift: slow random values for each unison copy of both oscillators' pitch
        // (0 .. 31) and the cutoff (32)
        Drift[2 * maxUnison + 1] drift;

        KeyEq keq;                      // the key EQ (KEQ_On)

        // modulation matrix: each connection's (by slot) value latched at note-on and whether it
        // has been yet, and its slewed value and whether that has started
        float[mods::numSlots] latchVal, slewVal;
        bool[mods::numSlots] latched, slewing;

        // more sources: LFO 3 (each note) and its value, the interval from the note before,
        // alternate (+-1) and cycle (0..1 over four notes), the voice's level (its follower and
        // the source, 0..1), wander's drift, and its value
        Lfo3 lfo3;
        float lfo3Raw, interval, alternate, cycle, levelFollow, level, wanderValue;
        Drift wander;

        // and later: its place in the chord (-1..1), the gap since the note before (0..1),
        // whether another note was held as it started, and its pitch as it sounds (-1..1, as key)
        float chord, gap, legato, pitchNow;

        // for the view (VoiceView): each envelope's clock (amp, filter, mod 1, mod 2: ms since the
        // note-on, or since the note-off once clockReleased), filter 1's last cutoff, and the
        // knob positions of the first live modulation targets
        float[4] envClock;
        bool clockReleased;
        float viewCutoff;
        float[viewTargets] targetPos;

        // the tail after the amp envelope ends while the voice lane's effects after it still
        // ring: whether it's in one, and for how long
        bool tailing;
        int tailSamples;
    }

    let keyEqBands = 8;

    /// The key EQ's peaking bands (transposed direct form II), on the left (or mono) and right.
    struct KeyEq
    {
        float[keyEqBands] b0, b1, b2, a1, a2;
        float[keyEqBands] l1, l2, r1, r2;
        bool[keyEqBands] live;

        // what each band was last designed from (designed: whether it has been since KeyEq())
        float[keyEqBands] designG, designHz, designRate;
        bool[keyEqBands] designed;
    }

    /// Band k's coefficients for gain g dB at hz: an octave wide (RBJ peaking, Q = sqrt 2), or for
    /// the first, a low shelf (RBJ, slope 1) half an octave under the note, for what lies under
    /// it. A band past 18 kHz sits there and fades out over the next octave. Does nothing when
    /// the band was last designed from the same g, hz and rate.
    void setKeyEqBand (KeyEq& this, int k, float g, float hz, float sampleRate)
    {
        if (this.designed.at (k) && g == this.designG.at (k) && hz == this.designHz.at (k) && sampleRate == this.designRate.at (k))
            return;

        this.designed.at (k) = true;
        this.designG.at (k) = g;
        this.designHz.at (k) = hz;
        this.designRate.at (k) = sampleRate;

        let over = hz > 18000.0f ? float (log (float64 (hz) / 18000.0) / log (2.0)) : 0.0f;
        let gain = g * max (0.0f, 1.0f - over);
        this.live.at (k) = abs (gain) > 0.01f;

        if (! this.live.at (k))
            return;

        let f = min (min (k == 0 ? hz * 0.70710678f : hz, 18000.0f), 0.45f * sampleRate);
        let w = twoPi * float64 (f) / float64 (sampleRate);
        let A = pow (10.0, float64 (gain) / 40.0);
        let c = cos (w);

        if (k == 0)
        {
            let beta = 2.0 * sqrt (A) * sin (w) / sqrt (2.0);
            let s0 = (A + 1.0) + (A - 1.0) * c + beta;
            this.b0.at (k) = float (A * ((A + 1.0) - (A - 1.0) * c + beta) / s0);
            this.b1.at (k) = float (2.0 * A * ((A - 1.0) - (A + 1.0) * c) / s0);
            this.b2.at (k) = float (A * ((A + 1.0) - (A - 1.0) * c - beta) / s0);
            this.a1.at (k) = float (-2.0 * ((A - 1.0) + (A + 1.0) * c) / s0);
            this.a2.at (k) = float (((A + 1.0) + (A - 1.0) * c - beta) / s0);
            return;
        }

        let alpha = sin (w) / (2.0 * sqrt (2.0));
        let a0 = 1.0 + alpha / A;
        this.b0.at (k) = float ((1.0 + alpha * A) / a0);
        this.b1.at (k) = float (-2.0 * c / a0);
        this.b2.at (k) = float ((1.0 - alpha * A) / a0);
        this.a1.at (k) = float (-2.0 * c / a0);
        this.a2.at (k) = float ((1.0 - alpha / A) / a0);
    }

    /// The live bands on buf (the right channel's state with `right`).
    void processKeyEq (KeyEq& this, bool right, float[blockSize]& buf, int n)
    {
        for (int k = 0; k < keyEqBands; ++k)
        {
            if (! this.live.at (k))
                continue;

            let b0 = this.b0.at (k);
            let b1 = this.b1.at (k);
            let b2 = this.b2.at (k);
            let a1 = this.a1.at (k);
            let a2 = this.a2.at (k);
            var s1 = right ? this.r1.at (k) : this.l1.at (k);
            var s2 = right ? this.r2.at (k) : this.l2.at (k);

            for (int i = 0; i < n; ++i)
            {
                let x = buf.at (i);
                let y = b0 * x + s1;
                s1 = b1 * x - a1 * y + s2;
                s2 = b2 * x - a2 * y;
                buf.at (i) = y;
            }

            if (right) { this.r1.at (k) = s1; this.r2.at (k) = s2; }
            else       { this.l1.at (k) = s1; this.l2.at (k) = s2; }
        }
    }

    /// A slow random value, -1..1: eases from a to b, then picks a new b.
    struct Drift
    {
        float a, b, phase, rate;
    }

    /// Unison copy m's detune step (1 .. h, h the outermost): linear as in Oatmeal, or bent
    /// towards (m / h)^2 by the detune curve.
    float detuneStep (int m, int h, float curve)
    {
        if (curve <= 0)
            return float (m);

        let x = float (m) / float (h);
        return float (h) * x * (1.0f - curve + curve * x);
    }

    /// The unison copies' pitch ratios: U copies, detune D cents, jitter J, detune curve, in
    /// steps of the octave. Copies alternate down and up from the centre, the outermost last;
    /// with an odd count copy 0 stays in the centre (only jitter moves it). The detune curve
    /// bunches the copies near the centre and keeps the outer ones out (supersaw-style).
    void updateDetuneRatios (Voice& this, int U, float D, float J, float curve, float octave)
    {
        if (U <= 1)
        {
            this.ratio[0] = 1.0f;
            return;
        }

        let odd = (U & 1) != 0;
        let h = U >> 1;
        let inv = 1.0f / (float (h) * 1200.0f);

        if (odd)
            this.ratio[0] = J > 0 ? float (pow (float64 (octave), float64 (J * this.jit[0] * D * (1.0f / 1200.0f)))) : 1.0f;

        for (int k = odd ? 1 : 0; k < U; ++k)
        {
            let m = detuneStep ((k + (odd ? 1 : 2)) >> 1, h, curve);
            let sg = (k & 1) != 0 ? -D : D;
            this.ratio.at (k) = float (pow (float64 (octave), float64 ((float (m) * inv * (1.0f - J) + J * this.jit.at (k)) * sg)));
        }
    }
}
