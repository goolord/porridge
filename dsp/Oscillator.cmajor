//  Oscillators and noise, following Oatmeal's per-block structure: pitch, amplitude and pulse
//  width are set once per block (64 samples, or shorter where sample-accurate MIDI splits a
//  block) and ramped linearly within it. Phases are 32-bit
//  unsigned integers (a full cycle = 2^32), kept in int64 and masked.

namespace porridge
{
    int64 toS32 (int64 u)
    {
        let m = u & u32;
        return m >= 0x80000000i64 ? m - 0x100000000i64 : m;
    }

    struct Osc
    {
        int waveform;
        float ampTarget, amp;
        bool first;
        int64 phase, offset, base, glideTarget;
        int glideRem;
        int64 step;
        bool glideOn;
        int64 pw, pwCur, pwmPhase, pwmInc;
        float pwmDepth;
        float[32] ring;
        int ringIdx;
        float s1, s2, fx1, fy1;
        float fb1, fb2;                 // PM feedback: the last two outputs

        // the oscillator's noise (O1_Noise, O2_Noise): its pitch moved every sample by lowpassed
        // noise, depth as the deviation's RMS (a fraction of the frequency), the lowpass's
        // coefficient and the gain that keeps the noise's RMS whatever its colour
        float nzDepth, nzCoef, nzGain, nzLp;
        Lcg nz;

        // the oscillator's shape (O1_Morph, O1_MorphTo, O1_PD, osc 2's): how far the wave is
        // crossfaded towards the morph wave (morphWave: PorridgeParams.morphWaves, with
        // morphSet the user wave's table set), and the phase distortion's amount
        float morph, pd;
        int morphWave, morphSet;
        float morphCur;                 // the morph as it ramps to 'morph', sample by sample
        OscShape shp;                   // the shape's block (beginBlock), while it's on
    }

    /// The fields of a new oscillator that don't start at zero (the rest must be zero).
    void initDefaults (Osc& this)
    {
        this.ampTarget = 1.0f;
        this.first = true;
        this.pw = 0x80000000i64;
        this.pwCur = 0x80000000i64;
    }

    /// Voice reset: clears ramps, glide, BLEP ring and FM state (not the pulse width).
    void resetOsc (Osc& this)
    {
        this.amp = 0;
        this.offset = 0;
        this.base = 0;
        this.glideTarget = 0;
        this.glideRem = 0;
        this.step = 0;
        this.glideOn = false;
        this.pwmInc = 0;
        this.ring = float[32]();
        this.ringIdx = 0;
        this.s1 = 0; this.s2 = 0; this.fx1 = 0; this.fy1 = 0;
        this.fb1 = 0; this.fb2 = 0;
        this.first = true;
    }

    void setPhase (Osc& this, Rand& rng, const float[numSlots]& P)
    {
        this.phase = rng.randomPhase (P[slot::OscPhase], P[slot::OscPhaseRand]);
    }

    void setPwmPhase (Osc& this, Rand& rng, const float[numSlots]& P)
    {
        this.pwmPhase = rng.randomPhase (P[slot::PWMPhase], P[slot::PWMPhaseRand]);
    }

    /// Glide the base increment to t over m samples (linear in frequency).
    void glideTo (Osc& this, int64 t, int m)
    {
        this.glideTarget = t;
        let d = float64 (t) - float64 (this.base);

        if (abs (d) > 1000.0)
        {
            let s = d / float64 (max (m, 1));
            this.step = int64 (s > 0 ? s + 0.5 : s - 0.5);

            if (this.step == 0)
                this.step = d > 0 ? 1 : -1;

            this.glideOn = true;
            this.glideRem = int (abs (d / float64 (this.step)) + 0.5);
        }
        else
        {
            this.base = t;
            this.step = 0;
            this.glideRem = 0;
            this.glideOn = false;
        }
    }

    /// Copies what unison slots share with slot 0 (not phase, amp, offset, pulse position, ring, FM state).
    void copyShared (Osc& this, const Osc& src)
    {
        this.waveform = src.waveform;
        this.ampTarget = src.ampTarget;
        this.base = src.base;
        this.glideTarget = src.glideTarget;
        this.glideRem = src.glideRem;
        this.step = src.step;
        this.glideOn = src.glideOn;
        this.pw = src.pw;
        this.pwmDepth = src.pwmDepth;
        this.pwmInc = src.pwmInc;
        this.nzDepth = src.nzDepth;
        this.nzCoef = src.nzCoef;
        this.nzGain = src.nzGain;
        this.morph = src.morph;
        this.pd = src.pd;
        this.morphWave = src.morphWave;
        this.morphSet = src.morphSet;
    }

    /// The oscillator's shape: morph 0..1 towards morphTo (0 sine, 1 saw, 2 square, 3 triangle,
    /// 4 and 5 the user waves, read from user1 and user2), and phase distortion 0..1.
    void setShape (Osc& this, float morph, int morphTo, float pd, int user1, int user2)
    {
        this.morph = clamp (morph, 0.0f, 1.0f);
        this.morphWave = clamp (morphTo, 0, 5);
        this.morphSet = morphTo == 4 ? user1 : user2;
        this.pd = clamp (pd, 0.0f, 1.0f);
    }

    /// The oscillator noise's lowpass coefficient and gain for a colour (see setNoise), the
    /// same for every voice: worked out once, and again only when the colour changes.
    struct NoiseCoefs
    {
        bool valid;
        float colour, coef, gain;
    }

    void update (NoiseCoefs& this, float colour, float64 sampleRate)
    {
        if (this.valid && colour == this.colour)
            return;

        let fc = 50.0 * pow (2.0, 9.0 * float64 (colour));
        let c = 1.0 - exp (-2.0 * pi * min (fc, 0.45 * sampleRate) / sampleRate);
        this.valid = true;
        this.colour = colour;
        this.coef = float (c);
        this.gain = float (sqrt (3.0 * (2.0 - c) / c));
    }

    /// The oscillator's noise for depth 0..1 (deviation up to half the frequency, as RMS, on a
    /// square law) and colour 0..1 (the noise lowpassed at 50 Hz .. 25.6 kHz). coefs: the
    /// colour's, by the sample rate (NoiseCoefs.update), updated here when the noise is on.
    void setNoise (Osc& this, float depth, float colour, NoiseCoefs& coefs, float64 sampleRate)
    {
        this.nzDepth = 0.5f * depth * depth;

        if (this.nzDepth > 0)
        {
            coefs.update (colour, sampleRate);
            this.nzCoef = coefs.coef;
            this.nzGain = coefs.gain;
        }
    }

    /// A phase step with the oscillator's noise on it (as it is without).
    int64 noisyInc (Osc& this, int64 inc)
    {
        if (this.nzDepth <= 0)
            return inc;

        if (this.nz.state == 0)
            this.nz.state = ((this.phase >> 1) | 1) & 0x7fffffff;

        this.nzLp += this.nzCoef * (this.nz.nextSigned() - this.nzLp);
        let f = 1.0 + float64 (this.nzDepth * this.nzGain * this.nzLp);
        return int64 (float64 (inc) * max (f, 0.0)) & u32;
    }

    /// Pulse, user PWM and HQ pulse: the difference of two phases of a waveform.
    bool isPulse (int waveform)     { return waveform == waveType::pulse || waveform == waveType::userPwm || waveform == waveType::pulseHQ; }

    /// A table to read: its offset in 'sets' (-1: the sine table) and phase shift, with the
    /// mask and scale of the phase's fraction.
    struct Tab
    {
        int offset, shift;
        int64 mask;
        float64 fracScale;
    }

    Tab makeTab (int offset, int shift)
    {
        return Tab (offset, shift, (1i64 << shift) - 1, 1.0 / float64 (1i64 << shift));
    }

    float read (const WaveTables& tables, const Tab& t, int64 ph)
    {
        let p = ph & u32;
        let i = int (p >> t.shift);
        let fr = float64 (p & t.mask) * t.fracScale;

        if (t.offset < 0)
            return float ((1.0 - fr) * float64 (tables.sine.at (i)) + fr * float64 (tables.sine.at (i + 1)));

        return float ((1.0 - fr) * float64 (tables.sets.at (t.offset + i)) + fr * float64 (tables.sets.at (t.offset + i + 1)));
    }

    /// A waveform's tables for a phase step t: the brightest that doesn't alias (as the plain
    /// oscillator reads), the next one down, and how far t is from the speed at which the first
    /// became the brightest to the one at which it would alias. Crossfaded by that, they change
    /// smoothly as t does.
    struct TablePair
    {
        Tab a, b;
        float64 mix;
    }

    TablePair waveTables (const WaveTables& tables, int waveform, int userSet, int64 t, bool pair)
    {
        TablePair p;
        let tf = float64 (max (t, 1i64));

        if (waveform == waveType::sine)
        {
            p.a = makeTab (-1, 17);
            p.b = p.a;
        }
        else if (waveform >= waveType::sawHQ)
        {
            // (as chooseHQ, half an octave apart)
            let base = hqBase + (waveform == waveType::triangleHQ ? setTri : setSaw) * hqSetSize;
            var level = 0;

            while (level < hqLevels - 1 && float64 (tables.hqHarm.at (level)) * tf >= 2147483648.0)
                ++level;

            p.a = makeTab (base + level * hqStride, 20);

            if (pair)
            {
                let next = min (level + 1, hqLevels - 1);
                p.b = makeTab (base + next * hqStride, 20);
                let hi = 2147483648.0 / float64 (tables.hqHarm.at (level));
                let lo = level > 0 ? 2147483648.0 / float64 (tables.hqHarm.at (level - 1)) : hi * 0.7071067811865476;
                p.mix = next > level ? clamp (log (tf / lo) / log (hi / lo), 0.0, 1.0) : 0.0;
            }
        }
        else
        {
            // (an octave apart)
            let set = (waveform == waveType::saw || waveform == waveType::pulse) ? setSaw
                        : (waveform == waveType::triangle ? setTri : userSet);
            let c = chooseTable (set, min (t, 0x7fffffffffffi64));
            p.a = makeTab (c.offset, c.shift);

            if (pair)
            {
                let d = chooseTable (set, min (2 * t, 0x7fffffffffffi64));
                p.b = makeTab (d.offset, d.shift);
                let l = log (tf) * 1.4426950408889634;
                p.mix = l - floor (l);
            }
        }

        return p;
    }

    struct OscBlock
    {
        int tableOffset, shift;
        int64 mask;
        float64 fracScale;
        int64 slope;
        float astep;
        bool glideOn, glideUp, pulse, pwmActive;
        int64 pwStep;
        bool shaped;                    // morph or phase distortion is on (Osc.shp, shapedValue)
    }

    /// The shape's block, set by beginBlock while morph or phase distortion is on (and kept in
    /// the oscillator, so that OscBlock, which every block of every oscillator starts afresh,
    /// stays small): the morph's step per sample, its tables, and whether it's the square (two
    /// saws); while the phase is bent, the next tables down for the wave and the morph wave, and
    /// how far to crossfade to them (0 otherwise); the phase distortion's turn of the wave's
    /// phase (pdRot), knee (as a phase) and two slopes, 1 / the phase step, the DC it adds, and
    /// its knees' polyBLAMP sizes.
    struct OscShape
    {
        bool pdOn, morphOn, mSquare;
        float morphStep;
        Tab morphA, morphB, waveB;
        float64 levelMix;
        int64 pdRot;
        float64 pdKnee, pdK1, pdK2, pdInvInc, pdBlamp0, pdBlampK;
        float pdDc;
    }

    OscBlock beginBlock (Osc& this, const WaveTables& tables, int userSet, float mult, int64 extra, int n)
    {
        OscBlock b;

        if (this.step == 0)
        {
            this.glideRem = 0;
            if (this.glideOn) this.base = this.glideTarget;
            this.glideOn = false;
        }

        let tgtOff = int64 ((float64 (mult) - 1.0) * float64 (toS32 (this.base)) + 0.5) & u32;
        let q = toS32 (tgtOff - this.offset) / int64 (n);
        b.slope = (q < 0 ? q + 1 : q) & u32;

        if (this.first)
        {
            this.amp = this.ampTarget;
            this.morphCur = this.morph;
            this.first = false;
        }

        b.astep = (this.ampTarget - this.amp) / float (n);

        let inc = ((this.offset + this.base) & u32) + extra;

        // Phase distortion: the cycle's first part, d of it, plays the first half of the wave
        // (k1 = 0.5 / d times as fast), the rest the second half. d shrinks from 0.5 (none) on a
        // log scale, never below 3 samples' worth, so that the fast half lasts at least 3
        // samples (on high notes it eases off rather than alias). The tables are the ones for
        // up to twice the fast half's speed: its harmonics stay under half of Nyquist there,
        // or joining it to the slow half aliases them (15 dB more on a saw), crossfaded to the
        // next ones down as the speed rises (waveTables), so a sweep doesn't step. So a wave
        // bent hard keeps only a few of its harmonics, and sounds like a bent sine.
        var tinc = inc;
        var pdOn = false;
        float64 pdKnee, pdK1, pdK2;

        if (this.pd > 0)
        {
            let f = float64 (max (inc, 1i64)) / two32;
            let dMin = min (0.5, max (0.01, 3.0 * f));
            let k1 = pow (0.5 / dMin, float64 (this.pd));

            if (k1 > 1.000001)
            {
                let d = 0.5 / k1;
                pdOn = true;
                pdKnee = d * two32;
                pdK1 = k1;
                pdK2 = 0.5 / (1.0 - d);
                tinc = int64 (float64 (inc) * k1 * min (2.0, k1));
            }
        }

        if (! pdOn)
        {
            if (this.waveform == waveType::sine)
            {
                b.tableOffset = -1;
                b.shift = 17;
            }
            else if (this.waveform >= waveType::sawHQ)
            {
                // HQ saw, pulse (two saws) and triangle
                let c = tables.chooseHQ (this.waveform == waveType::triangleHQ ? setTri : setSaw, inc);
                b.tableOffset = c.offset;
                b.shift = c.shift;
            }
            else
            {
                let set = (this.waveform == waveType::saw || this.waveform == waveType::pulse) ? setSaw
                            : (this.waveform == waveType::triangle ? setTri : userSet);
                let c = chooseTable (set, min (inc, 0x7fffffffffffi64));
                b.tableOffset = c.offset;
                b.shift = c.shift;
            }

            b.mask = (1i64 << b.shift) - 1;
            b.fracScale = 1.0 / float64 (1i64 << b.shift);
        }
        else
        {
            // the wave's table, and the next one down
            let w = waveTables (tables, this.waveform, userSet, tinc, true);
            b.tableOffset = w.a.offset;
            b.shift = w.a.shift;
            b.mask = w.a.mask;
            b.fracScale = w.a.fracScale;
            this.shp.waveB = w.b;
            this.shp.levelMix = w.mix;
            this.shp.pdKnee = pdKnee;
            this.shp.pdK1 = pdK1;
            this.shp.pdK2 = pdK2;
        }

        // the morph, ramped from where it was, and its wave's tables, for the same speed
        if (this.morph == 0 && this.morphCur != 0 && abs (this.morphCur) < 1e-6f)
            this.morphCur = 0;

        let morphOn = this.morph > 0 || this.morphCur > 0;
        b.shaped = pdOn || morphOn;

        if (b.shaped)
        {
            this.shp.pdOn = pdOn;
            this.shp.morphOn = morphOn;

            if (! pdOn)
                this.shp.levelMix = 0;
        }

        if (morphOn)
        {
            this.shp.morphStep = (this.morph - this.morphCur) / float (n);
            let mw = this.morphWave == 0 ? waveType::sine
                   : this.morphWave <= 2 ? waveType::sawHQ
                   : this.morphWave == 3 ? waveType::triangleHQ : waveType::user;
            let m = waveTables (tables, mw, this.morphSet, tinc, pdOn);
            this.shp.morphA = m.a;
            this.shp.morphB = m.b;
            this.shp.mSquare = this.morphWave == 2;
        }

        if (this.glideOn)
        {
            if (this.glideRem <= n)
            {
                this.glideRem = 0;
                this.step = 0;
                this.base = this.glideTarget;
                this.glideOn = false;
            }
            else
            {
                this.glideRem -= n;
            }
        }

        b.glideOn = this.glideOn;
        b.glideUp = this.glideTarget > this.base;
        b.pulse = isPulse (this.waveform);

        if (b.pulse)
        {
            if (abs (this.pwmDepth) > 1e-4f)
            {
                b.pwmActive = true;
                this.pwmPhase = (this.pwmPhase + this.pwmInc * n) & u32;
                let s = float64 (tables.sine.at (int (this.pwmPhase >> 17)));
                let tgt = (float64 (this.pw) / two32 + (s + 1.0) * float64 (this.pwmDepth)) * two32;
                var d = tgt - float64 (this.pwCur);
                if (d > 2147483648.0) d -= two32;
                else if (d < -2147483648.0) d += two32;
                d /= float64 (n);
                if (d < 0) d += two32;
                b.pwStep = int64 (d + 0.5) & u32;
            }
            else
            {
                b.pwmActive = false;
                this.pwCur = this.pw;
            }
        }

        if (pdOn)
        {
            // the knees on the wave's peaks where it has them (a sine's are a quarter of a cycle
            // on, a triangle's at 0 and 1/2), where bending the phase kinks it least
            let isTri = this.waveform == waveType::triangle || this.waveform == waveType::triangleHQ;
            this.shp.pdRot = isTri ? 0 : 0x40000000i64;
            let incF = float64 (max (inc, 1i64)) / two32;
            this.shp.pdInvInc = 1.0 / float64 (max (inc, 1i64));

            // what kink is left: the slope's jump at each knee (the wave's slope there, per
            // cycle, times the change in speed), smoothed over the samples either side
            let e = 0x200000i64;
            let s0 = 1024.0 * float64 (this.composite (tables, b, e - this.shp.pdRot) - this.composite (tables, b, -e - this.shp.pdRot));
            let sK = 1024.0 * float64 (this.composite (tables, b, 0x80000000i64 + e - this.shp.pdRot)
                                        - this.composite (tables, b, 0x80000000i64 - e - this.shp.pdRot));
            this.shp.pdBlamp0 = s0 * (this.shp.pdK1 - this.shp.pdK2) * incF / 6.0;
            this.shp.pdBlampK = sK * (this.shp.pdK2 - this.shp.pdK1) * incF / 6.0;

            // the DC it adds: the wave's first half (of the bent phase) takes d of the cycle,
            // its second 1 - d: (d - 1/2) (first half's mean - second's), from 8 points (which
            // leave under 0.5 % of the peak)
            var halves = 0.0;

            for (int j = 0; j < 8; ++j)
            {
                let y = float64 (this.composite (tables, b, (int64 (2 * j + 1) << 28) - this.shp.pdRot));
                halves += j < 4 ? y : -y;
            }

            this.shp.pdDc = float ((0.5 / this.shp.pdK1 - 0.5) * halves / 4.0);
        }

        return b;
    }

    float lookup (const WaveTables& tables, const OscBlock& b, int64 ph)
    {
        let p = ph & u32;
        let i = int (p >> b.shift);
        let fr = float64 (p & b.mask) * b.fracScale;

        if (b.tableOffset < 0)
            return float ((1.0 - fr) * float64 (tables.sine.at (i)) + fr * float64 (tables.sine.at (i + 1)));

        return float ((1.0 - fr) * float64 (tables.sets.at (b.tableOffset + i)) + fr * float64 (tables.sets.at (b.tableOffset + i + 1)));
    }

    /// The morph wave at phase p from table t.
    float morphValue (const WaveTables& tables, bool square, const Tab& t, int64 p)
    {
        let z = read (tables, t, p);
        return square ? z - read (tables, t, p + 0x80000000i64) : z;
    }

    /// The wave at phase p with its morph, before any phase distortion (the pulse's second
    /// phase and the square's follow p, so a distorted pulse keeps its width); while the phase
    /// is bent, crossfaded towards the next tables down.
    float composite (const Osc& this, const WaveTables& tables, const OscBlock& b, int64 p)
    {
        var y = lookup (tables, b, p);

        if (b.pulse)
            y -= lookup (tables, b, p + this.pwCur);

        if (this.shp.levelMix > 0)
        {
            var y2 = read (tables, this.shp.waveB, p);

            if (b.pulse)
                y2 -= read (tables, this.shp.waveB, p + this.pwCur);

            y = float (float64 (y) + this.shp.levelMix * float64 (y2 - y));
        }

        if (this.shp.morphOn)
        {
            var z = morphValue (tables, this.shp.mSquare, this.shp.morphA, p);

            if (this.shp.levelMix > 0)
                z = float (float64 (z) + this.shp.levelMix * float64 (morphValue (tables, this.shp.mSquare, this.shp.morphB, p) - z));

            y = float (float64 (y) + float64 (this.morphCur) * float64 (z - y));
        }

        return y;
    }

    /// The wave with its morph and phase distortion. The distortion's phase is the wave's
    /// turned by pdRot: its first part, up to the knee, plays the first half of the wave, the
    /// rest the second; then the DC that adds comes off, and the kinks at the knees (0 and
    /// pdKnee) are smoothed with a polyBLAMP over the sample either side.
    float shapedValue (const Osc& this, const WaveTables& tables, const OscBlock& b, int64 ph)
    {
        if (! this.shp.pdOn)
            return this.composite (tables, b, ph);

        let p = float64 ((ph + this.shp.pdRot) & u32);
        let w = p < this.shp.pdKnee ? p * this.shp.pdK1 : 2147483648.0 + (p - this.shp.pdKnee) * this.shp.pdK2;
        var y = float64 (this.composite (tables, b, int64 (w) - this.shp.pdRot) - this.shp.pdDc);

        let t0 = abs ((p >= 2147483648.0 ? p - two32 : p) * this.shp.pdInvInc);

        if (t0 < 1.0)
        {
            let a = 1.0 - t0;
            y += this.shp.pdBlamp0 * a * a * a;
        }

        let tK = abs ((p - this.shp.pdKnee) * this.shp.pdInvInc);

        if (tK < 1.0)
        {
            let a = 1.0 - tK;
            y += this.shp.pdBlampK * a * a * a;
        }

        return float (y);
    }

    /// Per-sample updates shared by all oscillator variants: amp ramp, pulse width ramp, glide.
    float tickShared (Osc& this, const OscBlock& b)
    {
        let a = float64 (this.amp) + float64 (b.astep);
        this.amp = float (a);

        if (b.pulse && b.pwmActive)
            this.pwCur = (this.pwCur + b.pwStep) & u32;

        if (b.glideOn)
        {
            var b2 = (this.base + this.step) & u32;

            if (b.glideUp ? b2 > this.glideTarget : b2 < this.glideTarget)
            {
                b2 = this.glideTarget;
                this.step = 0;
                this.glideRem = 0;
                this.glideOn = false;
            }

            this.base = b2;
        }

        return float (a);
    }

    /// The shape's per-sample update, for the renderers that read waveValue: the morph ramp.
    /// (renderPlain has a loop of its own for it, renderPlainShaped.)
    void tickShape (Osc& this, const OscBlock& b)
    {
        if (b.shaped && this.shp.morphOn)
            this.morphCur += this.shp.morphStep;
    }

    /// Moves the phase on by one sample, and the pitch ramp (offset) on by its slope.
    void stepPhase (Osc& this, const OscBlock& b)
    {
        if (this.nzDepth > 0)
            this.phase = (this.phase + this.noisyInc ((this.base + this.offset) & u32)) & u32;
        else
            this.phase = (this.phase + this.base + this.offset) & u32;

        this.offset = (this.offset + b.slope) & u32;
    }

    float waveValue (const Osc& this, const WaveTables& tables, const OscBlock& b, int64 ph)
    {
        if (b.shaped)
            return this.shapedValue (tables, b, ph);

        if (b.pulse)
            return lookup (tables, b, ph) - lookup (tables, b, ph + this.pwCur);

        return lookup (tables, b, ph);
    }

    /// renderPlain with the shape on (morph or phase distortion).
    void renderPlainShaped (Osc& this, const WaveTables& tables, const OscBlock& b, float[blockSize]& out, int n)
    {
        for (int i = 0; i < n; ++i)
        {
            let amp = this.tickShared (b);

            if (this.shp.morphOn)
                this.morphCur += this.shp.morphStep;

            out.at (i) = float (float64 (out.at (i)) + float64 (amp) * float64 (this.shapedValue (tables, b, this.phase)));
            this.stepPhase (b);
        }
    }

    /// Plain oscillator: adds into out.
    void renderPlain (Osc& this, const WaveTables& tables, int userSet, float mult, float[blockSize]& out, int n)
    {
        let b = this.beginBlock (tables, userSet, mult, 0, n);

        if (b.shaped)
        {
            this.renderPlainShaped (tables, b, out, n);
            return;
        }

        for (int i = 0; i < n; ++i)
        {
            let amp = this.tickShared (b);

            if (b.pulse)
            {
                out.at (i) = float (float64 (out.at (i)) + float64 (amp) * float64 (lookup (tables, b, this.phase)));
                out.at (i) = float (float64 (out.at (i)) - float64 (amp) * float64 (lookup (tables, b, this.phase + this.pwCur)));
            }
            else
            {
                out.at (i) = float (float64 (out.at (i)) + float64 (amp) * float64 (lookup (tables, b, this.phase)));
            }

            this.stepPhase (b);
        }
    }

    /// Writes the waveform (without amp) to wave and the amp ramp to amp: a modulator.
    void renderRaw (Osc& this, const WaveTables& tables, int userSet, float mult, float[blockSize]& wave,
                    float[blockSize]& amp, int n)
    {
        let b = this.beginBlock (tables, userSet, mult, 0, n);

        for (int i = 0; i < n; ++i)
        {
            amp.at (i) = this.tickShared (b);
            this.tickShape (b);
            wave.at (i) = this.waveValue (tables, b, this.phase);
            this.stepPhase (b);
        }
    }

    /// The carrier of Porridge's osc mix modes, added into out. mode 3: phase modulation by
    /// wave * amp (amp 1 = +-pi), plus self-feedback; 4: self-feedback only; 5: ring
    /// modulation, 6: amplitude modulation, both min (amp, 1) deep.
    void renderShaped (Osc& this, const WaveTables& tables, int userSet, float mult, float[blockSize]& out,
                       const float[blockSize]& wave, const float[blockSize]& amp, int mode, float feedback, int n)
    {
        let b = this.beginBlock (tables, userSet, mult, 0, n);
        let pm = mode == oscMixMode::pm2to1 || mode == oscMixMode::pmFeedback;
        let fb = float64 (feedback) * 0.3;

        for (int i = 0; i < n; ++i)
        {
            let a = this.tickShared (b);
            this.tickShape (b);

            if (pm)
            {
                var cycles = fb * 0.5 * float64 (this.fb1 + this.fb2);
                if (mode == oscMixMode::pm2to1) cycles += 0.5 * float64 (wave.at (i) * amp.at (i));
                let y = this.waveValue (tables, b, this.phase + (int64 (cycles * two32) & u32));
                this.fb2 = this.fb1;
                this.fb1 = y;
                out.at (i) = out.at (i) + a * y;
            }
            else
            {
                let d = clamp (amp.at (i), 0.0f, 1.0f);
                let y = this.waveValue (tables, b, this.phase);
                let g = mode == oscMixMode::ring ? 1.0f - d + d * wave.at (i) : 1.0f - 0.5f * d + 0.5f * d * wave.at (i);
                out.at (i) = out.at (i) + a * y * g;
            }

            this.stepPhase (b);
        }
    }

