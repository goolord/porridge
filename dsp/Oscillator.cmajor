            -1.00000131f, -0.797625899f, 0.162344158f, 0.0835762769f, 0.0348598212f, 0.0134246498f, 0.00413165009f, 0.000313530007f, -0.000925310014f, -0.000953499984f, -0.000371920003f, 8.51099976e-05f, 0.000240459995f, 0.000201710005f, 8.99000006e-05f, 6.57999999e-06f,
