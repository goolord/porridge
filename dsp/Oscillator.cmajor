            -0.891632318f, 0.207490161f, 0.0427853987f, -0.00457814988f, -0.0154120298f, -0.0155942095f, -0.0126477601f, -0.00904827006f, -0.00572255021f, -0.00297818007f, -0.00128564995f, -0.000407979998f, -3.33399985e-05f, 5.70699995e-05f, 2.20399997e-05f, 5.33999992e-06f,
            -0.871912122f, 0.202256307f, 0.0564711615f, 0.00634791004f, -0.00811512955f, -0.0109013095f, -0.00970210973f, -0.00726146018f, -0.00469009997f, -0.00240391004f, -0.000964339997f, -0.000240730005f, 3.71999995e-05f, 7.31999971e-05f, 1.96599995e-05f, 4.12000009e-06f,
            -0.84973973f, 0.192729607f, 0.0680071935f, 0.0167812891f, -0.00070325f, -0.00592532009f, -0.00647582021f, -0.00525762001f, -0.00351796998f, -0.00175923004f, -0.000618710008f, -7.21899996e-05f, 0.000101500002f, 8.41299989e-05f, 1.60799991e-05f, 2.3099999e-06f,
            -0.825005472f, 0.179278776f, 0.077110447f, 0.0263857599f, 0.00656072982f, -0.000852449972f, -0.00309450994f, -0.00311765005f, -0.00225541997f, -0.00107232004f, -0.000263930007f, 9.04199987e-05f, 0.000157009999f, 8.96700003e-05f, 1.161e-05f, 0.0f
    );

    /// Hard-sync oscillator. The master writes sub-sample wrap positions to syncOut (1..32, 0 = none);
    /// the slave resets its phase there and smooths the jump with a 16-tap BLEP residual.
    void renderSync (Osc& this, const WaveTables& tables, int userSet, float mult, float[blockSize]& out,
                     bool isSlave, int[blockSize]& sync, int n)
    {
        let b = this.beginBlock (tables, userSet, mult, 0, n);
        var prevPhase = this.phase;

        for (int i = 0; i < n; ++i)
        {
            let amp = this.tickShared (b);
            let y = this.waveValue (tables, b, this.phase);
            out.at (i) = float (float64 (out.at (i)) + float64 (y + this.ring.at (this.ringIdx)) * float64 (amp));
            this.ring.at (this.ringIdx) = 0;
            this.ringIdx = (this.ringIdx + 1) & 31;

            let inc = (this.base + this.offset) & u32;
            this.phase = (this.phase + inc) & u32;

            if (isSlave)
            {
                let v = sync.at (i);

                if (v != 0)
                {
                    this.phase = (int64 (v - 1) * (inc >> 5)) & u32;
                    let d = this.waveValue (tables, b, this.phase) - y;
                    let row = ((v - 1) & 31) * 16;

                    for (int k = 0; k < 16; ++k)
                    {
                        let idx = (this.ringIdx + k) & 31;
                        this.ring.at (idx) = this.ring.at (idx) + d * syncBlep.at (row + k);
                    }
                }
            }
            else
            {
                if (this.phase < prevPhase)
                {
                    let st = inc >> 5;
                    var v = 1;
                    var t = this.phase;

                    loop
                    {
                        t = (t - st) & u32;
                        if (t >= this.phase) break;
                        if (++v >= 32) break;
                    }

                    sync.at (i) = v;
                }
                else
                {
                    sync.at (i) = 0;
                }
            }

            this.offset = (this.offset + b.slope) & u32;
            prevPhase = this.phase;
        }
    }

    /// FM: the modulator (osc 1) is silent and writes its band-passed output to fm[0..63]
    /// (fm[64] = block maximum); the carrier (osc 2) advances by inc * (1 + fm[i]).
    void renderFM (Osc& this, const WaveTables& tables, int userSet, float mult, float[blockSize]& out,
                   bool isCarrier, float[65]& fm, float64 sr, int n)
    {
        float c1, c2;

        if (! isCarrier)
        {
            c1 = float (1.0 - pow (10.0, -3.0 / float64 (float (sr) * 0.002f)));
            c2 = float (pow (10.0, -2.0 / float64 (float (sr) * 0.01f)));
        }
        else
        {
            c1 = 1.0f;
            c2 = 0.5f;
        }

        let c3 = 2.0f * c2 - 1.0f;
        let extra = isCarrier ? int64 (float64 ((this.base + this.offset) & u32) * float64 (fm[64])) : 0;
        let b = this.beginBlock (tables, userSet, mult, max (extra, 0i64), n);
        var mx = 0.0f;

        for (int i = 0; i < n; ++i)
        {
            let amp = this.tickShared (b);

            if (isCarrier)
                this.phase = (this.phase + (int64 (float64 ((this.base + this.offset) & u32) * float64 (fm.at (i))) & u32)) & u32;

            let y = this.waveValue (tables, b, this.phase) * amp;

            if (isCarrier)
            {
                out.at (i) = out.at (i) + y;
            }
            else
            {
                let h = c2 * (y - this.fx1) + c3 * this.fy1;
                this.fy1 = h;
                this.fx1 = y;
                this.s1 = this.s1 + (this.fy1 - this.s1) * c1;
                this.s2 = this.s2 + (this.s1 - this.s2) * c1;
                fm.at (i) = this.s2;
                mx = max (mx, this.s2);
            }

            this.phase = (this.phase + this.base + this.offset) & u32;
            this.offset = (this.offset + b.slope) & u32;
        }

        if (! isCarrier)
            fm[64] = mx;
    }

    //==============================================================================
    struct Noise
    {
        bool first;
        float freq, glideTarget;
        bool glideOn;
        int glideRem;
        float glideStep;
        float l1, l2, b1, b2, F, q, g;
    }

    void resetNoise (Noise& this)
    {
        this.first = true;
        this.l1 = 0; this.l2 = 0; this.b1 = 0; this.b2 = 0; this.g = 0;
    }

    void glideTo (Noise& this, float t, int m)
    {
        this.glideTarget = t;

        if (m > 64)
        {
            this.glideOn = true;
            this.glideRem = m;
            this.glideStep = (t - this.freq) / float (m);
        }
        else
        {
            this.glideOn = false;
            this.glideStep = 0;
            this.freq = t;
            this.glideRem = 0;
        }
    }

    float noiseSvf (Noise& this, float x, float Fs, float qs)
    {
        this.l1 = this.l1 + Fs * this.b1;
        let h1 = qs * x - this.l1 - qs * this.b1;
        this.b1 = float (float64 (this.b1) + float64 (Fs) * float64 (h1));
        this.l2 = this.l2 + Fs * this.b2;
        let h2 = qs * this.l1 - this.l2 - qs * this.b2;
        this.b2 = float (float64 (this.b2) + float64 (Fs) * float64 (h2));
        return h2;
    }

    /// Writes one block of noise into buf (white, or resonant band-pass when N resonance > 0).
    void renderNoise (Noise& this, Rand& rng, const float[numSlots]& P, float Rg, float at, float ampMod, float resMod,
                      float64 sr, float[blockSize]& buf, int n)
    {
        var amp = ampMod * P[slot::N_Amp];
        let nat = P[slot::N_Aftertouch];

        if (nat > 0.01f)       amp *= float (pow (10.0, float64 ((at - 1.0f) * nat * 0.05f)));
        else if (nat < -0.01f) amp *= float (pow (10.0, float64 (at * nat * 0.05f)));

        if (this.glideOn)
        {
            if (this.glideRem > n)
            {
                this.glideRem -= n;
                this.freq += float (n) * this.glideStep;
            }
            else
            {
                this.glideOn = false;
                this.glideStep = 0;
                this.glideRem = 0;
                this.freq = this.glideTarget;
            }
        }

        let reso = P[slot::N_Resonance];

        if (reso <= 0)
        {
            for (int i = 0; i < n; ++i)
                buf.at (i) = (float (rng.next()) * (1.0f / 16384.0f) - 1.0f) * amp;

            return;
        }

        for (int i = 0; i < n; ++i)
            buf.at (i) = float (rng.next()) * (1.0f / 16384.0f) - 1.0f;

        let w = min (float64 (Rg) * float64 (this.freq) * 0.5 / sr * float64 (piF) * 2.0, float64 (piF * 0.98f));
        var F = float (2.0 * sin (w * 0.5));
        if (F > 1.2f) F = 1.2f;
        let m = clamp (resMod, -1.0f, 1.0f);
        let r2 = m > 0 ? reso + (1.0f - reso) * m : reso * (1.0f + m);
        let q = 1.0f - clamp (1.0f - (1.0f - r2) * (1.0f - r2), 0.0f, 1.0f) * 0.995f;
        let g = amp * 0.05f / (q * F);

        if (this.first)
        {
            this.first = false;
            this.F = F;
            this.q = q;
            this.g = g;
            let warm = int ((sr + 1.0) * 0.5);

            for (int k = 0; k < warm; ++k)
            {
                let x = float (rng.next()) * (1.0f / 16384.0f) - 1.0f;
                this.noiseSvf (x, this.F, this.q);
                this.noiseSvf (x, this.F, this.q);
            }
        }

        let dF = (F - this.F) / float (n);
        let dq = (q - this.q) / float (n);
        let dg = (g - this.g) / float (n);

        for (int i = 0; i < n; ++i)
        {
            this.F += dF;
            this.q += dq;
            this.g += dg;
            let a = this.noiseSvf (buf.at (i), this.F, this.q);
            let b = this.noiseSvf (buf.at (i), this.F, this.q);
            buf.at (i) = (a + b) * this.g;
        }
    }
}
