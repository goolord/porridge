//  Porridge: a Cmajor re-implementation of Oatmeal (Fuzzpilz, release 38-1, 2008).
//
//  The parameter endpoints (dsp/ParamStore.cmajor, generated) carry the same internal values
//  an Oatmeal preset stores. The synth keeps a flat mirror of the original program struct so
//  the DSP reads fields by their original chunk offsets (see dsp/Slots.cmajor and docs/).

graph Porridge  [[ main ]]
{
    input params.*;

    input event std::midi::Message midiIn               [[ name: "MIDI In" ]];
    input event std::timeline::Tempo tempoIn;
    input event porridge::Shape shapeIn;
    input event porridge::Curve curveIn;
    input event porridge::Tuning tuningIn;
    input event porridge::ImpulseChunk impulseIn;
    input event int impulseView;
    input event int panic;
    input event int levelRequest;

    output stream float<2> out                            [[ name: "Audio Out" ]];
    output event float<2> xyOut;
    output event int ccOut;
    output event porridge::CompMeter compMeterOut;
    output event porridge::ImpulseView impulseViewOut;
    output event float levelOut;

    node params = ParamStore;
    node synth  = porridge::Synth;

    connection
    {
        params.paramOut -> synth.paramIn;
        midiIn          -> synth.midiIn;
        tempoIn         -> synth.tempoIn;
        shapeIn         -> synth.shapeIn;
        curveIn         -> synth.curveIn;
        tuningIn        -> synth.tuningIn;
        impulseIn       -> synth.impulseIn;
        impulseView     -> synth.impulseViewIn;
        panic           -> synth.panicIn;
        levelRequest    -> synth.levelRequestIn;
        synth.out       -> out;
        synth.xyOut     -> xyOut;
        synth.ccOut     -> ccOut;
        synth.compMeterOut -> compMeterOut;
        synth.impulseViewOut -> impulseViewOut;
        synth.levelOut  -> levelOut;
    }
}
