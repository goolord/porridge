    event shaperIn (porridge::ShaperPoints s)
    {
        if (s.which >= 0 && s.which < porridge::numShapers)
            for (wrap<49> i)
                paramOut <- porridge::ParamChange (porridge::shaperSlots.at (s.which * 49 + int (i)), s.values[i]);
    }
}
