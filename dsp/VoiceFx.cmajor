//  The voice lane: up to laneSlots effects in every voice (VL_1 .. VL_4, the same values as the
//  rack's slots), placed around the filter and the amp envelope (VL_FilterAt, VL_AmpAt). Each
//  note runs its own copy of each, so its LFOs, envelopes and key move them for that note alone:
//  the rack's filter, distortion, EQ, phaser, flanger and utility, and three that only work per
//  note, a frequency shifter that follows the key, a resonator tuned to it and an octaver.
//
//  The synth swaps a copy's parameters into its first's slots to run it, as the rack does, so
//  the code here reads the first's. A voice renders in pieces of n samples (MIDI splits blocks),
//  so everything here works on n; values glide from block to block. Both sides run only once
//  something makes them differ (a stereo phase, a spread, a pan): until then the right side is
//  the left's.

namespace porridge
{
    let laneSlots = 4;
    let laneFlangerLine = combSize; // 42 ms at 48 kHz (21 ms at 96): the flanger's delays and depth

    /// One lane slot's state in one voice, whichever kind it holds (only that kind's part is
    /// used; a different value in the slot starts it afresh). Its filters, distortions and
    /// flanger line are in a LaneBuffers.
    struct LaneFx
    {
        int fx;
        bool fresh;

        // a random number 0..1 drawn as it starts, for the phaser's and flanger's random start
        float startRand;

        // filter: the cutoff (ln Hz), morph and mix, gliding per block
        float fHz, fMorph, fMix;

        // EQ: each band's state per side; its coefficients and what they were worked out from
        // (eqType 0: not yet)
        float[5] eqL1, eqL2, eqR1, eqR2;
        EQCoefs[5] eqC;
        float[5] eqFreq, eqAmp, eqSlope;
        int[5] eqType;
        float64[5] eqRate;

        // phaser: stages' states and coefficients per side, the chain's last output, the LFO,
        // the gliding centre (ln Hz), depth, spread, feedback and mix
        float[16] phSL, phSR, phAL, phAR;
        float phLastL, phLastR;
        float64 phPhase;
        float phCentre, phDepth, phSpread, phFb, phMix;
        int phStages;

        // flanger: the line's write position, the LFO, and the gliding delay, depth, feedback
        // and mix
        int flPos;
        float64 flPhase;
        float flDelay, flDepth, flFb, flMix;

        // utility: gliding gain, balance and width
        float utGain, utPanL, utPanR, utWidth;

        // shifter: the Hilbert pair's states per side (in z^-2), path B's delay, the
        // oscillator, the gliding shift (Hz) and mix
        float[16] hx1L, hx2L, hy1L, hy2L, hx1R, hx2R, hy1R, hy2R;
        float hPrevL, hPrevR;
        float64 shPhase;
        float shHz, shMix;

        // resonator: each mode's two outputs and inputs back, per side, and the gliding mix;
        // each mode's gain, feedback and weight, the weights' sum, and what they were worked
        // out from (rsDesigned: whether they have been since the note started)
        float[4] rY1L, rY2L, rX1L, rX2L, rY1R, rY2R, rX1R, rX2R;
        float rsMix, rsGain;
        float[4] rsG, rsA1, rsA2, rsWt;
        float64 rsWeights, rsRate;
        float rsNoteHz, rsPitch, rsDecay, rsBright;
        int rsModel;
        bool rsDesigned;

        // octaver: the lowpasses that find the note's cycles and the last of them, the switch
        // (+-1) and how far it has eased to its sign, each side's DC blocker for the octave up
        // (last input and output), and the gliding levels
        float ocLp1, ocLp2, ocLast, ocFlip, ocSign;
        float ocUpXL, ocUpYL, ocUpXR, ocUpYR;
        float ocSub, ocUp, ocDry;
    }

    /// A lane slot's big parts, which only its kind uses (and startLane clears for it): kept
    /// apart from the rest of its state, which a new voice clears. The filter's and the
    /// distortion's state per side. The flanger's line is the filters' comb lines (the left
    /// side in filt[0], the right in filt[1]): a slot holds one kind, and the line is the
    /// filters' biggest part, so sharing it saves 16 kB in each of the 128 slots.
    struct LaneBuffers
    {
        Filter[2] filt;
        Distortion[2] dist;
    }

    //==============================================================================
    /// The resonator's models (Rs_Model): each mode's frequency, relative to the note.
    let resonatorRatios = float[24] (1.0f, 2.0f, 3.0f, 4.0f,             // harmonic
                                     1.0f, 3.0f, 5.0f, 7.0f,             // odd
                                     1.0f, 1.5f, 2.0f, 3.0f,             // fifths
                                     1.0f, 2.756f, 5.404f, 8.933f,       // bar (free at both ends)
                                     1.0f, 2.0f, 2.4f, 3.0f,             // bell (hum, prime, tierce, quint)
                                     1.0f, 1.593f, 2.136f, 2.296f);      // membrane

    /// A knob's glide per block of n samples: about 20 ms (the synth keeps it for every n,
    /// laneGlides, and passes it to the kinds below as glide).
    float laneGlide (int n, float64 sr)
    {
        return float (1.0 - exp (-float64 (n) / (0.02 * sr)));
    }

    /// Clears what this kind keeps, for a note that starts or a slot that changes.
    void startLane (LaneFx& this, LaneBuffers& bufs, int kind)
    {
        this.fresh = true;

        if (kind == rack::filterKind)
        {
            bufs.filt[0].clearState();
            bufs.filt[1].clearState();
        }
        else if (kind == rack::distortionKind)
        {
            bufs.dist[0].clearState();
            bufs.dist[1].clearState();
        }
        else if (kind == rack::eqKind)
        {
            this.eqL1 = float[5](); this.eqL2 = float[5](); this.eqR1 = float[5](); this.eqR2 = float[5]();
        }
        else if (kind == rack::phaserKind)
        {
            this.phSL = float[16](); this.phSR = float[16]();
            this.phLastL = 0; this.phLastR = 0;
            this.phPhase = 0;
            this.phStages = 0;
        }
        else if (kind == rack::flangerKind)
        {
            for (wrap<laneFlangerLine> i)
            {
                bufs.filt[0].comb[i] = 0.0f;
                bufs.filt[1].comb[i] = 0.0f;
            }

            this.flPos = 0;
            this.flPhase = 0;
        }
        else if (kind == rack::shifterKind)
        {
            this.hx1L = float[16](); this.hx2L = float[16](); this.hy1L = float[16](); this.hy2L = float[16]();
            this.hx1R = float[16](); this.hx2R = float[16](); this.hy1R = float[16](); this.hy2R = float[16]();
            this.hPrevL = 0; this.hPrevR = 0;
            this.shPhase = 0;
        }
        else if (kind == rack::resonatorKind)
        {
            this.rY1L = float[4](); this.rY2L = float[4](); this.rX1L = float[4](); this.rX2L = float[4]();
            this.rY1R = float[4](); this.rY2R = float[4](); this.rX1R = float[4](); this.rX2R = float[4]();
            this.rsDesigned = false;
        }
        else if (kind == rack::octaverKind)
        {
            this.ocLp1 = 0; this.ocLp2 = 0; this.ocLast = 0;
            this.ocFlip = 1.0f; this.ocSign = 1.0f;
            this.ocUpXL = 0; this.ocUpYL = 0; this.ocUpXR = 0; this.ocUpYR = 0;
        }
    }

    /// Whether this kind, as it's set, makes the two sides differ.
    bool laneSplits (int kind, const float[numSlots]& P)
    {
        if (kind == rack::filterKind)   return P[slot::Ff_Spread] != 0;
        if (kind == rack::phaserKind)   return P[slot::Ph_Phase] != 0;
        if (kind == rack::flangerKind)  return P[slot::Fl_Phase] != 0;
        if (kind == rack::utilityKind)  return P[slot::Ut_Pan] != 0 || P[slot::Ut_InvL] != P[slot::Ut_InvR] || P[slot::Ut_Swap] != 0;
        if (kind == rack::shifterKind)  return int (P[slot::Sh_Mode]) == bodeMode::stereo;
        return false;
    }

    //==============================================================================
    // filter

    void laneFilter (LaneFx& this, LaneBuffers& bufs, const FxTables& tables, const float[numSlots]& P, float noteHz, float64 sr, float glide,
                     float[blockSize]& l, float[blockSize]& r, bool both, int n)
    {
        let t = int (P[slot::Ff_Type]);

        if (t <= filterType::off)
            return;

        var hz = float64 (expKnob (20.0f, 20000.0f, P[slot::Ff_Cutoff]));
        hz *= pow (float64 (noteHz) / 261.63, float64 (clamp (P[slot::Ff_Track], 0.0f, 1.0f)));
        let tHz = float (log (clamp (hz, 5.0, 40000.0)));
        let tMix = clamp (P[slot::Ff_Mix], 0.0f, 1.0f);
        let tMorph = clamp (P[slot::Ff_Morph], 0.0f, 1.0f);

        if (this.fresh)
        {
            this.fHz = tHz; this.fMix = tMix; this.fMorph = tMorph;
        }

        let k = glide;
        this.fHz += (tHz - this.fHz) * k;
        this.fMorph += (tMorph - this.fMorph) * k;
        let mix0 = this.fMix;
        this.fMix += (tMix - this.fMix) * k;
        let dm = (this.fMix - mix0) / float (n);

        let spread = clamp (P[slot::Ff_Spread], -24.0f, 24.0f) * (0.693147181f / 24.0f);
        let res = clamp (P[slot::Ff_Resonance], 0.0f, 1.0f);
        let drive = clamp (P[slot::Ff_Drive], 0.0f, 1.0f);
        float[blockSize] wet;

        wet = l;
        bufs.filt[0].process (tables, t, exp (this.fHz - spread), res, this.fMorph, drive, sr, wet, n);

        for (int i = 0; i < n; ++i)
            l.at (i) += (wet.at (i) - l.at (i)) * (mix0 + dm * float (i + 1));

        if (both)
        {
            wet = r;
            bufs.filt[1].process (tables, t, exp (this.fHz + spread), res, this.fMorph, drive, sr, wet, n);

            for (int i = 0; i < n; ++i)
                r.at (i) += (wet.at (i) - r.at (i)) * (mix0 + dm * float (i + 1));
        }
    }

    //==============================================================================
    // EQ: Oatmeal's five bands (Effects.cmajor's EQ), per side

    void laneEq (LaneFx& this, const float[numSlots]& P, float64 sr, float[blockSize]& l, float[blockSize]& r, bool both, int n)
    {
        for (wrap<5> k)
        {
            let type = int (P.at (slot::EQ_1_Type + k));

            if (type == 0)
                continue;

            // the same for every voice unless a connection moves them: worked out again only
            // when what they come from changes
            let freq = P.at (slot::EQ_1_Freq + k), amp = P.at (slot::EQ_1_Amp + k), slope = P.at (slot::EQ_1_Slope + k);

            if (type != this.eqType[k] || freq != this.eqFreq[k] || amp != this.eqAmp[k] || slope != this.eqSlope[k] || sr != this.eqRate[k])
            {
                this.eqC[k] = eqBandCoefs (P, k, type, sr);
                this.eqType[k] = type; this.eqFreq[k] = freq; this.eqAmp[k] = amp; this.eqSlope[k] = slope; this.eqRate[k] = sr;
            }

            let c = this.eqC[k];
            var s1 = this.eqL1[k], s2 = this.eqL2[k];

            for (int i = 0; i < n; ++i)
            {
                let x = l.at (i) + 1e-18f;
                let y = c.B0 * x + s1;
                s1 = c.A1 * y + c.B1 * x + s2;
                s2 = c.A2 * y + c.B2 * x;
                l.at (i) = y;
            }

            this.eqL1[k] = s1; this.eqL2[k] = s2;

            if (both)
            {
                s1 = this.eqR1[k]; s2 = this.eqR2[k];

                for (int i = 0; i < n; ++i)
                {
                    let x = r.at (i) + 1e-18f;
                    let y = c.B0 * x + s1;
                    s1 = c.A1 * y + c.B1 * x + s2;
                    s2 = c.A2 * y + c.B2 * x;
                    r.at (i) = y;
                }

                this.eqR1[k] = s1; this.eqR2[k] = s2;
            }
        }
    }

    //==============================================================================
    // phaser (FxExtra.cmajor's): the note's own LFO, from the note-on (or a random point of
    // it), and its tracking follows the voice's note

    void lanePhaser (LaneFx& this, const float[numSlots]& P, float noteHz, float64 sr, float glide,
                     float[blockSize]& l, float[blockSize]& r, bool both, int n)
    {
        let t = phaserTargets (P, noteHz, true);
        let stages = t.stages;
        let offset = t.offset;
        let fresh = this.fresh;

        if (fresh)
        {
            this.phCentre = t.centre; this.phDepth = t.depth; this.phSpread = t.spread;
            this.phFb = t.fb; this.phMix = t.mix;
            this.phPhase = float64 (this.startRand * clamp (P[slot::Ph_PhaseRand], 0.0f, 1.0f));
        }

        let k = glide;
        this.phCentre += (t.centre - this.phCentre) * k;
        this.phDepth += (t.depth - this.phDepth) * k;
        this.phSpread += (t.spread - this.phSpread) * k;
        let fb0 = this.phFb, mix0 = this.phMix;
        this.phFb += (t.fb - this.phFb) * k;
        this.phMix += (t.mix - this.phMix) * k;
        let dfb = (this.phFb - fb0) / float (n), dmix = (this.phMix - mix0) / float (n);

        // the LFO at the end of this piece sets the coefficients it ramps to
        this.phPhase += float64 (t.rate) / sr * float64 (n);
        this.phPhase -= floor (this.phPhase);
        let ln2 = 0.693147181;
        let sweepL = 3.0 * float64 (this.phDepth) * sin (twoPi * this.phPhase);
        let sweepR = 3.0 * float64 (this.phDepth) * sin (twoPi * (this.phPhase + offset));
        float[16] daL, daR;

        for (wrap<16> s)
        {
            if (s >= stages) break;

            let oct = float64 (this.phSpread) * (2.0 * float64 (s) / float64 (stages - 1) - 1.0);
            let aL = phaserCoef (exp (float64 (this.phCentre) + ln2 * (sweepL + oct)), sr);
            let aR = phaserCoef (exp (float64 (this.phCentre) + ln2 * (sweepR + oct)), sr);

            if (fresh || s >= this.phStages)
            {
                this.phAL[s] = aL; this.phAR[s] = aR;
                this.phSL[s] = 0; this.phSR[s] = 0;
            }

            daL[s] = (aL - this.phAL[s]) / float (n);
            daR[s] = (aR - this.phAR[s]) / float (n);
        }

        this.phStages = stages;

        for (int i = 0; i < n; ++i)
        {
            let fb = fb0 + dfb * float (i + 1);
            let mix = mix0 + dmix * float (i + 1);
            let x = l.at (i);
            let back = extraSoftClip (fb * this.phLastL);
            var v = x + back + 1e-18f;

            for (wrap<16> s)
            {
                if (s >= stages) break;

                this.phAL[s] += daL[s];
                let y = this.phAL[s] * v + this.phSL[s];
                this.phSL[s] = v - this.phAL[s] * y;
                v = y;
            }

            this.phLastL = v;
            l.at (i) = (x + back * min (1.0f, 2.0f * mix)) * (1.0f - mix) + v * mix;
        }

        if (both)
        {
            for (int i = 0; i < n; ++i)
            {
                let fb = fb0 + dfb * float (i + 1);
                let mix = mix0 + dmix * float (i + 1);
                let x = r.at (i);
                let back = extraSoftClip (fb * this.phLastR);
                var v = x + back + 1e-18f;

                for (wrap<16> s)
                {
                    if (s >= stages) break;

                    this.phAR[s] += daR[s];
                    let y = this.phAR[s] * v + this.phSR[s];
                    this.phSR[s] = v - this.phAR[s] * y;
                    v = y;
                }

                this.phLastR = v;
                r.at (i) = (x + back * min (1.0f, 2.0f * mix)) * (1.0f - mix) + v * mix;
            }
        }
        else
        {
            // the right side's coefficients keep up, for when it parts from the left
            for (wrap<16> s)
                if (s < stages) this.phAR[s] += daR[s] * float (n);
        }
    }

    //==============================================================================
    // flanger (FxExtra.cmajor's), on a shorter line: the note's own LFO, from the note-on (or a
    // random point of it), and its delay and rate following the voice's note

    float laneFlangerRead (const LaneFx& this, const LaneBuffers& bufs, float d, int ch)
    {
        let di = int (d);
        let t = d - float (di);
        let m = laneFlangerLine - 1;
        let p = this.flPos - di;
        let c = wrap<2> (ch);
        return hermite (bufs.filt[c].comb.at ((p + 1) & m), bufs.filt[c].comb.at (p & m),
                        bufs.filt[c].comb.at ((p - 1) & m), bufs.filt[c].comb.at ((p - 2) & m), t);
    }

    void laneFlanger (LaneFx& this, LaneBuffers& bufs, const float[numSlots]& P, float noteHz, float64 sr, float glide,
                      float[blockSize]& l, float[blockSize]& r, bool both, int n)
    {
        let longest = float (laneFlangerLine - 4);
        let t = flangerTargets (P, sr, longest, noteHz);
        let inc = t.inc, offset = t.offset;

        if (this.fresh)
        {
            this.flDelay = t.delay; this.flDepth = t.depth; this.flFb = t.fb; this.flMix = t.mix;
            this.flPhase = float64 (this.startRand * clamp (P[slot::Fl_PhaseRand], 0.0f, 1.0f));
        }

        let k = glide;
        let d0 = this.flDelay, dp0 = this.flDepth, fb0 = this.flFb, mix0 = this.flMix;
        this.flDelay += (t.delay - this.flDelay) * k;
        this.flDepth += (t.depth - this.flDepth) * k;
        this.flFb += (t.fb - this.flFb) * k;
        this.flMix += (t.mix - this.flMix) * k;
        let step = 1.0f / float (n);
        var sweep = flangerSweep (this.flPhase, inc, offset);

        for (int i = 0; i < n; ++i)
        {
            let f = float (i + 1) * step;
            let delay = d0 + (this.flDelay - d0) * f;
            let depth = dp0 + (this.flDepth - dp0) * f;
            let fb = fb0 + (this.flFb - fb0) * f;
            let mix = mix0 + (this.flMix - mix0) * f;

            let e = sweep.next (4.0f * 0.693147181f * depth);
            let yL = this.laneFlangerRead (bufs, clamp (delay * e[0], 2.0f, longest), 0);
            let yR = this.laneFlangerRead (bufs, clamp (delay * e[1], 2.0f, longest), 1);

            let xL = l.at (i);
            let xR = both ? r.at (i) : xL;
            let backL = extraSoftClip (fb * yL);
            let backR = extraSoftClip (fb * yR);
            bufs.filt[0].comb.at (this.flPos) = xL + backL + 1e-18f;
            bufs.filt[1].comb.at (this.flPos) = xR + backR + 1e-18f;
            this.flPos = (this.flPos + 1) & (laneFlangerLine - 1);

            l.at (i) = (xL + backL * min (1.0f, 2.0f * mix)) * (1.0f - mix) + yL * mix;
            if (both) r.at (i) = (xR + backR * min (1.0f, 2.0f * mix)) * (1.0f - mix) + yR * mix;

            this.flPhase += inc;
            if (this.flPhase >= 1.0) this.flPhase -= 1.0;
        }
    }

    //==============================================================================
    // utility: swap, inversion, width, balance and gain (FxExtra.cmajor's, without bass mono,
    // which needs the whole sound)

    void laneUtility (LaneFx& this, const float[numSlots]& P, float64 sr, float glide, float[blockSize]& l, float[blockSize]& r, bool both, int n)
    {
        let t = utilityTargets (P);
        let invL = t.invL, invR = t.invR, swap = t.swap;

        if (this.fresh)
        {
            this.utGain = t.gain; this.utPanL = t.panL; this.utPanR = t.panR; this.utWidth = t.width;
        }

        let k = glide;
        let g0 = this.utGain, pl0 = this.utPanL, pr0 = this.utPanR, w0 = this.utWidth;
        this.utGain += (t.gain - this.utGain) * k;
        this.utPanL += (t.panL - this.utPanL) * k;
        this.utPanR += (t.panR - this.utPanR) * k;
        this.utWidth += (t.width - this.utWidth) * k;
        let step = 1.0f / float (n);

        for (int i = 0; i < n; ++i)
        {
            let f = float (i + 1) * step;
            let g = g0 + (this.utGain - g0) * f;

            if (! both)
            {
                l.at (i) *= g * invL;
                continue;
            }

            var a = l.at (i), b = r.at (i);
            if (swap) { let x = a; a = b; b = x; }
            a *= invL;
            b *= invR;
            let w = w0 + (this.utWidth - w0) * f;
            let mid = 0.5f * (a + b);
            let side = 0.5f * (a - b) * w;
            l.at (i) = (mid + side) * (pl0 + (this.utPanL - pl0) * f) * g;
            r.at (i) = (mid - side) * (pr0 + (this.utPanR - pr0) * f) * g;
        }
    }

    //==============================================================================
    // shifter: a frequency shift that follows the key. The Hilbert pair (Bode's design in
    // FxExtra.cmajor, its coefficients shared by every voice) and a quadrature oscillator at Sh_Ratio of the note's frequency plus Sh_Hz, so that the
    // shifted partials keep the same places relative to every note.

    /// Sh_Ratio's knob (-1..1) as a fraction of the note: cubed, times 2.
    float shifterRatio (float v)        { let x = clamp (v, -1.0f, 1.0f); return 2.0f * x * x * x; }
    /// Sh_Hz's knob as Hz: cubed, times 1000.
    float shifterHz (float v)           { let x = clamp (v, -1.0f, 1.0f); return 1000.0f * x * x * x; }

    void laneShifter (LaneFx& this, const float[hilbertCoefs]& c, const float[numSlots]& P, float noteHz, float64 sr, float glide,
                      float[blockSize]& l, float[blockSize]& r, bool both, int n)
    {
        let tHz = noteHz * shifterRatio (P[slot::Sh_Ratio]) + shifterHz (P[slot::Sh_Hz]);
        let tMix = clamp (P[slot::Sh_Mix], 0.0f, 1.0f);
        let mode = int (P[slot::Sh_Mode]);
        let sideL = mode == bodeMode::down ? -1.0f : (mode == bodeMode::ring ? 0.0f : 1.0f);
        let sideR = mode == bodeMode::down || mode == bodeMode::stereo ? -1.0f : (mode == bodeMode::ring ? 0.0f : 1.0f);

        if (this.fresh)
        {
            this.shHz = tHz; this.shMix = tMix;
        }

        let k = glide;
        let hz0 = this.shHz, mix0 = this.shMix;
        this.shHz += (tHz - this.shHz) * k;
        this.shMix += (tMix - this.shMix) * k;
        let step = 1.0f / float (n);
        let phase0 = this.shPhase;

        // the oscillator turns by a fixed step through the piece (at its mean shift)
        let turn = twoPi * float64 (0.5f * (hz0 + this.shHz)) / sr;
        let rc = cos (turn), rs = sin (turn);
        var pc = cos (twoPi * phase0), ps = sin (twoPi * phase0);

        for (int i = 0; i < n; ++i)
        {
            let f = float (i + 1) * step;
            let mix = mix0 + (this.shMix - mix0) * f;
            let x = l.at (i);
            var a = x + 1e-18f;
            var b = this.hPrevL;
            this.hPrevL = a;

            for (wrap<hilbertCoefs / 2> j)
            {
                let ja = wrap<hilbertCoefs> (2 * j), jb = wrap<hilbertCoefs> (2 * j + 1);
                let ya = c[ja] * (a + this.hy2L[ja]) - this.hx2L[ja];
                this.hx2L[ja] = this.hx1L[ja]; this.hx1L[ja] = a; this.hy2L[ja] = this.hy1L[ja]; this.hy1L[ja] = ya;
                a = ya;
                let yb = c[jb] * (b + this.hy2L[jb]) - this.hx2L[jb];
                this.hx2L[jb] = this.hx1L[jb]; this.hx1L[jb] = b; this.hy2L[jb] = this.hy1L[jb]; this.hy1L[jb] = yb;
                b = yb;
            }

            let cs = float (pc), sn = float (ps);
            let c1 = pc * rc - ps * rs;
            ps = ps * rc + pc * rs;
            pc = c1;
            l.at (i) = x + (b * cs + a * sn * sideL - x) * mix;
        }

        this.shPhase = phase0 + float64 (0.5f * (hz0 + this.shHz)) * float64 (n) / sr;
        this.shPhase -= floor (this.shPhase);

        if (! both)
            return;

        pc = cos (twoPi * phase0);
        ps = sin (twoPi * phase0);

        for (int i = 0; i < n; ++i)
        {
            let f = float (i + 1) * step;
            let mix = mix0 + (this.shMix - mix0) * f;
            let x = r.at (i);
            var a = x + 1e-18f;
            var b = this.hPrevR;
            this.hPrevR = a;

            for (wrap<hilbertCoefs / 2> j)
            {
                let ja = wrap<hilbertCoefs> (2 * j), jb = wrap<hilbertCoefs> (2 * j + 1);
                let ya = c[ja] * (a + this.hy2R[ja]) - this.hx2R[ja];
                this.hx2R[ja] = this.hx1R[ja]; this.hx1R[ja] = a; this.hy2R[ja] = this.hy1R[ja]; this.hy1R[ja] = ya;
                a = ya;
                let yb = c[jb] * (b + this.hy2R[jb]) - this.hx2R[jb];
                this.hx2R[jb] = this.hx1R[jb]; this.hx1R[jb] = b; this.hy2R[jb] = this.hy1R[jb]; this.hy1R[jb] = yb;
                b = yb;
            }

            let cs = float (pc), sn = float (ps);
            let c1 = pc * rc - ps * rs;
            ps = ps * rc + pc * rs;
            pc = c1;
            r.at (i) = x + (b * cs + a * sn * sideR - x) * mix;
        }
    }

    //==============================================================================
    // resonator: four resonances at the model's ratios of the note (moved by Rs_Pitch), each
    // ringing for Rs_Decay (the higher ones shorter), louder towards the top with Rs_Bright, at
    // Rs_Gain (the ringing's level, before the mix with the dry sound).

    void laneResonator (LaneFx& this, const float[numSlots]& P, float noteHz, float64 sr, float glide,
                        float[blockSize]& l, float[blockSize]& r, bool both, int n)
    {
        let model = clamp (int (P[slot::Rs_Model]), 0, 5);
        let pitch = P[slot::Rs_Pitch], decayKnob = P[slot::Rs_Decay], brightKnob = P[slot::Rs_Bright];
        let tMix = clamp (P[slot::Rs_Mix], 0.0f, 1.0f);

        let tGain = float (pow (10.0, float64 (clamp (P[slot::Rs_Gain], -24.0f, 24.0f)) * 0.05));

        if (this.fresh)
        {
            this.rsMix = tMix;
            this.rsGain = tGain;
        }

        let mix0 = this.rsMix, gain0 = this.rsGain;
        let k = glide;
        this.rsMix += (tMix - this.rsMix) * k;
        this.rsGain += (tGain - this.rsGain) * k;
        let dmix = (this.rsMix - mix0) / float (n);
        let dgain = (this.rsGain - gain0) / float (n);

        // each mode's gain (b0, at its peak 1 before the weights), feedback, and weight, worked
        // out again only when what they come from has changed
        if (! (this.rsDesigned && model == this.rsModel && noteHz == this.rsNoteHz && pitch == this.rsPitch
                 && decayKnob == this.rsDecay && brightKnob == this.rsBright && sr == this.rsRate))
        {
            this.rsDesigned = true;
            this.rsModel = model; this.rsNoteHz = noteHz; this.rsPitch = pitch;
            this.rsDecay = decayKnob; this.rsBright = brightKnob; this.rsRate = sr;

            let base = float64 (noteHz) * pow (2.0, float64 (clamp (pitch, -48.0f, 48.0f)) / 12.0);
            let decay = float64 (expKnob (10.0f, 10000.0f, decayKnob)) * 0.001;
            let bright = float64 (clamp (brightKnob, 0.0f, 1.0f));

            this.rsG = float[4](); this.rsA1 = float[4](); this.rsA2 = float[4](); this.rsWt = float[4]();
            this.rsWeights = 0;

            for (wrap<4> m)
            {
                let ratio = float64 (resonatorRatios.at (model * 4 + m));
                let hz = base * ratio;

                if (hz <= 10.0 || hz >= 0.45 * sr)
                    continue;

                let t = decay / sqrt (ratio);
                let rr = exp (-6.907755 / (t * sr));
                let w = twoPi * hz / sr;
                this.rsA1[m] = float (2.0 * rr * cos (w));
                this.rsA2[m] = float (-rr * rr);
                this.rsG[m] = float ((1.0 - rr * rr) * 0.5);
                let weight = pow (ratio, 2.0 * bright - 1.5);
                this.rsWt[m] = float (weight);
                this.rsWeights += weight;
            }
        }

        let g = this.rsG, a1 = this.rsA1, a2 = this.rsA2, wt = this.rsWt;
        let weights = this.rsWeights;

        if (weights <= 0)
            return;

        let norm = float (1.0 / weights);

        for (int i = 0; i < n; ++i)
        {
            let mix = mix0 + dmix * float (i + 1);
            let x = l.at (i);
            var wet = 0.0f;

            for (wrap<4> m)
            {
                let y = g[m] * (x - this.rX2L[m]) + a1[m] * this.rY1L[m] + a2[m] * this.rY2L[m] + 1e-18f;
                this.rX2L[m] = this.rX1L[m]; this.rX1L[m] = x;
                this.rY2L[m] = this.rY1L[m]; this.rY1L[m] = y;
                wet += wt[m] * y;
            }

            l.at (i) = x + (wet * norm * 2.0f * (gain0 + dgain * float (i + 1)) - x) * mix;
        }

        if (! both)
            return;

        for (int i = 0; i < n; ++i)
        {
            let mix = mix0 + dmix * float (i + 1);
            let x = r.at (i);
            var wet = 0.0f;

            for (wrap<4> m)
            {
                let y = g[m] * (x - this.rX2R[m]) + a1[m] * this.rY1R[m] + a2[m] * this.rY2R[m] + 1e-18f;
                this.rX2R[m] = this.rX1R[m]; this.rX1R[m] = x;
                this.rY2R[m] = this.rY1R[m]; this.rY1R[m] = y;
                wet += wt[m] * y;
            }

            r.at (i) = x + (wet * norm * 2.0f * (gain0 + dgain * float (i + 1)) - x) * mix;
        }
    }

    //==============================================================================
    // octaver: the octave down is the sound with its sign flipped on every other cycle of the
    // note, the cycles found where the sound through two lowpasses at the note (which leave
    // mostly its fundamental) rises through zero; the flip eases over a few samples. The octave
    // up is the sound rectified, less its average (a DC blocker at 20 Hz). The left side (or
    // mono) finds the cycles for both.

    void laneOctaver (LaneFx& this, const float[numSlots]& P, float noteHz, float64 sr, float glide,
                      float[blockSize]& l, float[blockSize]& r, bool both, int n)
    {
        let tSub = clamp (P[slot::Oc_Sub], 0.0f, 1.0f);
        let tUp = clamp (P[slot::Oc_Up], 0.0f, 1.0f);
        let tDry = clamp (P[slot::Oc_Dry], 0.0f, 1.0f);

        if (this.fresh)
        {
            this.ocSub = tSub; this.ocUp = tUp; this.ocDry = tDry;
        }

        let k = glide;
        let sub0 = this.ocSub, up0 = this.ocUp, dry0 = this.ocDry;
        this.ocSub += (tSub - this.ocSub) * k;
        this.ocUp += (tUp - this.ocUp) * k;
        this.ocDry += (tDry - this.ocDry) * k;
        let step = 1.0f / float (n);

        let a = float (1.0 - exp (-twoPi * clamp (float64 (noteHz), 20.0, 0.2 * sr) / sr));
        let dc = float (1.0 - twoPi * 20.0 / sr);
        var lp1 = this.ocLp1, lp2 = this.ocLp2, last = this.ocLast, flip = this.ocFlip, sign = this.ocSign;

        for (int i = 0; i < n; ++i)
        {
            let f = float (i + 1) * step;
            let sub = sub0 + (this.ocSub - sub0) * f;
            let up = up0 + (this.ocUp - up0) * f;
            let dry = dry0 + (this.ocDry - dry0) * f;
            let x = l.at (i);

            lp1 += (x - lp1) * a;
            lp2 += (lp1 - lp2) * a;

            if (last < 0 && lp2 >= 0)
                flip = -flip;

            last = lp2;
            sign += (flip - sign) * 0.25f;

            let ax = abs (x);
            let yu = ax - this.ocUpXL + dc * this.ocUpYL + 1e-18f;
            this.ocUpXL = ax; this.ocUpYL = yu;
            l.at (i) = x * (dry + sub * sign) + yu * up;

            if (both)
            {
                let xr = r.at (i);
                let axr = abs (xr);
                let yr = axr - this.ocUpXR + dc * this.ocUpYR + 1e-18f;
                this.ocUpXR = axr; this.ocUpYR = yr;
                r.at (i) = xr * (dry + sub * sign) + yr * up;
            }
        }

        this.ocLp1 = lp1 + 1e-18f; this.ocLp2 = lp2; this.ocLast = last; this.ocFlip = flip; this.ocSign = sign;
    }
}
