//  Ports of Airwindows plugins by Chris Johnson (MIT licence, github.com/airwindows/airwindows):
//  the distortion's models, and the air rack effect (Air4).
//
//  The distortion's models are its types after Oatmeal's and the custom shape (Sat_Type
//  satType::tube on). Each runs on one channel, sample by sample, where the distortion's curve
//  would: after the pregain, inside the oversampling (at its rate) and before the postgain. Three
//  knobs, Sat_Drive, Sat_Tone and Sat_Character, set each model's own controls (setup below);
//  the plugins' input and output levels are the distortion's pregain and postgain, and their
//  dry/wet its mix. They match the original code but for its dither, its denormal noise and the
//  smoothing of a few controls over each buffer:
//    tube           Tube: drive is its one control
//    tape           Tape: drive its slam (input gain), tone its head bump
//    saturate       Density: drive its density (-1 .. 4), character its highpass
//    mixer drive    Mackity: the input stage of a small mixer; drive its input trim (+-24 dB)
//    7-stage clip   Edge: seven clips with lowpasses between; drive its gain (squared), tone its
//                   lowpass, character its highpass
//    multiband      MultiBandDistortion: a highs and a lows band, each driven into a sine clip;
//                   drive both bands' gain (0 .. +24 dB), tone the split, character the hardness
//    wavefold       Fracture2: drive its drive (squared: x10 at the top), tone its threshold
//                   (how far past the fold it folds back), character its fracture (up to 8 stages)
//    bass amp       BassAmp: drive its high (the overdriven top), tone its dub (the bass bump),
//                   character its sub (a sub octave)
//    guitar amp     GrindAmp: a high-gain amp and a 4x12 cabinet; drive its gain, tone its tone
//    bitcrush       Beam (16-bit): drive its derez, 15 bits down to 3 (1 - 4^-drive), tone its
//                   focus
//    lo-fi sampler  BitGlitter: drive its glitter (a lower sample rate), tone the size of its
//                   quantizing steps (a quarter .. four times the original's, finer to the right)
//  BassAmp's left side mixes the right side's state into one of its filters; here each side
//  uses its own. BitGlitter's quantizer works out its steps directly instead of counting them,
//  and Beam keeps its history as a ring.

namespace porridge
{
    /// A biquad's coefficients, as Airwindows lays them out (y = a0 x + a1 x1 + a2 x2 - b1 y1 - b2 y2).
    struct Bq
    {
        float64 a0, a1, a2, b1, b2;
    }

    /// A lowpass at freq (a fraction of the rate) with resonance reso (0.7071: Butterworth).
    Bq lowpassBq (float64 freq, float64 reso)
    {
        let K = tan (pi * freq);
        let norm = 1.0 / (1.0 + K / reso + K * K);
        Bq b;
        b.a0 = K * K * norm;
        b.a1 = 2.0 * b.a0;
        b.a2 = b.a0;
        b.b1 = 2.0 * (K * K - 1.0) * norm;
        b.b2 = (1.0 - K / reso + K * K) * norm;
        return b;
    }

    /// A bandpass (Tape's head bump), with its a1 left at zero as Tape leaves it.
    Bq bandpassBq (float64 freq, float64 reso)
    {
        let K = tan (pi * freq);
        let norm = 1.0 / (1.0 + K / reso + K * K);
        Bq b;
        b.a0 = K / reso * norm;
        b.a2 = -b.a0;
        b.b1 = 2.0 * (K * K - 1.0) * norm;
        b.b2 = (1.0 - K / reso + K * K) * norm;
        return b;
    }

    /// A transposed biquad's state (Airwindows' "fixed" biquads).
    struct BqState
    {
        float64 s1, s2;
    }

    float64 bqRun (BqState& s, const Bq& b, float64 x)
    {
        let y = x * b.a0 + s.s1;
        s.s1 = x * b.a1 - y * b.b1 + s.s2;
        s.s2 = x * b.a2 - y * b.b2;
        return y;
    }

    /// A direct form I biquad's state (Mackity's).
    struct Df1State
    {
        float64 x1, x2, y1, y2;
    }

    float64 df1Run (Df1State& s, const Bq& b, float64 x)
    {
        let y = b.a0 * x + b.a1 * s.x1 + b.a2 * s.x2 - b.b1 * s.y1 - b.b2 * s.y2;
        s.x2 = s.x1;
        s.x1 = x;
        s.y2 = s.y1;
        s.y1 = y;
        return y;
    }

    /// Airwindows' xorshift noise, as a uint32 in an int64.
    void xorshift (int64& fpd)
    {
        fpd = fpd ^ ((fpd << 13) & u32);
        fpd = fpd ^ (fpd >> 17);
        fpd = fpd ^ ((fpd << 5) & u32);
    }

    float64 clip1 (float64 x)       { return clamp (x, -1.0, 1.0); }

    /// sin of |x|, at most 1 (at pi / 2), with x's sign
    float64 sineClip (float64 x)
    {
        let s = sin (min (abs (x), 1.57079633));
        return x > 0.0 ? s : -s;
    }

    /// Spiral, as Tape and BitGlitter use it: sin (x |x|) / |x|
    float64 spiral (float64 x)
    {
        let a = abs (x);
        return sin (x * a) / (a == 0.0 ? 1.0 : a);
    }

    //==============================================================================
    // the distortion's models

