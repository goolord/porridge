//  Envelopes, LFOs and the pitch envelope, as in Oatmeal.
//
//  Envelope parameters live in the program mirror as 16-float blocks (chunk offsets 8232 amp,
//  8300 filter, 9312 mod 1, 9408 mod 2): [0] kill ms (4.0), [1] attack, [2] hold, [3] decay 1,
//  [4] decay 2, [5] release, [6] release/2, [11] breakpoint, [13] sustain. Filter 2's envelope
//  is the filter's, at F_Speed. The derived coefficients are computed into EnvCoefs whenever a
//  parameter changes.
//
//  Porridge adds a curve to each stage (attack, decay 1, decay 2, release). It warps the stage's
//  progress along Oatmeal's path, so the stage keeps its end levels and its length: with
//  k = 8^curve, progress p becomes kp / (1 + (k - 1) p). 0 is Oatmeal's shape, positive curves
//  leave the start level faster (a slope k times Oatmeal's) and arrive slower, negative ones the
//  other way round. The decays and the release are exponential, so their progress is in dB.

namespace porridge
{
    struct EnvCoefs
    {
        float killDec, attInc, d1coef, d2coef, relCoef, bp, sus;
        int holdSamples;
        float kA, kD1, kD, kR;  // curve factors 8^curve (1: Oatmeal's); kD is decay 2's
    }

    /// attackSlot: the envelope's block, from its attack time (slot::Attack, F_Attack, M1_Attack, M2_Attack).
    /// curveSlot: its attack, decay 2 and release curves (slot::Curve_Amp_Attack ...); decay1CurveSlot:
    /// its decay 1 curve, which came later (slot::Curve_Amp_Decay1 ...).
    EnvCoefs makeEnvCoefs (const float[numSlots]& P, int attackSlot, int curveSlot, int decay1CurveSlot, float64 sr, float timeScale)
    {
        return makeEnvCoefsFrom (P, attackSlot, attackSlot + 1, attackSlot + 2, attackSlot + 3, attackSlot + 4,
                                 attackSlot + 10, attackSlot + 12, curveSlot, decay1CurveSlot, sr, timeScale);
    }

    /// The same from Porridge's own parameters (the oscillator envelopes), which aren't laid
    /// out as Oatmeal's blocks: each stage's slot, then the curves' as above.
    EnvCoefs makeEnvCoefsFrom (const float[numSlots]& P, int attackSlot, int holdSlot, int decay1Slot, int decay2Slot,
                               int releaseSlot, int breakpointSlot, int sustainSlot, int curveSlot, int decay1CurveSlot,
                               float64 sr, float timeScale)
    {
        EnvCoefs c;
        let kill    = 4.0 * float64 (timeScale);        // 'kill' fade time: always 4 ms in Oatmeal (not a parameter)
        let attack  = float64 (P.at (attackSlot) * timeScale);
        let hold    = float64 (P.at (holdSlot) * timeScale);
        let d1      = float64 (P.at (decay1Slot) * timeScale);
        let d2      = float64 (P.at (decay2Slot) * timeScale);
        let release = float64 (P.at (releaseSlot) * timeScale);
        var bp  = P.at (breakpointSlot);
        var sus = P.at (sustainSlot);

        if (bp  > 0.998f) bp  = 1.0f;
        if (sus > 0.998f) sus = 1.0f;

        c.bp = bp;
        c.sus = sus;
        c.killDec = float (1000.0 / (sr * max (kill, 1e-3)));
        c.attInc = float (1000.0 / (sr * max (attack, 1e-3)));
        c.holdSamples = int (hold * sr * 0.001 + 0.5);
        c.d1coef = float (pow (max (float64 (bp), 1e-6), 1.0 / max (sr * d1 * 0.001, 1.0)));
        c.d2coef = float (pow (max (float64 (sus) / max (float64 (bp), 1e-6), 1e-6), 1.0 / max (sr * d2 * 0.001, 1.0)));
        c.relCoef = float (pow (10.0, -3.0 / max (sr * release * 0.001, 1.0)));
        c.kA = curveFactor (P.at (curveSlot));
        c.kD1 = curveFactor (P.at (decay1CurveSlot));
        c.kD = curveFactor (P.at (curveSlot + 1));
        c.kR = curveFactor (P.at (curveSlot + 2));
        return c;
    }

    float curveFactor (float curve)         { return curve == 0 ? 1.0f : float (pow (8.0, float64 (curve))); }

    /// A stage's progress p (0..1) warped by its curve factor k; k = 1 leaves it as it is.
    float64 warp (float64 p, float64 k)     { return k * p / (1.0 + (k - 1.0) * p); }

    /// The length of an exponential path from one level to another (both above 0), in nepers.
    float64 span (float from, float to)     { return log (float64 (to) / float64 (from)); }

    /// A level on a stage's exponential path from `from`, `span` long, moved along the path by
    /// the stage's curve factor k: its progress in dB is warped.
    float warpPath (float L, float from, float64 span, float k)
    {
        if (k == 1.0f || span == 0)
            return L;

        let p = clamp (log (float64 (L) / float64 (from)) / span, 0.0, 1.0);
        return float (float64 (from) * exp (warp (p, float64 (k)) * span));
    }

    /// warpPath sample by sample through a stage whose level is multiplied by the same step
    /// every sample (the amp envelope's decays and release): the progress's log and the warped
    /// level's exp are moved on from the last sample's rather than worked out afresh. Exact to
    /// about 1e-13 (the step's rounding of the level is followed too); starts over on a new stage
    /// and with every renderAmp call.
    struct WarpTrack
    {
        int stage;          // the stage it follows (-1: none)
        float lastL;        // the level it last saw
        float64 logStep;    // log (step)
        float64 q;          // log (lastL / from)
        float64 x, e;       // the warped level's exponent (log (level / from)) and exp (x)
    }

    /// warpPath (L, from, span, k) for L the last call's times step (or a new stage's start).
    float warpPathTracked (WarpTrack& this, int stage, float L, float step, float from, float64 span, float k)
    {
        if (k == 1.0f || span == 0)
            return L;

        if (stage != this.stage)
        {
            this.stage = stage;
            this.logStep = log (float64 (step));
            this.q = log (float64 (L) / float64 (from));
            this.x = warp (clamp (this.q / span, 0.0, 1.0), float64 (k)) * span;
            this.e = exp (this.x);
        }
        else
        {
            // L = lastL * step, rounded to a float: the product is exact in float64, and the
            // rounding moves the log by log (1 + eps)
            let exact = float64 (this.lastL) * float64 (step);
            let eps = (float64 (L) - exact) / exact;
            this.q += this.logStep + eps * (1.0 - 0.5 * eps);
            let x = warp (clamp (this.q / span, 0.0, 1.0), float64 (k)) * span;
            let d = x - this.x;
            this.e = abs (d) > 0.03 ? exp (x)
                                    : this.e * (1.0 + d * (1.0 + d * 0.5 * (1.0 + d * (1.0 / 3.0) * (1.0 + d * 0.25 * (1.0 + d * 0.2)))));
            this.x = x;
        }

        this.lastL = L;
        return float (float64 (from) * this.e);
    }

    /// Envelope stages (Env.stage).
    namespace envStage
    {
        let off = 0;
        let kill = 1;           // the fade from the old level before a retriggered attack
        let attack = 2;
        let hold = 3;
        let decay1 = 4;         // to the breakpoint
        let decay2Down = 5;     // from the breakpoint down to the sustain level
        let decay2Up = 6;       // ... or up to it
        let sustain = 7;
        let release = 8;
    }

    struct Env
    {
        int stage;          // envStage
        float L, y, X, k;
        int holdCnt;
    }

    float envCubic (float64 L, float64 lo, float64 hi)
    {
        return float ((-2.0 * L * L * L + 3.0 * (lo + hi) * L * L - 6.0 * lo * hi * L + (lo + hi) * lo * hi)
                        / max ((hi - lo) * (hi - lo), 1e-8));
    }

    /// Where the stage's curve has moved L to on Oatmeal's path, which a release or a retrigger
    /// carries on from. The amp envelope (renderAmp) and the block ones (renderBlock) clamp the
    /// breakpoint and sustain levels differently.
    float curvedL (const Env& this, const EnvCoefs& c, bool blockEnv)
    {
        let bp = max (c.bp, blockEnv ? 1e-6f : 1e-4f);
        let sus = blockEnv ? max (c.sus, bp * 1e-6f) : max (c.sus, 1e-4f);

        if (this.stage == envStage::attack)                                             return float (warp (this.L, c.kA));
        if (this.stage == envStage::decay1)                                             return warpPath (this.L, 1.0f, span (1.0f, bp), c.kD1);
        if (this.stage == envStage::decay2Down || this.stage == envStage::decay2Up)     return warpPath (this.L, bp, span (bp, sus), c.kD);
        if (this.stage == envStage::release)                                            return warpPath (this.L, this.X, span (this.X, 0.001f), c.kR);
        return this.L;
    }

    /// fade: retrigger through the 'kill' fade, as the block envelopes do.
    void trigger (Env& this, const EnvCoefs& c, bool fade)
    {
        if (this.stage == envStage::off)
        {
            this.y = 0;
            this.L = 0;
        }
        else
        {
            this.L = this.curvedL (c, fade);

            if (this.stage == envStage::decay1)
                this.L = envCubic (this.L, c.bp, 1.0);
            else if (this.stage == envStage::decay2Down || this.stage == envStage::decay2Up)
                this.L = envCubic (this.L, c.sus, c.bp);
        }

        if (this.stage != envStage::off && this.stage != envStage::kill && this.stage != envStage::attack)
            this.L = this.L < 1e-5f ? 0.0f : (this.L > 0.99999f ? 1.0f : float (1.0 - sqrt (1.0 - float64 (this.L))));

        this.holdCnt = 0;
        this.stage = (fade && this.stage != envStage::off) ? envStage::kill : envStage::attack;

        // the attack's own progress that its curve moves to this level
        if (this.stage == envStage::attack)
            this.L = float (warp (this.L, 1.0 / float64 (c.kA)));
    }

    /// The stage after the attack (and hold): decay 1, or straight on to decay 2 or the sustain
    /// when the breakpoint (and the sustain level) are at the top.
    int stageAfterPeak (float bp, float sus)
    {
        return bp < 1.0f ? envStage::decay1 : (sus < 1.0f ? envStage::decay2Down : envStage::sustain);
    }

    /// The stage after decay 1: decay 2, the way to the sustain level, or the sustain.
    int stageAfterBreakpoint (float bp, float sus)
    {
        return bp < sus ? envStage::decay2Up : (bp > sus ? envStage::decay2Down : envStage::sustain);
    }

    /// Decay 2 follows the breakpoint and sustain levels when they move: its direction turns
    /// (or it ends) and the level stays between them.
    void settleDecay2 (Env& this, float bp, float sus)
    {
        if (this.stage == envStage::decay2Down)    { if (bp < sus) this.stage = envStage::decay2Up; else if (bp == sus) this.stage = envStage::sustain; }
        else if (this.stage == envStage::decay2Up) { if (bp > sus) this.stage = envStage::decay2Down; else if (bp == sus) this.stage = envStage::sustain; }

        if (this.stage == envStage::decay2Down) { if (this.L > bp) this.L = bp; else if (this.L < sus) this.L = sus; }
        if (this.stage == envStage::decay2Up)   { if (this.L < bp) this.L = bp; else if (this.L > sus) this.L = sus; }
    }

    void release (Env& this, const EnvCoefs& c, bool blockEnv)
    {
        if (blockEnv)
        {
            if (this.stage != envStage::off)
            {
                this.L = this.curvedL (c, true);
                this.stage = envStage::release;
                this.X = this.L;
            }

            return;
        }

        if (this.stage == envStage::off || this.stage >= envStage::release)
            return;

        this.L = this.curvedL (c, false);

        if (this.stage == envStage::kill || this.stage == envStage::attack)                 this.L = (2.0f - this.L) * this.L;
        else if (this.stage == envStage::decay1)                                            this.L = envCubic (this.L, c.bp, 1.0);
        else if (this.stage == envStage::decay2Down || this.stage == envStage::decay2Up)    this.L = envCubic (this.L, c.sus, c.bp);

        this.X = this.L;

        if (this.X <= 0.001f)
        {
            this.stage = envStage::off;
            return;
        }

        this.k = this.X / (this.X - 0.001f);
        this.stage = envStage::release;
    }

    /// The amp envelope's output smoothing coefficient (per sample).
    float ampSmoothing (float64 sr)     { return float (1.0 - pow (10.0, -1.0 / (sr * 0.0005))); }

    /// Amp envelope, per sample. Fills out[0..n); returns false once the envelope has ended.
    /// sm = ampSmoothing (sample rate).
    bool renderAmp (Env& this, const EnvCoefs& c, float speedIn, bool pedalDown, float sm, float[blockSize]& out, int n)
    {
        for (int i = 0; i < n; ++i)
            out.at (i) = 0;

        if (this.stage == envStage::off)
            return false;

        let speed = float64 (max (speedIn, 0.01f));
        let att = float (speed * float64 (c.attInc));
        let kill = float (speed * float64 (c.killDec));
        let bp = max (c.bp, 1e-4f);
        let sus = max (c.sus, 1e-4f);
        let relSpeed = pedalDown ? speed * 0.0078125 : speed;

        // the per-sample factors at this speed (x^1 is x: no pow at the usual speed of 1)
        let d1 = speed == 1.0 ? c.d1coef : float (pow (float64 (c.d1coef), speed));
        let d2 = speed == 1.0 ? c.d2coef : float (pow (float64 (c.d2coef), speed));
        let rel = relSpeed == 1.0 ? c.relCoef : float (pow (float64 (c.relCoef), relSpeed));
        let spanD1 = span (1.0f, bp);
        let spanD2 = span (bp, sus);
        let spanR = span (max (this.X, 0.001f), 0.001f);

        this.settleDecay2 (bp, sus);

        WarpTrack track;
        track.stage = -1;
        var i = 0;
        var guard = 0;

        while (i < n && guard < 4 * n)
        {
            ++guard;
            let s = this.stage;

            if (s == envStage::kill)
            {
                this.y += ((2.0f - this.L) * this.L - this.y) * sm;
                out.at (i) = this.y;
                this.L -= kill;
                if (this.L <= 0) { this.L = 0; this.stage = envStage::attack; continue; }
            }
            else if (s == envStage::attack)
            {
                let a = float (warp (this.L, c.kA));
                this.y += ((2.0f - a) * a - this.y) * sm;
                out.at (i) = this.y;
                this.L += att;

                if (this.L >= 1.0f)
                {
                    this.L = 1.0f;

                    if (c.holdSamples > 0)
                    {
                        this.stage = envStage::hold;
                        this.holdCnt = int (float64 (c.holdSamples) * speed);
                    }
                    else
                    {
                        this.stage = stageAfterPeak (bp, sus);
                    }

                    continue;
                }
            }
            else if (s == envStage::hold)
            {
                this.y += (this.L - this.y) * sm;
                out.at (i) = this.y;
                this.holdCnt -= 1;
                if (this.holdCnt < 0) { this.stage = stageAfterPeak (bp, sus); continue; }
            }
            else if (s == envStage::decay1)
            {
                this.y += (envCubic (track.warpPathTracked (s, this.L, d1, 1.0f, spanD1, c.kD1), bp, 1.0) - this.y) * sm;
                out.at (i) = this.y;
                this.L *= d1;
                if (this.L <= bp) { this.L = bp; this.stage = stageAfterBreakpoint (bp, sus); continue; }
            }
            else if (s == envStage::decay2Down || s == envStage::decay2Up)
            {
                this.y += (envCubic (track.warpPathTracked (s, this.L, d2, bp, spanD2, c.kD), sus, bp) - this.y) * sm;
                out.at (i) = this.y;
                this.L *= d2;

                if (s == envStage::decay2Down ? this.L <= sus : this.L >= sus)
                {
                    this.L = sus;
                    this.stage = envStage::sustain;
                    continue;
                }
            }
            else if (s == envStage::sustain)
            {
                this.y += (this.L - this.y) * sm;
                out.at (i) = this.y;
                this.L = sus;

                if (this.y < 0.001f)
                {
                    this.L = 0;
                    this.stage = envStage::off;
                    return true;
                }
            }
            else if (s == envStage::release)
            {
                if (this.L > 0.001f)
                {
                    this.y += ((track.warpPathTracked (s, this.L, rel, this.X, spanR, c.kR) - 0.001f) * this.k - this.y) * sm;
                    this.L *= rel;
                }
                else
                {
                    this.L = 0;
                    this.y += (0.0f - this.y) * sm;
                }

                out.at (i) = this.y;

                if (this.y < 1e-6f)
                {
                    this.L = 0;
                    this.stage = envStage::off;
                    return true;
                }
            }
            else
            {
                return true;
            }

            ++i;
        }

        return true;
    }

    /// Block envelope (filter, mod and phantom envelopes): one update per block, returns the level
    /// after advancing n samples (0 if off).
    float renderBlock (Env& this, const EnvCoefs& c, float speedIn, bool pedalDown, int n)
    {
        if (this.stage == envStage::off)
            return 0.0f;

        let speed = max (speedIn, 0.01f);
        let bp = max (c.bp, 1e-6f);
        let sus = c.sus;
        let rel = pedalDown ? float (pow (float64 (c.relCoef), 0.0078125)) : c.relCoef;
        let s = float (n) * speed;

        this.settleDecay2 (bp, sus);

        if (this.stage == envStage::kill)
        {
            this.L -= s * c.killDec;
            if (this.L <= 0) { this.L = 0; this.stage = envStage::attack; }
        }

        if (this.stage == envStage::attack)
        {
            this.L += s * c.attInc;

            if (this.L >= 1.0f)
            {
                this.L = 1.0f;

                if (c.holdSamples > 0)
                {
                    this.stage = envStage::hold;
                    this.holdCnt = c.holdSamples;
                }
                else
                {
                    this.stage = stageAfterPeak (bp, sus);
                }
            }
        }

        if (this.stage == envStage::hold)
        {
            this.holdCnt -= max (int (float (n) * speed), 1);
            if (this.holdCnt < 0) this.stage = stageAfterPeak (bp, sus);
        }

        if (this.stage == envStage::decay1)
        {
            this.L *= float (pow (float64 (c.d1coef), float64 (s)));
            if (this.L <= bp) this.stage = stageAfterBreakpoint (bp, sus);
        }

        if (this.stage == envStage::decay2Down || this.stage == envStage::decay2Up)
        {
            this.L *= float (pow (float64 (c.d2coef), float64 (s)));
            if (this.stage == envStage::decay2Down ? this.L <= sus : this.L >= sus) { this.stage = envStage::sustain; this.L = sus; }
        }

        if (this.stage == envStage::sustain)
        {
            this.L = sus;
            if (sus < 0.001f) { this.L = 0; this.stage = envStage::off; }
        }

        if (this.stage == envStage::release)
        {
            this.L *= float (pow (float64 (rel), float64 (s)));
            if (this.L < 0.001f) { this.L = 0; this.stage = envStage::off; }
        }

        return this.curvedL (c, true);
    }

    float velScale (float vel, float vs)
    {
        if (vs > 0.001f)  return float (pow (float64 (vel), 2.0 * float64 (vs)));
        if (vs < -0.001f) return 1.0f + vel * vs;
        return 1.0f;
    }

    //==============================================================================
    struct LFO
    {
        int64 phase;        // uint32
        float prevR, curR;
        bool done;          // one-shot: the cycle has ended
    }

    /// The LFOs' parameters' slots, by LFO (0: LFO 1, 1: LFO 2). cross: how much the other
    /// LFO speeds this one up (LFO_2_1 for LFO 1, LFO_1_2 for LFO 2).
    namespace lfoSlot
    {
        let unit     = int[2] (slot::LFO_1_Unit,     slot::LFO_2_Unit);
        let shape    = int[2] (slot::LFO_1_Shape,    slot::LFO_2_Shape);
        let speed    = int[2] (slot::LFO_1_Speed,    slot::LFO_2_Speed);
        let quantize = int[2] (slot::LFO_1_Quantize, slot::LFO_2_Quantize);
        let sync     = int[2] (slot::LFO_1_Sync,     slot::LFO_2_Sync);
        let pitch    = int[2] (slot::LFO_1_Pitch,    slot::LFO_2_Pitch);
        let pan      = int[2] (slot::LFO_1_Pan,      slot::LFO_2_Pan);
        let cross    = int[2] (slot::LFO_2_1,        slot::LFO_1_2);
        let delay    = int[2] (slot::LFO_1_Delay,    slot::LFO_2_Delay);
        let fade     = int[2] (slot::LFO_1_Fade,     slot::LFO_2_Fade);
        let slew     = int[2] (slot::LFO_1_Slew,     slot::LFO_2_Slew);
        let steps    = int[2] (slot::LFO_1_Steps,    slot::LFO_2_Steps);
        let oneShot  = int[2] (slot::LFO_1_OneShot,  slot::LFO_2_OneShot);
    }

    /// Sample & hold: the LFO_n_Steps choices, in steps per cycle (0 = off).
    let lfoStepCounts = int[10] (0, 2, 3, 4, 6, 8, 12, 16, 24, 32);

    void resetPhase (LFO& this, Rand& rng, const float[numSlots]& P)
    {
        this.phase = rng.randomPhase (P[slot::LFOPhase], P[slot::LFOPhaseRand]);
        this.prevR = float (rng.next()) / 32768.0f;
        this.curR = float (rng.next()) / 32768.0f;
        this.done = false;
    }

    float64 lfoUnitBeats (int unit)
    {
        let beats = float64[15] (0.2, 1.0 / 6.0, 0.25, 0.4, 1.0 / 3.0, 0.5, 0.8, 2.0 / 3.0, 1.0, 1.6, 4.0 / 3.0, 2.0, 3.2, 8.0 / 3.0, 4.0);
        return beats.at (clamp (unit - 3, 0, 14));
    }

    /// Advances LFO `which` (0, 1) by nAdv samples (after speed modulation) and returns its value
    /// (0..1). xySpeed = the X/Y "LFO speed" sum for this LFO (quirk: LFO 2 also follows target 8).
    float step (LFO& this, const WaveTables& tables, Rand& rng, const float[numSlots]& P, const float[512]& userShape,
                int which, int nAdvIn, float xySpeed, float64 sr, float64 samplesPerBeat)
    {
        var nAdv = nAdvIn;

        if (abs (xySpeed) > 0.01f)
            nAdv = int (pow (2.0, 2.0 * float64 (xySpeed)) * float64 (nAdv) + 0.5);

        var speed = float64 (P.at (lfoSlot::speed.at (which)));

        if (P.at (lfoSlot::quantize.at (which)) != 0)
            speed = (3.0 * speed >= 2.0) ? floor (speed + 0.5) : 1.0 / floor (1.0 / speed + 0.5);

        let unit = int (P.at (lfoSlot::unit.at (which)));
        float64 period;

        if (unit == 0)      period = sr * speed * 0.001;
        else if (unit == 1) period = sr * speed * 0.01;
        else if (unit == 2) period = sr * speed;
        else                period = speed * samplesPerBeat * lfoUnitBeats (unit);

        let inc = int64 (two32 / max (period, 1e-9) + 0.5) & u32;
        let old = this.phase;
        let oneShot = P.at (lfoSlot::oneShot.at (which)) != 0;

        // one-shot (Porridge): one cycle from the phase it was reset to, then hold the end
        if (oneShot)
        {
            if (this.done || this.phase + inc * int64 (nAdv) > u32)
            {
                this.done = true;
                this.phase = u32;
            }
            else
            {
                this.phase = this.phase + inc * int64 (nAdv);
            }
        }
        else
        {
            this.phase = (this.phase + inc * int64 (nAdv)) & u32;
        }

        // sample & hold (Porridge): the shape read at the start of each of n steps per cycle
        let steps = lfoStepCounts.at (clamp (int (P.at (lfoSlot::steps.at (which))), 0, 9));
        let ph = steps > 0 ? int64 (float64 (int (float64 (this.phase) * float64 (steps) / two32)) * two32 / float64 (steps))
                           : this.phase;

        let shape = int (P.at (lfoSlot::shape.at (which)));

        if (shape == 4 || shape == 5)
        {
            if (old > this.phase)
            {
                this.prevR = this.curR;
                this.curR = float (rng.next()) / 32768.0f;
            }

            if (shape == 5)
                return this.curR;

            return float (float64 (this.prevR) + float64 (this.curR - this.prevR) * float64 (ph) * (1.0 / two32));
        }

        // A table's last interval interpolates towards the wrap guard (T[32768] = T[0], or the
        // user shape's (i+1)&511), i.e. back to the start of the cycle. A one-shot never wraps,
        // so it reads no further than the start of that interval: it ends on the last real value.
        if (shape == 6)
        {
            let p6 = oneShot ? min (ph, 0xff800000i64) : ph;
            let i = int (p6 >> 23);
            let f = float64 (p6 & 0x7fffff) * (1.0 / 8388608.0);
            let a = float64 (userShape.at (i & 511));
            return float (a + (float64 (userShape.at ((i + 1) & 511)) - a) * f);
        }

        let pt = oneShot ? min (ph, 0xfffe0000i64) : ph;
        let t = clamp (shape, 0, 3) * 32769;
        let i = int (pt >> 17);
        let f = float64 (pt & 0x1ffff) * (1.0 / 131072.0);
        let a = float64 (tables.lfo.at (t + i));
        return float (a + (float64 (tables.lfo.at (t + i + 1)) - a) * f);
    }

    //==============================================================================
    /// LFO 3 (LFO_3_*): a plain LFO only the modulation matrix reaches, run once per block.
    /// phase 0..1; the random shapes' last and next values.
    struct Lfo3
    {
        float64 phase;
        float prevR, nextR;
    }

    /// LFO_3_Sync's lengths in beats (0: free, at LFO_3_Rate Hz).
    let lfo3Beats = float64[13] (0.0, 16.0, 8.0, 4.0, 2.0, 4.0 / 3.0, 1.0, 2.0 / 3.0, 0.5, 1.0 / 3.0, 0.25, 1.0 / 6.0, 0.125);

    /// From its start phase (LFO_3_Phase, plus up to LFO_3_PhaseRand of a cycle at random).
    void resetLfo3 (Lfo3& this, Lcg& rng, const float[numSlots]& P)
    {
        let r = 0.5f + 0.5f * rng.nextSigned();
        this.phase = float64 (P[slot::LFO_3_Phase] + r * P[slot::LFO_3_PhaseRand]);
        this.phase -= floor (this.phase);
        this.prevR = rng.nextSigned();
        this.nextR = rng.nextSigned();
    }

    /// Advances n samples and returns the value, -1..1.
    float stepLfo3 (Lfo3& this, Lcg& rng, const float[numSlots]& P, float64 sr, float64 samplesPerBeat, int n)
    {
        let sync = clamp (int (P[slot::LFO_3_Sync]), 0, 12);
        let hz = 0.02 * pow (2500.0, float64 (clamp (P[slot::LFO_3_Rate], 0.0f, 1.0f)));
        let period = sync == 0 ? sr / hz : lfo3Beats.at (sync) * samplesPerBeat;
        this.phase += float64 (n) / max (period, 1.0);

        if (this.phase >= 1.0)
        {
            this.phase -= floor (this.phase);
            this.prevR = this.nextR;
            this.nextR = rng.nextSigned();
        }

        let p = float (this.phase);
        let shape = int (P[slot::LFO_3_Shape]);

        if (shape == 0) return float (sin (twoPi * this.phase));
        if (shape == 1) return p < 0.25f ? 4.0f * p : (p < 0.75f ? 2.0f - 4.0f * p : 4.0f * p - 4.0f);
        if (shape == 2) return 2.0f * p - 1.0f;
        if (shape == 3) return 1.0f - 2.0f * p;
        if (shape == 4) return p < 0.5f ? 1.0f : -1.0f;
        if (shape == 5) return this.prevR;

        let t = p * p * (3.0f - 2.0f * p);
        return this.prevR + (this.nextR - this.prevR) * t;
    }

    /// A connection's curve on its source's value: bent towards the ends (curve > 0) or towards 0
    /// (curve < 0), both ways alike (ModMatrix.curved).
    float modCurve (float x, float curve)
    {
        if (curve == 0)
            return x;

        let y = float (pow (float64 (abs (x)), pow (4.0, -float64 (curve))));
        return x < 0 ? -y : y;
    }

    //==============================================================================
    /// Pitch envelope constants (per block): start ratio S, peak Pk, sustain Su, attack step,
    /// decay and release multipliers.
    struct PitchEnvCoefs
    {
        float64 S, Pk, Su, att, dec, rel;
    }

    PitchEnvCoefs makePitchEnvCoefs (const float[numSlots]& P, float64 sr)
    {
        PitchEnvCoefs c;
        let oct = float64 (P[slot::Tune_Octave]);
        let start = P[slot::PEnv_Start];
        c.S  = start <= -48.0f ? 0.0 : float64 (float (pow (2.0, float64 (start) / 12.0)));
        c.Pk = float64 (float (pow (oct, float64 (P[slot::PEnv_Peak]) / 12.0)));
        c.Su = float64 (float (pow (oct, float64 (P[slot::PEnv_Sustain]) / 12.0)));
        c.att = float64 (float ((c.Pk - c.S) / (sr * float64 (P[slot::PEnv_Attack] * 0.001f))));
        c.dec = float64 (float (pow (c.Su / c.Pk, 1.0 / (sr * float64 (P[slot::PEnv_Decay] * 0.001f)))));
        c.rel = float64 (float (pow (oct, float64 (P[slot::PEnv_Release]) / (12.0 * sr))));
        return c;
    }

    /// Pitch envelope stages (Voice.penvStage).
    namespace penvStage
    {
        let off = 0;
        let toStart = 1;        // a retrigger's glide back to the start ratio
        let attack = 2;
        let decayDown = 5;      // to the sustain ratio, down or up
        let decayUp = 6;
        let sustain = 7;
        let release = 8;
    }

    /// Advances the pitch envelope state (ratio R, stage) by x = n * speed samples.
    void advancePitchEnv (float& R, int& stage, const PitchEnvCoefs& c, float64 x, float64 sr)
    {
        var r = float64 (R);

        if (stage == penvStage::off)
        {
            r = 0;
        }
        else if (stage == penvStage::toStart)
        {
            let stepAmt = x / (sr * 0.002);

            if (r < c.S)
            {
                r += stepAmt;
                if (r >= c.S) { r = c.S; stage = penvStage::attack; }
            }
            else
            {
                r -= stepAmt;
                if (r <= c.S) { r = c.S; stage = penvStage::attack; }
            }
        }
        else if (stage == penvStage::attack)
        {
            let next = c.Su <= c.Pk ? penvStage::decayDown : penvStage::decayUp;

            if (c.Pk > c.S)
            {
                r += r >= c.S ? x * c.att : (c.S - r + 1.0) * c.att * x / (c.Pk - c.S);
                if (r >= c.Pk) { r = c.Pk; stage = next; }
            }
            else
            {
                r += r <= c.S ? x * c.att : (r - c.S + 1.0) * x * c.att / (c.S - c.Pk + 0.001);
                r += x * c.att;
                if (r <= c.Pk) { r = c.Pk; stage = next; }
            }
        }
        else if (stage == penvStage::decayDown || stage == penvStage::decayUp)
        {
            r *= pow (c.dec, x);
            if (stage == penvStage::decayDown ? r <= c.Su : r >= c.Su) { r = c.Su; stage = penvStage::sustain; }
        }
        else if (stage == penvStage::sustain)
        {
            r = c.Su;
        }
        else if (stage == penvStage::release)
        {
            r *= pow (c.rel, x);
            if (r < 1e-4) { r = 0; stage = penvStage::off; }
            else if (r > 1048576.0) r = 1048576.0;
        }

        R = float (r);
    }

    //==============================================================================
    /// "dB-type" modulation factor used by amp and XY-depth targets.
    float dbFactor (float v, float d)
    {
        if (d > 0)
        {
            let a = float (pow (10.0, -3.0 * float64 (d)));
            return a + (1.0f - a) * v;
        }

        let a = float (pow (10.0, 3.0 * float64 (d)));
        return a + (1.0f - a) * (1.0f - v);
    }

    /// Aftertouch level control (oscillators, noise): at (0..1) cuts the level by up to
    /// 20 * depth dB, from full pressure down (depth > 0) or from none up (depth < 0).
    float aftertouchGain (float at, float depth)
    {
        if (depth > 0.01f)  return float (pow (10.0, float64 ((at - 1.0f) * depth * 0.05f)));
        if (depth < -0.01f) return float (pow (10.0, float64 (at * depth * 0.05f)));
        return 1.0f;
    }

    /// Constant-power pan gains: centre = (1, 1).
    float<2> panGains (float p)
    {
        let g = float (2.0 / sqrt (2.0 - 4.0 * float64 (p) * float64 (1.0f - p)));
        return float<2> ((1.0f - p) * g, p * g);
    }
}
