//  Small pieces shared by the effects and the voice filters: Simper's state-variable filter,
//  4-point Hermite interpolation and a one-pole lowpass coefficient; and the rack's pool, the
//  memory the effects with long lines share.

namespace porridge
{
    /// A stereo trapezoidal state-variable filter (Simper's): the crossovers' building block,
    /// and the algorithmic reverb's and the convolver's cuts.
    struct Svf
    {
        float<2> ic1, ic2;
    }

    /// An Svf's coefficients: g = tan (pi f / sr), k = 1 / Q.
    struct SvfCoefs
    {
        float g, k, a1, a2, a3;
    }

    SvfCoefs svfCoefs (float g, float k)
    {
        SvfCoefs c;
        c.g = g;
        c.k = k;
        c.a1 = 1.0f / (1.0f + g * (g + k));
        c.a2 = g * c.a1;
        c.a3 = g * c.a2;
        return c;
    }

    /// One sample through integrator states ic1, ic2 (one channel's, or a stereo pair's): the
    /// lowpass and bandpass outputs (highpass = x - k bp - lp).
    void svfTick<T> (T& ic1, T& ic2, const SvfCoefs& c, T x, T& lp, T& bp)
    {
        let v3 = x - ic2;
        let v1 = c.a1 * ic1 + c.a2 * v3;
        let v2 = ic2 + c.a2 * ic1 + c.a3 * v3;
        ic1 = 2.0f * v1 - ic1;
        ic2 = 2.0f * v2 - ic2;
        lp = v2;
        bp = v1;
    }

    void tick (Svf& this, const SvfCoefs& c, float<2> x, float<2>& lp, float<2>& bp)
    {
        svfTick (this.ic1, this.ic2, c, x, lp, bp);
    }

    /// The 2nd-order allpass with the same coefficients (the phase of a crossover's band sum).
    float<2> allpass (Svf& this, const SvfCoefs& c, float<2> x)
    {
        float<2> lp, bp;
        this.tick (c, x, lp, bp);
        return x - 2.0f * c.k * bp;
    }

    /// 4-point cubic (Catmull-Rom) interpolation between y1 (t = 0) and y2 (t = 1).
    T hermite<T> (T y0, T y1, T y2, T y3, float t)
    {
        let c1 = 0.5f * (y2 - y0);
        let c2 = y0 - 2.5f * y1 + 2.0f * y2 - 0.5f * y3;
        let c3 = 0.5f * (y3 - y0) + 1.5f * (y1 - y2);
        return ((c3 * t + c2) * t + c1) * t + y1;
    }

    //==============================================================================
    // The rack's pool: the memory of the effects with the longest lines (Oatmeal's delay and
    // reverb and their copies, the algo reverbs, the convolvers' tails and predelays, the
    // ambiences, the Bode shifters and the flangers), which each borrows while it is in the rack
    // (Synth's claimPool). The rack has eight slots, so at most eight of these 20 run at once:
    // the pool holds the eight largest together (8,048 blocks: Oatmeal's delay, both convolvers,
    // the other two delays and three algo reverbs) instead of all 20 (12,026 blocks), 16 MB less
    // per instance. It is made of blocks of 1024 floats, so that a sample's place is one shift
    // and two masks away, and a convolver's spectrum half is a whole block, whose
    // multiply-accumulates run as before. An effect's `fxAt` is its first block (-1: none); a
    // mono region runs through its blocks in turn, a stereo line alternates a block of each side.

    let fxPoolBlocks = 8192;    // a power of two: a block number wraps with a mask

    struct FxBlock
    {
        float[1024] v;
    }

    using FxPool = FxBlock[fxPoolBlocks];

    /// Blocks for n floats of a mono region, or n frames of a stereo line.
    int monoBlocks (int n)      { return (n + 1023) / 1024; }
    int stereoBlocks (int n)    { return 2 * monoBlocks (n); }

    /// Float i of a mono region.
    float poolGet (const FxPool& pool, int at, int i)
    {
        return pool.at (at + (i >> 10)).v[wrap<1024> (i)];
    }

    void poolSet (FxPool& pool, int at, int i, float x)
    {
        pool.at (at + (i >> 10)).v[wrap<1024> (i)] = x;
    }

    /// One side (0 left, 1 right) of frame i of a stereo line.
    float poolSide (const FxPool& pool, int at, int i, int side)
    {
        return pool.at (at + ((i >> 10) << 1) + side).v[wrap<1024> (i)];
    }

    void setPoolSide (FxPool& pool, int at, int i, int side, float x)
    {
        pool.at (at + ((i >> 10) << 1) + side).v[wrap<1024> (i)] = x;
    }

    float<2> poolFrame (const FxPool& pool, int at, int i)
    {
        let b = at + ((i >> 10) << 1);
        let k = wrap<1024> (i);
        return float<2> (pool.at (b).v[k], pool.at (b + 1).v[k]);
    }

    void setPoolFrame (FxPool& pool, int at, int i, float<2> x)
    {
        let b = at + ((i >> 10) << 1);
        let k = wrap<1024> (i);
        pool.at (b).v[k] = x[0];
        pool.at (b + 1).v[k] = x[1];
    }

    //==============================================================================
    // Delay lines laid out in a mono region of the pool: the algorithmic reverb's (Space.cmajor)
    // and the ambience's (Ambience.cmajor). Lines is a struct with its region (`fxAt`), whether
    // the region is known to be all zeros (`clean`), and per line its start in the region
    // (`base`), its capacity (`cap`) and its write index (`wp`).

    /// Lays line j out at top (moved on past it), empty, with room for `capacity` samples.
    void poolLine<Lines> (Lines& this, int j, int capacity, int& top)
    {
        this.base.at (j) = top;
        this.cap.at (j) = capacity;
        this.wp.at (j) = 0;
        top += capacity;
    }

    /// Clears the lines just laid out (below top), unless the region is still all zeros.
    void clearPool<Lines> (Lines& this, FxPool& pool, int top)
    {
        if (! this.clean)
            for (int i = 0; i < top; ++i)
                poolSet (pool, this.fxAt, i, 0);

        this.clean = false;
    }

    void poolWrite<Lines> (const Lines& this, FxPool& pool, int j, float x)
    {
        let k = this.fxAt * 1024 + this.base.at (j) + this.wp.at (j);
        pool.at (k >> 10).v.at (k) = x;
    }

    /// Moves line j's write index on a sample.
    void poolAdvance<Lines> (Lines& this, int j)
    {
        let w = this.wp.at (j) + 1;
        this.wp.at (j) = w >= this.cap.at (j) ? 0 : w;
    }

    /// Line j `delay` samples back (>= 1 when read before the write), linearly interpolated.
    float poolReadLin<Lines> (const Lines& this, const FxPool& pool, int j, float64 delay)
    {
        let di = int (delay);
        let f = float (delay - float64 (di));
        let c = this.cap.at (j);
        let b = this.base.at (j);
        var i = this.wp.at (j) - di;
        if (i < 0) i += c;
        let o = this.fxAt * 1024 + b;
        let kn = o + i, ko = o + (i == 0 ? c - 1 : i - 1);
        let newer = pool.at (kn >> 10).v.at (kn);
        let older = pool.at (ko >> 10).v.at (ko);
        return newer + f * (older - newer);
    }

    /// The equal-power dry/wet mix's gains at mix 0..1 (the reverb's and the ambience's).
    float mixDry (float mix)    { return float (cos (float64 (mix) * pi * 0.5)); }
    float mixWet (float mix)    { return float (sin (float64 (mix) * pi * 0.5)); }

    /// The coefficient of a one-pole lowpass at hz (kept below 0.45 sr): y += a (x - y).
    float onePoleCoef (float64 hz, float64 sr)
    {
        return float (1.0 - exp (-2.0 * pi * min (hz, 0.45 * sr) / sr));
    }

    /// ITU-R BS.1770's K-weighting, for one channel: a high shelf of +4 dB from about 1.7 kHz,
    /// then a highpass at 38 Hz (as pyloudnorm designs them at any rate). What a loudness meter
    /// hears: the level the view sets random patches by (ui/random/RandomDrawer.res).
    struct KWeighting
    {
        float64[5] shelf, high;                 // b0, b1, b2, a1, a2
        float64[2] shelfState, highState;
    }

    KWeighting makeKWeighting (float64 sr)
    {
        KWeighting k;
        let A = pow (10.0, 3.99984385397 / 40.0);
        let w = 2.0 * pi * 1681.974450955533 / sr;
        let alpha = sin (w) / (2.0 * 0.7071752369554193);
        let c = cos (w);
        let s = 2.0 * sqrt (A) * alpha;
        let a0 = (A + 1.0) - (A - 1.0) * c + s;
        k.shelf = float64[5] (A * ((A + 1.0) + (A - 1.0) * c + s) / a0, -2.0 * A * ((A - 1.0) + (A + 1.0) * c) / a0,
                              A * ((A + 1.0) + (A - 1.0) * c - s) / a0, 2.0 * ((A - 1.0) - (A + 1.0) * c) / a0,
                              ((A + 1.0) - (A - 1.0) * c - s) / a0);
        let w2 = 2.0 * pi * 38.13547087613982 / sr;
        let alpha2 = sin (w2) / (2.0 * 0.5003270373253953);
        let c2 = cos (w2);
        let b0 = (1.0 + alpha2);
        k.high = float64[5] ((1.0 + c2) / 2.0 / b0, -(1.0 + c2) / b0, (1.0 + c2) / 2.0 / b0, -2.0 * c2 / b0, (1.0 - alpha2) / b0);
        return k;
    }

    float64 biquad (const float64[5]& f, float64[2]& z, float64 x)
    {
        let y = f[0] * x + z[0];
        z[0] = f[1] * x - f[3] * y + z[1];
        z[1] = f[2] * x - f[4] * y;
        return y;
    }

    float64 kWeight (KWeighting& k, float64 x)
    {
        return biquad (k.high, k.highState, biquad (k.shelf, k.shelfState, x));
    }
}
