//  Porridge's extra rack effects: flanger, phaser, frequency shifter (Bode), utility, a voice
//  filter in the FX chain and a multiband compressor. Same conventions as Effects.cmajor: each
//  processes the synth's 64-frame stereo block in place, recomputes its coefficients from the
//  program mirror at the start of every block, smooths whatever would zipper, and reports
//  whether its output still holds sound.

namespace porridge
{
    //==============================================================================
    // shared pieces

    /// One-pole smoothing coefficient for a time constant of ms milliseconds, applied every
    /// `every` samples.
    float extraSmoothing (float64 sr, float64 ms, int every)
    {
        return float (1.0 - exp (-1000.0 * float64 (every) / (ms * sr)));
    }

    /// tan (pi hz / sr), with hz kept between 1 Hz and 0.45 sr.
    float extraPrewarp (float64 hz, float64 sr)
    {
        return float (tan (pi * clamp (hz, 1.0, 0.45 * sr) / sr));
    }

    /// Linear up to +-1, then bending smoothly towards +-2: bounds a feedback loop without
    /// colouring normal levels.
    float extraSoftClip (float x)
    {
        let a = abs (x);

        if (a <= 1.0f)
            return x;

        let y = 1.0f + tanh (a - 1.0f);
        return x < 0 ? -y : y;
    }

    float<2> extraSoftClip (float<2> x)
    {
        return float<2> (extraSoftClip (x[0]), extraSoftClip (x[1]));
    }

    float extraPeak (float<2> x)
    {
        return max (abs (x[0]), abs (x[1]));
    }

    //==============================================================================
    /// Svf coefficients (Common.cmajor) at hz.
    SvfCoefs extraSvfCoefs (float64 hz, float64 sr, float k)
    {
        return svfCoefs (extraPrewarp (hz, sr), k);
    }

    /// Butterworth damping: two in series make a Linkwitz-Riley crossover.
    let extraButterworthK = 1.41421356f;

    /// A stereo Linkwitz-Riley 4th-order crossover: low + high is the 2nd-order allpass of the
    /// same frequency, so the bands sum flat.
    struct ExtraCrossover
    {
        Svf lp1, lp2, hp1, hp2;
    }

    void split (ExtraCrossover& this, const SvfCoefs& c, float<2> x, float<2>& low, float<2>& high)
    {
        float<2> lp, bp;
        this.lp1.tick (c, x, lp, bp);
        this.lp2.tick (c, lp, low, bp);
        this.hp1.tick (c, x, lp, bp);
        let h = x - c.k * bp - lp;
        this.hp2.tick (c, h, lp, bp);
        high = h - c.k * bp - lp;
    }

    //==============================================================================
    /// Flanger: a cubic-interpolated delay swept on an exponential scale from Fl_Delay up to
    /// four octaves longer (at depth 1) by a sine LFO, the right side's LFO Fl_Phase degrees
    /// ahead; softly saturated feedback.
    let flangerLineSize = 65536;    // 341 ms at 192 kHz: 20 ms * 2^4 and the interpolator's taps

    /// Its line is a stereo line in the pool (FxPool) from block fxAt.
    struct Flanger
    {
        int fxAt;
        int pos;
        float64 phase;                      // LFO phase 0..1 (left)
        float delay, depth, fb, mix;        // smoothed: shortest delay (samples), depth, feedback, mix
        bool fresh, idle;
        int silentCount;                    // samples since a value above the threshold went into the line
    }

    void clearState (Flanger& this, FxPool& pool)
    {
        if (this.fxAt >= 0)
            for (int i = 0; i < flangerLineSize; ++i)
                setPoolFrame (pool, this.fxAt, i, float<2>());

        this.pos = 0;
        this.phase = 0;
        this.fresh = true;
        this.idle = true;
        this.silentCount = 0;
    }

    /// What the flanger's knobs ask for (the rack's and every voice's, VoiceFx.cmajor): the
    /// shortest delay (samples, at most longest / 16), depth, feedback, mix, the LFO's step per
    /// sample and the right side's phase offset (cycles). noteHz (0: none): the note the delay
    /// and the LFO's rate follow, by Fl_Track and Fl_RateTrack, from middle C. A tracked delay
    /// may reach as far as the sweep leaves room for (longest / 16 ^ depth), so that low notes'
    /// periods fit.
    struct FlangerTargets
    {
        float delay, depth, fb, mix;
        float64 inc, offset;
    }

    FlangerTargets flangerTargets (const float[numSlots]& P, float64 sr, float longest, float noteHz)
    {
        FlangerTargets t;
        t.depth = clamp (P[slot::Fl_Depth], 0.0f, 1.0f);
        var delay = expKnob (0.1f, 20.0f, P[slot::Fl_Delay]) * 0.001f * float (sr);
        var inc = float64 (expKnob (0.02f, 20.0f, P[slot::Fl_Rate])) / sr;

        if (noteHz > 0 && P[slot::Fl_Track] > 0)
        {
            delay *= float (pow (261.63 / float64 (noteHz), float64 (min (P[slot::Fl_Track], 1.0f))));
            t.delay = min (delay, longest / float (pow (16.0, float64 (t.depth))));
        }
        else
        {
            t.delay = min (delay, longest / 16.0f);
        }

        if (noteHz > 0 && P[slot::Fl_RateTrack] > 0)
            inc *= pow (float64 (noteHz) / 261.63, float64 (min (P[slot::Fl_RateTrack], 1.0f)));

        t.fb = clamp (P[slot::Fl_Feedback], -1.0f, 1.0f) * 0.97f;
        t.mix = clamp (P[slot::Fl_Mix], 0.0f, 1.0f);
        t.inc = inc;
        t.offset = float64 (clamp (P[slot::Fl_Phase], 0.0f, 180.0f)) / 360.0;
        return t;
    }

    /// The flanger's LFO and sweep through a block (the rack's and every voice's): a phasor
    /// turned by the LFO's step from the phase at the block's start (the right side's turned
    /// ahead by its offset), and each side's sweep factor exp (span lfo) moved on from the last
    /// sample's by the exponential of the difference, which is small. That spares a cos and an
    /// exp per sample and side; the block's first sample works the factors out afresh.
    struct FlangerSweep
    {
        float64 c, s, rc, rs, oc, os;       // the phasor, its turn per sample, the right side's offset
        float64 eL, eR;                     // the sweep factors
        float xL, xR;                       // and their exponents
        bool started;
    }

    FlangerSweep flangerSweep (float64 phase, float64 inc, float64 offset)
    {
        FlangerSweep w;
        w.c = cos (twoPi * phase); w.s = sin (twoPi * phase);
        w.rc = cos (twoPi * inc); w.rs = sin (twoPi * inc);
        w.oc = cos (twoPi * offset); w.os = sin (twoPi * offset);
        return w;
    }

    /// exp (x), from e = exp (x0): e times exp (x - x0), by its Taylor series while x - x0 is small.
    float64 expFrom (float64 e, float x, float x0)
    {
        let d = float64 (x) - float64 (x0);

        if (abs (d) > 0.03)
            return exp (float64 (x));

        return e * (1.0 + d * (1.0 + d * 0.5 * (1.0 + d * (1.0 / 3.0) * (1.0 + d * 0.25 * (1.0 + d * 0.2)))));
    }

    /// This sample's sweep factors per side: the delay is the shortest times these (span = 4 ln 2
    /// depth, an lfo of 0..1). The phasor turns on.
    float<2> next (FlangerSweep& this, float span)
    {
        let xL = span * (0.5f - 0.5f * float (this.c));
        let xR = span * (0.5f - 0.5f * float (this.c * this.oc - this.s * this.os));

        if (this.started)
        {
            this.eL = expFrom (this.eL, xL, this.xL);
            this.eR = expFrom (this.eR, xR, this.xR);
        }
        else
        {
            this.eL = exp (float64 (xL));
            this.eR = exp (float64 (xR));
            this.started = true;
        }

        this.xL = xL; this.xR = xR;
        let c1 = this.c * this.rc - this.s * this.rs;
        this.s = this.s * this.rc + this.c * this.rs;
        this.c = c1;
        return float<2> (float (this.eL), float (this.eR));
    }

    /// Channel ch of the line d samples back (d >= 2), cubic-interpolated.
    float flangerRead (const Flanger& this, const FxPool& pool, float d, int ch)
    {
        let di = int (d);
        let t = d - float (di);
        let m = flangerLineSize - 1;
        let p = this.pos - di;
        let at = this.fxAt;
        return hermite (poolSide (pool, at, (p + 1) & m, ch), poolSide (pool, at, p & m, ch),
                        poolSide (pool, at, (p - 1) & m, ch), poolSide (pool, at, (p - 2) & m, ch), t);
    }

    /// noteHz: the newest note's frequency (0 when none), for the tracking.
    bool process (Flanger& this, FxPool& pool, float<2>[blockSize]& buf, bool active, const float[numSlots]& P, float64 sr, float noteHz)
    {
        if (! active && this.idle)
            return false;

        let longest = float (flangerLineSize - 4);
        let t = flangerTargets (P, sr, longest, noteHz);
        let inc = t.inc, offset = t.offset;
        let k = extraSmoothing (sr, 20.0, 1);

        if (this.fresh)
        {
            this.fresh = false;
            this.delay = t.delay; this.depth = t.depth; this.fb = t.fb; this.mix = t.mix;
        }

        float written = 0;
        var sweep = flangerSweep (this.phase, inc, offset);

        for (wrap<blockSize> i)
        {
            this.delay += (t.delay - this.delay) * k;
            this.depth += (t.depth - this.depth) * k;
            this.fb += (t.fb - this.fb) * k;
            this.mix += (t.mix - this.mix) * k;

            // delay = shortest * 2^(4 depth lfo), lfo 0..1
            let e = sweep.next (4.0f * 0.693147181f * this.depth);
            let yL = this.flangerRead (pool, clamp (this.delay * e[0], 2.0f, longest), 0);
            let yR = this.flangerRead (pool, clamp (this.delay * e[1], 2.0f, longest), 1);
            let y = float<2> (yL, yR);
            let x = buf[i];

            let back = extraSoftClip (this.fb * y);
            let w = x + back + 1e-18f;      // the offset keeps the decaying loop off denormals
            setPoolFrame (pool, this.fxAt, this.pos, w);
            this.pos = (this.pos + 1) & (flangerLineSize - 1);
            written = max (written, extraPeak (w));

            // from mix 0.5 up the dry side is the line's input (with the feedback), so that
            // mix 0.5 cancels exactly, the deepest notches at any feedback
            buf[i] = (x + back * min (1.0f, 2.0f * this.mix)) * (1.0f - this.mix) + y * this.mix;

            this.phase += inc;
            if (this.phase >= 1.0) this.phase -= 1.0;
        }

        if (stillSounding (this.idle, this.silentCount, active || written > 1e-8f, active || anyAbove (buf, 1e-8f)))
            return true;

        // nothing audible went into the line for longer than its longest delay
        if (float (this.silentCount) > this.delay * 16.0f + float (blockSize))
            this.idle = true;

        return false;
    }

    //==============================================================================
    /// Phaser: 2..16 first-order allpasses swept +-3 octaves (at depth 1) around the centre by
    /// a sine LFO, the stages spread over up to +-1 octave, feedback from the chain's output
    /// to its input. Coefficients are computed at block ends and ramped per sample.
    struct Phaser
    {
        float<2>[16] s, a;                  // the stages' states and coefficients
        float<2> last;                      // the chain's previous output, for the feedback
        float64 phase;                      // LFO phase 0..1 (left)
        float centre, depth, spread;        // smoothed per block: ln (centre Hz), depth, spread
        float fb, mix;                      // smoothed per sample
        int stages;                         // last block's number of stages
        bool fresh, idle;
    }

    void clearState (Phaser& this)
    {
        for (wrap<16> k)
            this.s[k] = float<2> (0.0f, 0.0f);

        this.last = float<2> (0.0f, 0.0f);
        this.stages = 0;
        this.phase = 0;
        this.fresh = true;
        this.idle = true;
    }

    /// Ph_Stages' choice index -> number of stages.
    int phaserStages (int choice)
    {
        let n = int[6] (2, 4, 6, 8, 12, 16);
        return n.at (clamp (choice, 0, 5));
    }

    /// A first-order allpass coefficient: -90 degrees at hz.
    float phaserCoef (float64 hz, float64 sr)
    {
        let t = extraPrewarp (hz, sr);
        return (t - 1.0f) / (t + 1.0f);
    }

    /// What the phaser's knobs ask for (the rack's and every voice's, VoiceFx.cmajor): the
    /// number of stages, ln (centre Hz) (following noteHz by Ph_Track when `track`), depth,
    /// spread, feedback, mix, the LFO's rate (Hz, following noteHz by Ph_RateTrack when `track`)
    /// and the right side's phase offset (cycles).
    struct PhaserTargets
    {
        int stages;
        float centre, depth, spread, fb, mix, rate;
        float64 offset;
    }

    PhaserTargets phaserTargets (const float[numSlots]& P, float noteHz, bool track)
    {
        PhaserTargets t;
        t.stages = phaserStages (int (P[slot::Ph_Stages]));
        var centre = float64 (expKnob (20.0f, 20000.0f, P[slot::Ph_Freq]));

        if (track)
            centre *= pow (float64 (noteHz) / 261.63, float64 (clamp (P[slot::Ph_Track], 0.0f, 1.0f)));

        t.centre = float (log (clamp (centre, 1.0, 100000.0)));
        t.depth = clamp (P[slot::Ph_Depth], 0.0f, 1.0f);
        t.spread = clamp (P[slot::Ph_Spread], 0.0f, 1.0f);
        t.fb = clamp (P[slot::Ph_Feedback], -1.0f, 1.0f) * 0.95f;
        t.mix = clamp (P[slot::Ph_Mix], 0.0f, 1.0f);
        t.rate = expKnob (0.02f, 20.0f, P[slot::Ph_Rate]);

        if (track && P[slot::Ph_RateTrack] > 0)
            t.rate *= float (pow (float64 (noteHz) / 261.63, float64 (min (P[slot::Ph_RateTrack], 1.0f))));

        t.offset = float64 (clamp (P[slot::Ph_Phase], 0.0f, 180.0f)) / 360.0;
        return t;
    }

    /// noteHz: the newest note's frequency (0 when none), for the frequency tracking.
    bool process (Phaser& this, float<2>[blockSize]& buf, bool active, const float[numSlots]& P, float64 sr, float noteHz)
    {
        if (! active && this.idle)
            return false;

        let t = phaserTargets (P, noteHz, noteHz > 0);
        let n = t.stages;
        let tFb = t.fb, tMix = t.mix;
        let offset = t.offset;
        let kb = extraSmoothing (sr, 20.0, blockSize);
        let k = extraSmoothing (sr, 20.0, 1);
        let fresh = this.fresh;

        if (fresh)
        {
            this.fresh = false;
            this.centre = t.centre; this.depth = t.depth; this.spread = t.spread;
            this.fb = tFb; this.mix = tMix;
        }

        this.centre += (t.centre - this.centre) * kb;
        this.depth += (t.depth - this.depth) * kb;
        this.spread += (t.spread - this.spread) * kb;

        // the LFO at the end of this block sets the coefficients the block ramps to
        this.phase += float64 (t.rate) / sr * float64 (blockSize);
        this.phase -= floor (this.phase);
        let ln2 = 0.693147181;
        let sweepL = 3.0 * float64 (this.depth) * sin (twoPi * this.phase);
        let sweepR = 3.0 * float64 (this.depth) * sin (twoPi * (this.phase + offset));

        float<2>[16] da;

        for (wrap<16> s)
        {
            if (s >= n) break;

            let oct = float64 (this.spread) * (2.0 * float64 (s) / float64 (n - 1) - 1.0);
            let aL = phaserCoef (exp (float64 (this.centre) + ln2 * (sweepL + oct)), sr);
            let aR = phaserCoef (exp (float64 (this.centre) + ln2 * (sweepR + oct)), sr);

            if (fresh || s >= this.stages)
            {
                // a stage that comes in starts clean, at its coefficient
                this.a[s] = float<2> (aL, aR);
                this.s[s] = float<2> (0.0f, 0.0f);
            }

            da[s] = (float<2> (aL, aR) - this.a[s]) * (1.0f / float (blockSize));
        }

        this.stages = n;

        for (wrap<blockSize> i)
        {
            this.fb += (tFb - this.fb) * k;
            this.mix += (tMix - this.mix) * k;

            let x = buf[i];
            let back = extraSoftClip (this.fb * this.last);
            var v = x + back + 1e-18f;      // the offset keeps the decaying stages off denormals

            for (wrap<16> s)
            {
                if (s >= n) break;

                this.a[s] += da[s];
                let y = this.a[s] * v + this.s[s];
                this.s[s] = v - this.a[s] * y;
                v = y;
            }

            // from mix 0.5 up the dry side is the chain's input (with the feedback), so that
            // mix 0.5 cancels exactly, the deepest notches at any feedback
            this.last = v;
            buf[i] = (x + back * min (1.0f, 2.0f * this.mix)) * (1.0f - this.mix) + v * this.mix;
        }

        if (active || anyAbove (buf, 1e-8f))
        {
            this.idle = false;
            return true;
        }

        var state = extraPeak (this.last);

        for (wrap<16> s)
        {
            if (s >= n) break;
            state = max (state, extraPeak (this.s[s]));
        }

        if (state < 1e-8f)
            this.idle = true;

        return false;
    }

    //==============================================================================
    /// The frequency shifter (Bode), on the whole sound (here) and in every voice (VoiceFx.cmajor's
    /// laneBode), one design for both: an IIR Hilbert pair (two chains of 8 allpasses with a 90
    /// degree difference from 20 Hz to sr/2 - 20 Hz, designed for the sample rate) and a
    /// quadrature oscillator at Bd_Shift's Hz plus Bd_Ratio of a note (a voice's own; on the whole
    /// sound the newest), so that with a ratio the shifted partials keep their places relative to
    /// every note. The shift, mix and mode glide from piece to piece (the voices' laneGlide), the
    /// oscillator turning by a fixed step through each. On the whole sound, with feedback, the
    /// shifted signal also goes through a delay back into the shifter's input, so every echo is
    /// shifted further (a barber pole); a voice has no feedback.
    let bodeLineSize = 192004;      // 1 s at 192 kHz and the interpolator's taps
    let hilbertCoefs = 16;          // even ones: path A, odd ones: path B (one sample later)

    /// The Hilbert pair's coefficients for a transition band of `transition` (of sr) at both
    /// ends: the polyphase half-band design (elliptic) from Laurent de Soras's HIIR, whose
    /// allpasses in -z^-2 make a 90 degree phase splitter.
    float[hilbertCoefs] hilbertDesign (float64 sr)
    {
        float[hilbertCoefs] c;
        let transition = 20.0 / sr;
        let order = float64 (hilbertCoefs * 2 + 1);
        var kk = tan ((1.0 - transition * 2.0) * pi * 0.25);
        kk *= kk;
        let kksqrt = pow (1.0 - kk * kk, 0.25);
        let e = 0.5 * (1.0 - kksqrt) / (1.0 + kksqrt);
        let e4 = e * e * e * e;
        let q = e * (1.0 + e4 * (2.0 + e4 * (15.0 + 150.0 * e4)));

        for (wrap<hilbertCoefs> j)
        {
            let cj = float64 (j + 1);
            float64 num = 0, den = 0, sign = 1;

            for (int i = 0; i < 40; ++i)
            {
                let t = pow (q, float64 (i * (i + 1))) * sin (float64 (i * 2 + 1) * cj * pi / order) * sign;
                num += t;
                sign = -sign;
                if (abs (t) < 1e-100) break;
            }

            sign = -1;

            for (int i = 1; i < 40; ++i)
            {
                let t = pow (q, float64 (i * i)) * cos (float64 (i * 2) * cj * pi / order) * sign;
                den += t;
                sign = -sign;
                if (abs (t) < 1e-100) break;
            }

            let ww = num * pow (q, 0.25) / (den + 0.5);
            let wwsq = ww * ww;
            let x = sqrt ((1.0 - wwsq * kk) * (1.0 - wwsq / kk)) / (1.0 + wwsq);
            c[j] = float ((1.0 - x) / (1.0 + x));
        }

        return c;
    }

    /// One sample u through the Hilbert pair, on one side (T = float) or both (float<2>), with
    /// the allpasses' states (in z^-2) and path B's one-sample delay: a (path A) and b, 90 degrees
    /// behind it.
    void hilbertPair<T> (T[hilbertCoefs]& x1, T[hilbertCoefs]& x2, T[hilbertCoefs]& y1, T[hilbertCoefs]& y2, T& prev,
                         const float[hilbertCoefs]& c, T u, T& a, T& b)
    {
        a = u;
        b = prev;
        prev = u;

        for (wrap<hilbertCoefs / 2> j)
        {
            let ja = wrap<hilbertCoefs> (2 * j), jb = wrap<hilbertCoefs> (2 * j + 1);
            let ya = c[ja] * (a + y2[ja]) - x2[ja];
            x2[ja] = x1[ja]; x1[ja] = a; y2[ja] = y1[ja]; y1[ja] = ya;
            a = ya;
            let yb = c[jb] * (b + y2[jb]) - x2[jb];
            x2[jb] = x1[jb]; x1[jb] = b; y2[jb] = y1[jb]; y1[jb] = yb;
            b = yb;
        }
    }

    /// The shift a block (or piece) aims at: Bd_Shift's knob (-1..1) cubed, times 5 kHz, and
    /// Bd_Ratio's cubed, times 2, of the note (0: none).
    float bodeTargetHz (const float[numSlots]& P, float noteHz)
    {
        let v = clamp (P[slot::Bd_Shift], -1.0f, 1.0f);
        let r = clamp (P[slot::Bd_Ratio], -1.0f, 1.0f);
        return noteHz * (2.0f * r * r * r) + 5000.0f * v * v * v;
    }

    /// Each side's way for Bd_Mode: 1 up, -1 down, 0 both (ring: the mean of up and down).
    float<2> bodeSides (const float[numSlots]& P)
    {
        let mode = int (P[slot::Bd_Mode]);
        return mode == bodeMode::down   ? float<2> (-1.0f, -1.0f)
             : mode == bodeMode::stereo ? float<2> (1.0f, -1.0f)
             : mode == bodeMode::ring   ? float<2> (0.0f, 0.0f)
                                        : float<2> (1.0f, 1.0f);
    }

    /// The oscillator through a piece of n samples whose shift glides from hz0 to hz1: it turns
    /// by a fixed step (at their mean) from the phase at the piece's start. Sets the phasor's
    /// start (pc, ps) and step (rc, rs), and moves the phase (0..1) on to the piece's end.
    void bodeTurn (float64& phase, float hz0, float hz1, int n, float64 sr, float64& pc, float64& ps, float64& rc, float64& rs)
    {
        let hz = float64 (0.5f * (hz0 + hz1));
        let turn = twoPi * hz / sr;
        rc = cos (turn);
        rs = sin (turn);
        pc = cos (twoPi * phase);
        ps = sin (twoPi * phase);
        phase += hz * float64 (n) / sr;
        phase -= floor (phase);
    }

    /// On the whole sound. Its feedback delay is a stereo line in the pool (FxPool) from block fxAt.
    struct Bode
    {
        int fxAt;
        int pos;
        float[hilbertCoefs] c;
        float64 designRate;                         // the rate c was designed for
        float<2>[hilbertCoefs] x1, x2, y1, y2;      // the allpasses' states (in z^-2)
        float<2> prev;                              // path B's one-sample delay
        float<2> hpX, hpY;                          // the feedback's DC blocker
        float64 phase;                              // oscillator phase 0..1
        float hz, mix;                              // gliding per block: shift, mix
        float<2> side;                              // and per side: 1 up, -1 down, 0 both (ring)
        float fb, delay;                            // smoothed per sample: feedback, delay (samples)
        bool fresh, idle;
        int silentCount;
    }

    void clearState (Bode& this, FxPool& pool)
    {
        if (this.fxAt >= 0)
            for (int i = 0; i < bodeLineSize; ++i)
                setPoolFrame (pool, this.fxAt, i, float<2>());

        for (wrap<hilbertCoefs> j)
        {
            this.x1[j] = float<2> (0.0f, 0.0f); this.x2[j] = float<2> (0.0f, 0.0f);
            this.y1[j] = float<2> (0.0f, 0.0f); this.y2[j] = float<2> (0.0f, 0.0f);
        }

        this.pos = 0;
        this.prev = float<2> (0.0f, 0.0f);
        this.hpX = float<2> (0.0f, 0.0f);
        this.hpY = float<2> (0.0f, 0.0f);
        this.phase = 0;
        this.fresh = true;
        this.idle = true;
        this.silentCount = 0;
    }

    /// The line's value d samples back (d >= 2), cubic-interpolated.
    float<2> bodeRead (const Bode& this, const FxPool& pool, float d)
    {
        let di = int (d);
        let t = d - float (di);
        let at = this.fxAt;
        var p = this.pos - di - 2;
        if (p < 0) p += bodeLineSize;
        let y3 = poolFrame (pool, at, p);
        p = p + 1 >= bodeLineSize ? 0 : p + 1;
        let y2 = poolFrame (pool, at, p);
        p = p + 1 >= bodeLineSize ? 0 : p + 1;
        let y1 = poolFrame (pool, at, p);
        p = p + 1 >= bodeLineSize ? 0 : p + 1;
        return hermite (poolFrame (pool, at, p), y1, y2, y3, t);
    }

    /// noteHz: the newest note (0: none), which Bd_Ratio follows; glide: laneGlide for a block.
    bool process (Bode& this, FxPool& pool, float<2>[blockSize]& buf, bool active, const float[numSlots]& P, float64 sr,
                  float noteHz, float glide)
    {
        if (! active && this.idle)
            return false;

        if (this.designRate != sr)
        {
            this.c = hilbertDesign (sr);
            this.designRate = sr;
        }

        let tHz = bodeTargetHz (P, noteHz);
        let tFb = clamp (P[slot::Bd_Feedback], 0.0f, 1.0f) * 0.95f;
        let tMix = clamp (P[slot::Bd_Mix], 0.0f, 1.0f);
        let tDelay = clamp (expKnob (1.0f, 1000.0f, P[slot::Bd_Delay]) * 0.001f * float (sr), 2.0f, float (bodeLineSize - 4));
        let tSide = bodeSides (P);
        let k = extraSmoothing (sr, 20.0, 1);
        let kd = extraSmoothing (sr, 60.0, 1);         // delay changes glide like tape
        let hpR = float (1.0 - twoPi * 10.0 / sr);     // the feedback's DC blocker at 10 Hz

        if (this.fresh)
        {
            this.fresh = false;
            this.hz = tHz; this.fb = tFb; this.mix = tMix; this.delay = tDelay;
            this.side = tSide;
        }

        let hz0 = this.hz, mix0 = this.mix, side0 = this.side;
        this.hz += (tHz - this.hz) * glide;
        this.mix += (tMix - this.mix) * glide;
        this.side += (tSide - this.side) * glide;
        float64 pc, ps, rc, rs;
        bodeTurn (this.phase, hz0, this.hz, blockSize, sr, pc, ps, rc, rs);
        let step = 1.0f / float (blockSize);
        float written = 0;

        for (wrap<blockSize> i)
        {
            let f = float (i + 1) * step;
            let mix = mix0 + (this.mix - mix0) * f;
            let side = side0 + (this.side - side0) * f;
            this.fb += (tFb - this.fb) * k;
            this.delay += (tDelay - this.delay) * kd;

            let x = buf[i];
            var u = x + 1e-18f;     // the offset keeps the decaying allpasses off denormals

            if (this.fb > 1e-6f)
            {
                let back = this.bodeRead (pool, this.delay);
                let h = back - this.hpX + hpR * this.hpY;
                this.hpX = back;
                this.hpY = h;
                u += extraSoftClip (this.fb * h);
            }

            float<2> a, b;
            hilbertPair (this.x1, this.x2, this.y1, this.y2, this.prev, this.c, u, a, b);

            let cs = float (pc);
            let sn = float (ps);
            let c1 = pc * rc - ps * rs;
            ps = ps * rc + pc * rs;
            pc = c1;

            // up: b cos + a sin, down: b cos - a sin, ring: their mean (b cos); the mode's
            // sign glides so that switching modes doesn't click
            let wet = b * cs + a * sn * side;
            setPoolFrame (pool, this.fxAt, this.pos, wet);
            this.pos = this.pos + 1 >= bodeLineSize ? 0 : this.pos + 1;
            written = max (written, extraPeak (wet));

            buf[i] = x + (wet - x) * mix;
        }

        if (stillSounding (this.idle, this.silentCount, active || written > 1e-8f, active || anyAbove (buf, 1e-8f)))
            return true;

        // the Hilbert filters' ringing, and the echoes while the feedback is up
        let tail = float (sr) * 0.1f + (this.fb > 1e-6f ? this.delay : 0.0f);

        if (float (this.silentCount) > tail)
            this.idle = true;

        return false;
    }

    //==============================================================================
    /// Utility: swap, phase inversion, mid/side width, bass mono below a Linkwitz-Riley
    /// crossover, balance and gain, in that order; every gain glides per sample.
    struct Utility
    {
        ExtraCrossover xo;
        float swap, invL, invR, width, bass, panL, panR, gain;     // smoothed
        float hz;                                                   // the crossover, ln (Hz), per block
        bool fresh, idle;
        int silentCount;
    }

    void clearState (Utility& this)
    {
        this.xo = ExtraCrossover();
        this.fresh = true;
        this.idle = true;
        this.silentCount = 0;
    }

    /// What the utility's knobs ask for (the rack's and every voice's, VoiceFx.cmajor), apart
    /// from bass mono: gain, each side's balance gain, width, each side's sign, the swap.
    struct UtilityTargets
    {
        float gain, panL, panR, width, invL, invR;
        bool swap;
    }

    UtilityTargets utilityTargets (const float[numSlots]& P)
    {
        UtilityTargets t;
        let pan = clamp (P[slot::Ut_Pan], -1.0f, 1.0f);
        t.panL = min (1.0f, 1.0f - pan);
        t.panR = min (1.0f, 1.0f + pan);
        t.gain = float (pow (10.0, float64 (clamp (P[slot::Ut_Gain], -48.0f, 24.0f)) * 0.05));
        t.width = clamp (P[slot::Ut_Width], 0.0f, 2.0f);
        t.invL = P[slot::Ut_InvL] != 0 ? -1.0f : 1.0f;
        t.invR = P[slot::Ut_InvR] != 0 ? -1.0f : 1.0f;
        t.swap = P[slot::Ut_Swap] != 0;
        return t;
    }

    bool process (Utility& this, float<2>[blockSize]& buf, bool active, const float[numSlots]& P, float64 sr)
    {
        if (! active && this.idle)
            return false;

        let t = utilityTargets (P);
        let tSwap = t.swap ? 1.0f : 0.0f;
        let tInvL = t.invL, tInvR = t.invR, tWidth = t.width;
        let bassV = P[slot::Ut_BassMono];
        let tBass = bassV > 0 ? 1.0f : 0.0f;
        let tPanL = t.panL, tPanR = t.panR, tGain = t.gain;
        let k = extraSmoothing (sr, 20.0, 1);
        let tHz = bassV > 0 ? float (log (float64 (expKnob (20.0f, 1000.0f, bassV)))) : this.hz;

        if (this.fresh)
        {
            this.fresh = false;
            this.swap = tSwap; this.invL = tInvL; this.invR = tInvR; this.width = tWidth;
            this.bass = tBass; this.panL = tPanL; this.panR = tPanR; this.gain = tGain;
            this.hz = bassV > 0 ? tHz : float (log (100.0));
        }

        this.hz += (tHz - this.hz) * extraSmoothing (sr, 20.0, blockSize);

        // the crossover runs while bass mono is on or fading
        let bassOn = tBass > 0 || this.bass > 1e-5f;
        let c = extraSvfCoefs (exp (float64 (this.hz)), sr, extraButterworthK);

        for (wrap<blockSize> i)
        {
            this.swap += (tSwap - this.swap) * k;
            this.invL += (tInvL - this.invL) * k;
            this.invR += (tInvR - this.invR) * k;
            this.width += (tWidth - this.width) * k;
            this.bass += (tBass - this.bass) * k;
            this.panL += (tPanL - this.panL) * k;
            this.panR += (tPanR - this.panR) * k;
            this.gain += (tGain - this.gain) * k;

            let x0 = buf[i];
            var x = x0 + (float<2> (x0[1], x0[0]) - x0) * this.swap;
            x *= float<2> (this.invL, this.invR);

            let mid = 0.5f * (x[0] + x[1]);
            let side = 0.5f * (x[0] - x[1]) * this.width;
            x = float<2> (mid + side, mid - side);

            if (bassOn)
            {
                float<2> low, high;
                this.xo.split (c, x, low, high);
                let m = 0.5f * (low[0] + low[1]);
                x += (float<2> (m, m) + high - x) * this.bass;
            }

            buf[i] = x * float<2> (this.panL, this.panR) * this.gain;
        }

        // fully faded out: forget the crossover's state so that it starts clean next time
        if (tBass == 0 && this.bass < 1e-5f)
        {
            this.bass = 0;
            this.xo = ExtraCrossover();
        }

        if (stillSounding (this.idle, this.silentCount, active || anyAbove (buf, 1e-8f)))
            return true;

        if (float (this.silentCount) > float (sr) * 0.1f)
            this.idle = true;

        return false;
    }

    //==============================================================================
    /// A voice filter (Filter.cmajor, any type) in the FX chain: one per side, the cutoffs
    /// spread apart by Ff_Spread semitones, with a dry/wet mix, muted when it oscillates by
    /// itself after its input stops (autoMute).
    struct FilterFx
    {
        Filter left, right;
        float hz;                   // ln (cutoff Hz), smoothed per block
        float morph;                // smoothed per block too
        float mix;                  // smoothed per sample
        bool fresh, idle;
        int silentCount;

        // the auto-mute: samples into this tenth of a second of quiet input, the wet peaks of
        // this tenth and the last, tenths in a row the peak held up, whether it is fading the
        // wet out, and how far (0 .. 1, per sample)
        int quietCount, heldCount;
        float peak, lastPeak;
        bool muting;
        float muted;
    }

    void clearState (FilterFx& this)
    {
        this.left.clearState();
        this.right.clearState();
        this.fresh = true;
        this.idle = true;
        this.silentCount = 0;
        this.resetQuiet();
        this.muting = false;
        this.muted = 0.0f;
    }

    void resetQuiet (FilterFx& this)
    {
        this.quietCount = 0;
        this.heldCount = 0;
        this.peak = 0.0f;
        this.lastPeak = 0.0f;
    }

    /// The auto-mute. A filter oscillating by itself would go on for ever once its input stops:
    /// when the input has been quiet and the wet output's peak has held up (fallen by less than
    /// half a dB a second) for three tenths of a second in a row, this fades the wet out over
    /// 0.3 s, and it stays out until the input is back (process then restarts the filters).
    /// Tails that die away (resonance short of oscillating, the combs' and the reverb's echoes,
    /// the slowest falling about 2 dB a second) are left alone. l, r: the block's wet output.
    void autoMute (FilterFx& this, bool quiet, float[blockSize]& l, float[blockSize]& r, float64 sr)
    {
        if (! quiet)
        {
            this.resetQuiet();
            this.muting = false;
        }
        else if (! this.muting)
        {
            for (wrap<blockSize> i)
                this.peak = max (this.peak, max (abs (l[i]), abs (r[i])));

            this.quietCount += blockSize;

            if (float (this.quietCount) >= float (sr) * 0.1f)
            {
                let held = this.lastPeak > 0.0f && this.peak > 1e-6f && this.peak > this.lastPeak * 0.994f;
                this.heldCount = held ? this.heldCount + 1 : 0;
                this.lastPeak = this.peak;
                this.peak = 0.0f;
                this.quietCount = 0;
                this.muting = this.heldCount >= 3;
            }
        }

        if (! this.muting && this.muted <= 0.0f)
            return;

        // out over 0.3 s; back in over 10 ms when the input comes back in the middle of a fade
        let step = this.muting ? float (1.0 / (0.3 * sr)) : float (-1.0 / (0.01 * sr));

        for (wrap<blockSize> i)
        {
            this.muted = clamp (this.muted + step, 0.0f, 1.0f);
            l[i] *= 1.0f - this.muted;
            r[i] *= 1.0f - this.muted;
        }
    }

    /// noteHz: the newest note's frequency (0 when none), for the note tracking.
    bool process (FilterFx& this, const FxTables& tables, float<2>[blockSize]& buf, bool active,
                  const float[numSlots]& P, float64 sr, float noteHz)
    {
        if (! active && this.idle)
            return false;

        let t = int (P[slot::Ff_Type]);

        if (t <= filterType::off)
            return active;

        var cutoff = float64 (expKnob (20.0f, 20000.0f, P[slot::Ff_Cutoff]));

        if (noteHz > 0 && P[slot::Ff_Track] > 0)
            cutoff = clamp (cutoff * pow (float64 (noteHz) / 261.63, float64 (min (P[slot::Ff_Track], 1.0f))), 5.0, 40000.0);

        let tHz = float (log (cutoff));
        let tMix = clamp (P[slot::Ff_Mix], 0.0f, 1.0f);
        let tMorph = clamp (P[slot::Ff_Morph], 0.0f, 1.0f);

        if (this.fresh)
        {
            this.fresh = false;
            this.hz = tHz;
            this.mix = tMix;
            this.morph = tMorph;
        }

        let kb = extraSmoothing (sr, 10.0, blockSize);
        this.hz += (tHz - this.hz) * kb;
        this.morph += (tMorph - this.morph) * kb;

        let spread = clamp (P[slot::Ff_Spread], -24.0f, 24.0f) * (0.693147181f / 24.0f);
        let res = clamp (P[slot::Ff_Resonance], 0.0f, 1.0f);
        let drive = clamp (P[slot::Ff_Drive], 0.0f, 1.0f);

        float[blockSize] l, r;
        var inPeak = 0.0f;

        for (wrap<blockSize> i)
        {
            l[i] = buf[i][0];
            r[i] = buf[i][1];
            inPeak = max (inPeak, max (abs (l[i]), abs (r[i])));
        }

        // quiet: below -80 dB. Back after the auto-mute's silence, the filters start afresh.
        let quiet = inPeak <= 1e-4f;

        if (! quiet && this.muted >= 1.0f)
        {
            this.left.clearState();
            this.right.clearState();
            this.muted = 0.0f;
        }

        this.left.process (tables, t, exp (this.hz - spread), res, this.morph, drive, sr, l, blockSize);
        this.right.process (tables, t, exp (this.hz + spread), res, this.morph, drive, sr, r, blockSize);
        this.autoMute (quiet, l, r, sr);

        let k = extraSmoothing (sr, 20.0, 1);

        for (wrap<blockSize> i)
        {
            this.mix += (tMix - this.mix) * k;
            let x = buf[i];
            buf[i] = x + (float<2> (l[i], r[i]) - x) * this.mix;
        }

        // resonant types ring and the comb types echo: a quarter second of silence
        if (stillSounding (this.idle, this.silentCount, active || anyAbove (buf, 1e-8f)))
            return true;

        if (float (this.silentCount) > float (sr) * 0.25f)
            this.idle = true;

        return false;
    }

    //==============================================================================
    /// Multiband compressor (OTT / Dynastia style), single band or three (Linkwitz-Riley
    /// 4th-order crossovers, the low band allpassed to match the high crossover's phase so that
    /// the bands sum flat). Per band: downward compression above its threshold and upward below
    /// its upward threshold (6 dB soft knees), a stereo-linked peak detector, a trim and an on
    /// switch. Cp_Depth scales every gain change; Cp_Mix blends with the dry input. No lookahead.
    struct Compressor
    {
        ExtraCrossover lowX, highX;
        Svf lowAp;                          // the low band's allpass at the high split
        float[3] env, meter;                // per band (low, mid, high): the detector, the meter (linear peak)

        // meters for the view, per band, updated every block (single band: index 1, the
        // others -120 / 0): the band's level after the input gain, and its gain change
        // (after the depth, before the trim), in dB
        float[3] levelDb, gainDb;

        // smoothed per band: threshold, 1 / ratio - 1, upward threshold, 1 - 1 / upward ratio,
        // trim (linear, 0 when the band is off)
        float[3] threshold, downSlope, upThreshold, upSlope, trim;
        float inGain, outGain, depth, mix;  // smoothed
        float lowHz, highHz;                // ln (split Hz), smoothed per block
        bool fresh, idle;
        int silentCount;
    }

    void clearState (Compressor& this)
    {
        this.lowX = ExtraCrossover();
        this.highX = ExtraCrossover();
        this.lowAp = Svf();

        for (wrap<3> j)
        {
            this.env[j] = 0;
            this.meter[j] = 0;
            this.levelDb[j] = -120.0f;
            this.gainDb[j] = 0;
        }

        this.fresh = true;
        this.idle = true;
        this.silentCount = 0;
    }

    /// The static curve: gain change in dB for a detector level in dB (downSlope = 1 / ratio - 1,
    /// upSlope = 1 - 1 / upward ratio).
    float compressorGain (float level, float threshold, float downSlope, float upThreshold, float upSlope)
    {
        let knee = 6.0f;
        float down = 0, up = 0;

        let over = level - threshold;
        if (over >= 0.5f * knee)        down = downSlope * over;
        else if (over > -0.5f * knee)   down = downSlope * (over + 0.5f * knee) * (over + 0.5f * knee) / (2.0f * knee);

        let under = upThreshold - level;
        if (under >= 0.5f * knee)       up = upSlope * under;
        else if (under > -0.5f * knee)  up = upSlope * (under + 0.5f * knee) * (under + 0.5f * knee) / (2.0f * knee);

        // the boost bends over above 24 dB towards at most 30, and fades out from -90 to -100
        // dBFS so that noise floors stay down
        if (up > 24.0f)
            up = 24.0f + 6.0f * tanh ((up - 24.0f) / 6.0f);

        up *= clamp ((level + 100.0f) * 0.1f, 0.0f, 1.0f);
        return down + up;
    }

    /// Band j's detector, meter and gain (meterRel: the meter's release per sample); returns
    /// the band compressed and trimmed.
    float<2> compressBand (Compressor& this, wrap<3> j, float<2> x, float att, float rel, float meterRel)
    {
        let e = extraPeak (x);
        let env = this.env[j];
        this.env[j] = env + (e - env) * (e > env ? att : rel);
        this.meter[j] = max (e, this.meter[j] * meterRel);
        let level = 20.0f * float (log10 (float64 (this.env[j]) + 1e-30));
        let g = this.depth * compressorGain (level, this.threshold[j], this.downSlope[j], this.upThreshold[j], this.upSlope[j]);
        this.gainDb[j] = g;
        return x * (float (pow (10.0, float64 (g) * 0.05)) * this.trim[j]);
    }

    /// The parameters' slots per band (low, mid, high).
    let compressorThresh   = int[3] (slot::Cp_LowThresh,   slot::Cp_MidThresh,   slot::Cp_HighThresh);
    let compressorRatio    = int[3] (slot::Cp_LowRatio,    slot::Cp_MidRatio,    slot::Cp_HighRatio);
    let compressorUpThresh = int[3] (slot::Cp_LowUpThresh, slot::Cp_MidUpThresh, slot::Cp_HighUpThresh);
    let compressorUpRatio  = int[3] (slot::Cp_LowUpRatio,  slot::Cp_MidUpRatio,  slot::Cp_HighUpRatio);
    let compressorTrim     = int[3] (slot::Cp_LowGain,     slot::Cp_MidGain,     slot::Cp_HighGain);
    let compressorOn       = int[3] (slot::Cp_LowOn,       slot::Cp_MidOn,       slot::Cp_HighOn);

    bool process (Compressor& this, float<2>[blockSize]& buf, bool active, const float[numSlots]& P, float64 sr)
    {
        if (! active && this.idle)
            return false;

        let bands = int (P[slot::Cp_Bands]) != 0;
        let att = extraSmoothing (sr, float64 (expKnob (0.1f, 300.0f, P[slot::Cp_Attack])), 1);
        let rel = extraSmoothing (sr, float64 (expKnob (5.0f, 3000.0f, P[slot::Cp_Release])), 1);
        let meterRel = 1.0f - extraSmoothing (sr, 100.0, 1);

        float[3] tThreshold, tDownSlope, tUpThreshold, tUpSlope, tTrim;

        for (wrap<3> j)
        {
            tThreshold[j] = P.at (compressorThresh[j]);
            tDownSlope[j] = 1.0f / max (P.at (compressorRatio[j]), 1.0f) - 1.0f;
            tUpThreshold[j] = min (P.at (compressorUpThresh[j]), tThreshold[j]);
            tUpSlope[j] = 1.0f - 1.0f / max (P.at (compressorUpRatio[j]), 1.0f);
            tTrim[j] = P.at (compressorOn[j]) != 0 ? float (pow (10.0, float64 (P.at (compressorTrim[j])) * 0.05)) : 0.0f;
        }

        let tIn = float (pow (10.0, float64 (P[slot::Cp_InGain]) * 0.05));
        let tOut = float (pow (10.0, float64 (P[slot::Cp_OutGain]) * 0.05));
        let tDepth = clamp (P[slot::Cp_Depth], 0.0f, 1.0f);
        let tMix = clamp (P[slot::Cp_Mix], 0.0f, 1.0f);

        let hiHz = clamp (float64 (expKnob (20.0f, 20000.0f, P[slot::Cp_HighSplit])), 20.0, 0.45 * sr);
        let loHz = min (float64 (expKnob (20.0f, 20000.0f, P[slot::Cp_LowSplit])), hiHz);
        let tLow = float (log (loHz));
        let tHigh = float (log (hiHz));
        let k = extraSmoothing (sr, 20.0, 1);

        if (this.fresh)
        {
            this.fresh = false;
            this.inGain = tIn; this.outGain = tOut; this.depth = tDepth; this.mix = tMix;
            this.threshold = tThreshold; this.downSlope = tDownSlope;
            this.upThreshold = tUpThreshold; this.upSlope = tUpSlope;
            this.trim = tTrim;
            this.lowHz = tLow; this.highHz = tHigh;
        }

        let kb = extraSmoothing (sr, 20.0, blockSize);
        this.lowHz += (tLow - this.lowHz) * kb;
        this.highHz += (tHigh - this.highHz) * kb;
        let cLow = extraSvfCoefs (exp (float64 (this.lowHz)), sr, extraButterworthK);
        let cHigh = extraSvfCoefs (exp (float64 (this.highHz)), sr, extraButterworthK);

        for (wrap<blockSize> i)
        {
            this.inGain += (tIn - this.inGain) * k;
            this.outGain += (tOut - this.outGain) * k;
            this.depth += (tDepth - this.depth) * k;
            this.mix += (tMix - this.mix) * k;

            for (wrap<3> j)
            {
                this.threshold[j] += (tThreshold[j] - this.threshold[j]) * k;
                this.downSlope[j] += (tDownSlope[j] - this.downSlope[j]) * k;
                this.upThreshold[j] += (tUpThreshold[j] - this.upThreshold[j]) * k;
                this.upSlope[j] += (tUpSlope[j] - this.upSlope[j]) * k;
                this.trim[j] += (tTrim[j] - this.trim[j]) * k;
            }

            // the dry side is the input with the crossovers' phase (their allpass), so that the
            // mix doesn't comb-filter around the splits; the input gain is linear, so the bands
            // are split before it
            let x = buf[i];
            float<2> dry, wet;

            if (bands)
            {
                float<2> low, rest, mid, high;
                this.lowX.split (cLow, x, low, rest);
                this.highX.split (cHigh, rest, mid, high);
                low = this.lowAp.allpass (cHigh, low);

                dry = low + mid + high;
                wet = this.compressBand (0, low * this.inGain, att, rel, meterRel)
                    + this.compressBand (1, mid * this.inGain, att, rel, meterRel)
                    + this.compressBand (2, high * this.inGain, att, rel, meterRel);
            }
            else
            {
                dry = x;
                wet = this.compressBand (1, x * this.inGain, att, rel, meterRel);
            }

            buf[i] = dry + (wet * this.outGain - dry) * this.mix;
        }

        for (wrap<3> j)
            this.levelDb[j] = max (-120.0f, 20.0f * float (log10 (float64 (this.meter[j]) + 1e-30)));

        if (! bands)
        {
            this.levelDb[0] = -120.0f; this.levelDb[2] = -120.0f;
            this.gainDb[0] = 0; this.gainDb[2] = 0;
        }

        if (stillSounding (this.idle, this.silentCount, active || anyAbove (buf, 1e-8f)))
            return true;

        if (float (this.silentCount) > float (sr) * 0.1f)
            this.idle = true;

        return false;
    }
}
